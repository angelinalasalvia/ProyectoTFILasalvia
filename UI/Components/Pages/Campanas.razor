@page "/campanas"
@using Microsoft.AspNetCore.Components
@using BE
@using BLL
@inject NavigationManager Navigation
@inject BLLCampana BLLCampana
@inject BLLHistorialAcciones BLLHistorialAcciones
@inject IJSRuntime JS

<PageTitle>Historial de Campañas</PageTitle>

<div class="page-header camp-header">
    <div>
        <h1 class="detalle-title camp-title">Historial de Campañas</h1>
        <p class="camp-subtitle">Gestión y seguimiento de acciones de retención ejecutadas.</p>
    </div>
    <button class="btn-crear-campana" @onclick="IrACrearCampana">⊕ CREAR CAMPAÑA MANUAL</button>
</div>

@* Filtro de período: afecta solo a las métricas globales (KPIs), no a la tabla. *@
<div class="card camp-filtros-card">
    <div class="filtro-grupo">
        <label class="filtro-label">Período de métricas</label>
        <div class="filtro-rango">
            <input type="date" class="filtro-fecha" @bind="fechaDesdeMetricas" />
            <span class="filtro-rango-sep">a</span>
            <input type="date" class="filtro-fecha" @bind="fechaHastaMetricas" />
        </div>
    </div>
    <button class="btn-aplicar-filtros" @onclick="AplicarPeriodoMetricas">Aplicar</button>
    <button class="btn-limpiar-filtro" @onclick="LimpiarPeriodoMetricas">Limpiar Filtro</button>
</div>

@if (errorPeriodoMetricas != null)
{
    <div class="camp-alert">@errorPeriodoMetricas</div>
}

@if (metricas == null)
{
    <p>Cargando métricas...</p>
}
else
{
    <div class="card camp-kpi-card">
        <div class="camp-kpi-item">
            <div class="camp-kpi-label">Éxito Global</div>
            <div class="camp-kpi-value">@metricas.ExitoGlobal%</div>
            <div class="camp-kpi-bar"><div class="camp-kpi-fill" style="width:@(metricas.ExitoGlobal)%"></div></div>
        </div>
        <div class="camp-kpi-item">
            <div class="camp-kpi-label">KPI Objetivo Alcanzado</div>
            <div class="camp-kpi-value">@metricas.PorcentajeCampanasConKpiAlcanzado% <span class="camp-kpi-sub-inline">de campañas</span></div>
        </div>
        <div class="camp-kpi-item">
            <div class="camp-kpi-label">Canal Más Efectivo</div>
            <div class="camp-kpi-value camp-kpi-canal">@metricas.CanalMasEfectivo</div>
            <div class="camp-kpi-desc">Tasa de conversión <strong>@metricas.TasaCanalMasEfectivo%</strong></div>
        </div>
        <div class="camp-kpi-item">
            <div class="camp-kpi-label">Impacto Reducción Churn</div>
            <div class="camp-kpi-value">@metricas.ImpactoReduccionChurn%</div>
            <div class="camp-kpi-desc">Sin campañas ejecutadas todavía en el período</div>
        </div>
    </div>
}

@if (!huboCampanasRegistradas)
{
    <div class="card">
        <p>Aún no se han ejecutado campañas de retención.</p>
    </div>
}
else
{
    <div class="card camp-filtros-card">
        <div class="filtro-grupo">
            <label class="filtro-label">Canal</label>
            <select class="filtro-select" @bind="canalSeleccionado">
                <option>Todos los canales</option>
                <option>Email</option>
                <option>WhatsApp</option>
            </select>
        </div>
        <div class="filtro-grupo">
            <label class="filtro-label">Nombre de campaña</label>
            <input type="text" class="filtro-texto" placeholder="Buscar por nombre..." @bind="nombreFiltro" />
        </div>
        <button class="btn-aplicar-filtros" @onclick="AplicarFiltroCampanas">Filtrar</button>
        <button class="btn-limpiar-filtro" @onclick="LimpiarFiltroCampanas">Limpiar Filtro</button>
    </div>

    <div class="card camp-table-card">
        @if (errorAccion != null)
        {
            <div class="camp-alert">@errorAccion</div>
        }
        @if (mensajeFiltroSinResultados != null)
        {
            <p>@mensajeFiltroSinResultados</p>
        }
        else
        {
            <table class="camp-table">
                <thead>
                    <tr>
                        <th>NOMBRE DE CAMPAÑA</th>
                        <th>CANAL</th>
                        <th>OBJETIVO</th>
                        <th>TASA DE ÉXITO</th>
                        <th class="usr-th-acciones">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in CampanasPaginaActual)
                    {
                        <tr @onclick="() => IrADetalleCampana(c.IdCampania)" style="cursor:pointer">
                            <td class="camp-nombre">@c.Nombre</td>
                            <td><span class="camp-canal-cell">@c.Canal</span></td>
                            <td class="camp-objetivo">@c.Objetivo</td>
                            <td><span class="camp-tasa-badge">@(c.TasaExito?.ToString("0.0") ?? "-")%</span></td>
                            <td class="camp-acciones-cell" @onclick:stopPropagation="true">
                                <button class="integ-menu-btn" title="Más opciones" @onclick="() => ToggleMenu(c.IdCampania)">⋮</button>
                                @if (menuAbiertoId == c.IdCampania)
                                {
                                    <div class="camp-menu-dropdown">
                                        <button class="camp-menu-item" @onclick="() => IrAEditarCampana(c.IdCampania)">✏️ Editar</button>
                                        <button class="camp-menu-item" @onclick="() => EliminarCampana(c)">🗑️ Eliminar</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="camp-pagination">
                <span class="pagination-info">
                    Mostrando @(Math.Min((paginaActual - 1) * tamanioPagina + 1, campanas.Count))-@(Math.Min(paginaActual * tamanioPagina, campanas.Count)) de @campanas.Count campañas
                </span>
                <div class="pagination-controls">
                    <button class="page-btn" @onclick="() => IrAPagina(paginaActual - 1)" disabled="@(paginaActual == 1)">‹</button>

                    @{
                        var anterior = 0;
                    }
                    @foreach (var num in NumerosDePagina())
                    {
                        @if (anterior != 0 && num - anterior > 1)
                        {
                            <span>...</span>
                        }
                        <button class="page-btn @(num == paginaActual ? "active" : "")" @onclick="() => IrAPagina(num)">@num</button>
                        anterior = num;
                    }

                    <button class="page-btn" @onclick="() => IrAPagina(paginaActual + 1)" disabled="@(paginaActual == TotalPaginas)">›</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Campana> campanas = new();
    private MetricasCampana? metricas;
    private bool huboCampanasRegistradas = true;
    private string? mensajeFiltroSinResultados;
    private string? errorPeriodoMetricas;
    private string? errorAccion;
    private int? menuAbiertoId;

    private string canalSeleccionado = "Todos los canales";
    private string nombreFiltro = string.Empty;

    private int paginaActual = 1;
    private const int tamanioPagina = 5;

    private DateTime fechaDesdeMetricas = DateTime.Now.AddDays(-30);
    private DateTime fechaHastaMetricas = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await CargarMetricas(fechaDesdeMetricas, fechaHastaMetricas);
        await CargarCampanas();
    }

    private async Task CargarMetricas(DateTime desde, DateTime hasta)
    {
        metricas = await BLLHistorialAcciones.ObtenerMetricasGlobalesXPeriodo(desde, hasta);
    }

    private async Task CargarCampanas()
    {
        campanas = await BLLCampana.ObtenerCampanas();
        huboCampanasRegistradas = campanas.Count > 0;
        mensajeFiltroSinResultados = null;
        paginaActual = 1;
    }

    private async Task AplicarPeriodoMetricas()
    {
        if (fechaDesdeMetricas > fechaHastaMetricas)
        {
            errorPeriodoMetricas = "El rango de fechas seleccionado no es válido.";
            return;
        }

        errorPeriodoMetricas = null;
        await CargarMetricas(fechaDesdeMetricas, fechaHastaMetricas);

        if (metricas!.CanalMasEfectivo == "Sin datos")
        {
            errorPeriodoMetricas = "No existen campañas para el período seleccionado.";
        }
    }

    private async Task LimpiarPeriodoMetricas()
    {
        fechaDesdeMetricas = DateTime.Now.AddDays(-30);
        fechaHastaMetricas = DateTime.Now;
        errorPeriodoMetricas = null;
        await CargarMetricas(fechaDesdeMetricas, fechaHastaMetricas);
    }

    private async Task AplicarFiltroCampanas()
    {
        var resultado = await BLLCampana.ObtenerCampanasXFiltro(canalSeleccionado, nombreFiltro);
        campanas = resultado;
        mensajeFiltroSinResultados = resultado.Count == 0
            ? "No existen campañas para los criterios seleccionados."
            : null;
        paginaActual = 1;
    }

    private async Task LimpiarFiltroCampanas()
    {
        canalSeleccionado = "Todos los canales";
        nombreFiltro = string.Empty;
        await CargarCampanas();
    }

    private List<Campana> CampanasPaginaActual =>
        campanas.Skip((paginaActual - 1) * tamanioPagina).Take(tamanioPagina).ToList();

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(campanas.Count / (double)tamanioPagina));

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    private List<int> NumerosDePagina()
    {
        var numeros = new List<int> { 1 };
        int desde = Math.Max(2, paginaActual - 1);
        int hasta = Math.Min(TotalPaginas - 1, paginaActual + 1);
        for (int i = desde; i <= hasta; i++) numeros.Add(i);
        if (TotalPaginas > 1) numeros.Add(TotalPaginas);
        return numeros.Distinct().ToList();
    }

    private void IrACrearCampana()
    {
        Navigation.NavigateTo("/campanas/crear");
    }

    private void IrADetalleCampana(int idCampania)
    {
        Navigation.NavigateTo($"/campanas/detalle/{idCampania}");
    }

    private void ToggleMenu(int idCampania)
    {
        menuAbiertoId = menuAbiertoId == idCampania ? null : idCampania;
    }

    private void IrAEditarCampana(int idCampania)
    {
        Navigation.NavigateTo($"/campanas/editar/{idCampania}");
    }

    private async Task EliminarCampana(Campana c)
    {
        menuAbiertoId = null;
        errorAccion = null;

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la campaña \"{c.Nombre}\"? Esta acción no se puede deshacer.");
        if (!confirmado) return;

        try
        {
            await BLLCampana.EliminarCampana(c.IdCampania);
            await CargarCampanas();
        }
        catch (Microsoft.Data.SqlClient.SqlException ex) when (ex.Number == 547)
        {
            errorAccion = $"No se puede eliminar \"{c.Nombre}\" porque tiene acciones o reglas asociadas.";
        }
    }
}
