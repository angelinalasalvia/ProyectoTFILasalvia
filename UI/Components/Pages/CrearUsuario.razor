@page "/administracion/usuarios/nuevo"
@page "/administracion/usuarios/editar/{UsuarioId:int}"
@inject NavigationManager Navigation
@inject BLLUsuario UsuarioBLL
@inject BLLRol RolBLL
@inject BLLTokenActivacion TokenActivacionBLL
@inject ServicioEnvio Envio
@using BE
@using BLL

<PageTitle>@(EsEdicion ? "Editar Usuario" : "Crear Usuario")</PageTitle>

<div class="usr-form-topbar">
    <div class="search-box usr-form-search">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="Buscar..." />
    </div>

    <div class="usr-topbar-icons">
        <button class="usr-icon-btn" title="Notificaciones">
            🔔
        </button>

        <button class="usr-icon-btn" title="Ayuda">
            ❓
        </button>

        <button class="usr-icon-btn" title="Configuración">
            ⚙️
        </button>
    </div>
</div>

<div class="breadcrumb">
    Gestión de Usuarios
    <span class="breadcrumb-sep">›</span>
    @(EsEdicion ? "Editar Usuario" : "Crear Usuario")
</div>

<div class="usr-form-header">
    <div>
        <h1>
            @(EsEdicion ? "Editar Usuario" : "Crear Nuevo Usuario")
        </h1>

        <p class="camp-subtitle">
            @(EsEdicion
                        ? "Modifique los datos y permisos de acceso del usuario."
                        : "Configure los datos básicos y los permisos de acceso para el nuevo integrante del equipo.")
        </p>
    </div>
</div>

<div class="card usr-form-card">

    <!-- Nombre y correo -->
    <div class="usr-form-grid">

        <div class="usr-form-field">
            <label class="form-label">NOMBRE COMPLETO</label>

            <input type="text"
                   class="campana-select @(errores.Contains("nombre") ? "input-error" : "")"
                   @bind="nombreCompleto"
                   @bind:event="oninput"
                   placeholder="Ej. Carlos Méndez" />
        </div>

        <div class="usr-form-field">
            <label class="form-label">CORREO ELECTRÓNICO</label>

            <input type="email"
                   class="campana-select @(errores.Contains("email") ? "input-error" : "")"
                   @bind="email"
                   @bind:event="oninput"
                   disabled="@EsEdicion"
                   placeholder="carlos.mendez@empresa.com" />

            @if (EsEdicion)
            {
                <span class="usr-form-help">
                    El correo electrónico no puede modificarse.
                </span>
            }
            else
            {
                <span class="usr-form-help">
                    Este será el identificador de acceso del usuario.
                </span>
            }
        </div>

    </div>

    <!-- Rol y estado -->
    <div class="usr-form-grid">

        <div class="usr-form-field">
            <label class="form-label">ROL</label>

            <select class="campana-select @(errores.Contains("rol") ? "input-error" : "")"
                    @bind="rolSeleccionado"
                    @bind:after="MostrarResumenPermisos">
                <option value="0">Seleccione un rol</option>
                @foreach (var r in roles)
                {
                    <option value="@r.IdRol">@r.Nombre</option>
                }
            </select>
        </div>

        <div class="usr-form-field">
            <label class="form-label">ESTADO</label>

            <div class="usr-status-box">
                <span class="usr-status-dot @(activo ? "usr-status-active" : "usr-status-inactive")"></span>

                <span>
                    @(activo ? "Activo" : "Inactivo")
                </span>

                <span class="usr-status-locked">
                    🔒
                </span>
            </div>

            <span class="usr-form-help">
                El estado no puede modificarse desde este formulario.
            </span>
        </div>

    </div>

    <!-- Resumen de permisos -->
    <div class="usr-permissions-card">

        <div class="usr-permissions-header">
            <div class="usr-permissions-icon">
                🛡
            </div>

            <div>
                <h3>Resumen de Permisos</h3>
            </div>
        </div>

        <div class="usr-permissions-content">
            <span class="usr-permissions-info">ⓘ</span>

            <span>
                @ResumenPermisos
            </span>
        </div>

    </div>

    @if (!EsEdicion)
    {
        <div class="usr-email-info">
            <span class="usr-email-icon">✉</span>

            <span>
                Se enviará un correo electrónico al usuario con un enlace
                para establecer su contraseña de forma segura.
            </span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="usr-form-error">
            ⚠ @mensajeError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeConfirmacion))
    {
        <div class="camp-form-confirmacion">
            ✔ @mensajeConfirmacion
        </div>
    }

    <div class="usr-form-separator"></div>

    <div class="usr-form-actions">

        <button class="btn-cancelar"
                @onclick="Cancelar">
            Cancelar
        </button>

        <button class="btn-confirmar" disabled="@guardando" @onclick="GuardarUsuario">
            @(EsEdicion ? "💾 Guardar Cambios" : "👤 Guardar Usuario")
        </button>

    </div>

</div>

@code {

    [Parameter]
    public int? UsuarioId { get; set; }

    private bool EsEdicion => UsuarioId.HasValue;

    private string nombreCompleto = "";
    private string email = "";
    private int rolSeleccionado = 0;
    private bool activo = false;
    private bool guardando = false;

    private string mensajeError = "";
    private string mensajeConfirmacion = "";

    private HashSet<string> errores = new();

    private List<Rol> roles = new();
    private List<Permiso> permisosRol = new();

    // DS: MostrarResumenPermisos()
    private string ResumenPermisos
    {
        get
        {
            if (rolSeleccionado == 0) return "Seleccione un rol para visualizar sus permisos.";

            var descripcion = roles.FirstOrDefault(r => r.IdRol == rolSeleccionado)?.Descripcion ?? "";
            var lista = permisosRol.Count == 0
                ? "Sin permisos asignados."
                : "Permisos: " + string.Join(", ", permisosRol.Select(p => p.Nombre)) + ".";

            return string.IsNullOrWhiteSpace(descripcion) ? lista : $"{descripcion} {lista}";
        }
    }

    // DS: Ingresa a "Agregar Usuario" / "Modificar Usuario"
    protected override async Task OnInitializedAsync()
    {
        try
        {
            roles = await RolBLL.ObtenerRoles();

            if (EsEdicion)
                await MostrarFormularioEdicion(UsuarioId!.Value);
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar el formulario.";
        }
    }

    // DS CU22: ObtenerUsuario(int idUsuario) + MostrarFormularioEdicion()
    private async Task MostrarFormularioEdicion(int idUsuario)
    {
        var usuario = await UsuarioBLL.ObtenerUsuario(idUsuario);
        if (usuario is null)
        {
            Navigation.NavigateTo("/administracion/usuarios");   // el usuario ya no existe
            return;
        }

        nombreCompleto = usuario.NombreCompleto;
        email = usuario.Email;
        rolSeleccionado = usuario.IdRol;
        activo = string.Equals(usuario.Estado, EstadoUsuario.Activo, StringComparison.OrdinalIgnoreCase);

        await MostrarResumenPermisos();
    }

    // DS: TraerPermisosRol(int id) -> MostrarResumenPermisos()
    private async Task MostrarResumenPermisos()
    {
        try
        {
            permisosRol = rolSeleccionado == 0
                ? new List<Permiso>()
                : await RolBLL.TraerPermisosRol(rolSeleccionado);
        }
        catch (Exception)
        {
            permisosRol = new List<Permiso>();
            mensajeError = "No se pudieron cargar los permisos del rol.";
        }
    }

    // DS: Selecciona botón "Guardar"()
    private async Task GuardarUsuario()
    {
        if (guardando) return;

        guardando = true;
        errores.Clear();
        mensajeError = "";
        mensajeConfirmacion = "";

        var exito = false;
        try
        {
            if (!ValidarCamposObligatoriosYFormato(nombreCompleto, email, rolSeleccionado))
                return;

            exito = EsEdicion ? await ModificarUsuario() : await CrearNuevoUsuario();
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado. Intentá nuevamente en unos minutos.";
        }
        finally
        {
            if (!exito) guardando = false;   // si salió bien, el botón queda deshabilitado hasta redirigir
        }

        if (exito)
        {
            StateHasChanged();
            await RedirigirAGestionUsuarios();
        }
    }

    // DS CU21: VerificarEmailRegistrado -> CrearUsuarioInactivo -> GenerarTokenActivacion -> EnviarInstruccionesAcceso
    private async Task<bool> CrearNuevoUsuario()
    {
        if (await UsuarioBLL.VerificarEmailRegistrado(email))
        {
            errores.Add("email");
            mensajeError = "El correo electrónico ya se encuentra registrado.";
            return false;
        }

        await UsuarioBLL.CrearUsuarioInactivo(nombreCompleto, email, rolSeleccionado);

        var correoEnviado = false;
        try
        {
            var tokenLink = await TokenActivacionBLL.GenerarTokenActivacion(email.Trim(), Navigation.BaseUri);
            var envio = await Envio.EnviarInstruccionesAcceso(email.Trim(), tokenLink);
            correoEnviado = envio.Exito;
        }
        catch (Exception)
        {
            correoEnviado = false;
        }

        // CU21 13.1: si falla el correo el usuario igual queda creado.
        mensajeConfirmacion = correoEnviado
            ? "Usuario creado correctamente. Correo enviado."
            : "Usuario creado correctamente. Error al enviar el correo: podés reenviarlo desde Gestión de Usuarios.";
        return true;
    }

    // DS CU22: ValidarModificacion + ModificarUsuario(int idUsuario, string nombreCompleto, int rol)
    private async Task<bool> ModificarUsuario()
    {
        var validacion = await UsuarioBLL.ValidarModificacion(UsuarioId!.Value, rolSeleccionado);
        if (!validacion.Valido)
        {
            mensajeError = $"No es posible modificar el usuario: {validacion.Motivo}";
            return false;
        }

        await UsuarioBLL.ModificarUsuario(UsuarioId!.Value, nombreCompleto, rolSeleccionado);
        mensajeConfirmacion = "La modificación fue realizada correctamente.";
        return true;
    }

    // DS: ValidarCamposObligatoriosYFormato(string nombreCompleto, string email, int rol): bool
    private bool ValidarCamposObligatoriosYFormato(string nombreCompleto, string email, int rol)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) errores.Add("nombre");
        if (!EsEdicion && string.IsNullOrWhiteSpace(email)) errores.Add("email");
        if (rol == 0) errores.Add("rol");

        if (errores.Count > 0)
        {
            mensajeError = "Complete los campos obligatorios: " + string.Join(", ", errores.Select(NombreCampo)) + ".";
            return false;
        }

        if (nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length < 2)
        {
            errores.Add("nombre");
            mensajeError = "Ingrese nombre y apellido.";
            return false;
        }

        if (!EsEdicion && !BLLUsuario.EsEmailValido(email))
        {
            errores.Add("email");
            mensajeError = "El formato del correo electrónico no es válido.";
            return false;
        }

        return true;
    }

    private static string NombreCampo(string campo) => campo switch
    {
        "nombre" => "nombre completo",
        "email" => "correo electrónico",
        "rol" => "rol",
        _ => campo
    };

    private bool EsEmailValido(string valor)
    {
        try
        {
            var mail = new System.Net.Mail.MailAddress(valor);
            return mail.Address == valor;
        }
        catch
        {
            return false;
        }
    }

    private async Task RedirigirAGestionUsuarios()
    {
        await Task.Delay(1800);
        Navigation.NavigateTo("/administracion/usuarios");
    }

    // DS: Selecciona botón "Cancelar"() -> vuelve a Gestión de usuarios y descarta lo ingresado
    private void Cancelar()
    {
        Navigation.NavigateTo("/administracion/usuarios");
    }
}