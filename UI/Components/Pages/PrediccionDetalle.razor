@page "/prediccion-detalle/{IdCliente:int}"
@inject BLL.BLLCliente BLLCliente
@inject BLL.BLLPrediccion BLLPrediccion
@inject BLL.BLLFactorRiesgo BLLFactorRiesgo
@inject BLL.BLLModelo BLLModelo
@rendermode InteractiveServer
@using System.Globalization
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using BE

<PageTitle>Análisis de Predicción: @cliente?.Nombre @cliente?.Apellido</PageTitle>

<div class="page-header">
    <a href="predicciones" class="back-link">‹ Volver a Predicciones</a>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (cliente == null)
{
    <p class="pred-sin-resultados">No se encontró el cliente solicitado.</p>
}
else
{
    <h1 class="detalle-title">Análisis de Predicción: @cliente.Nombre @cliente.Apellido</h1>
    @if (prediccion != null)
    {
        <span class="riesgo-tag @ClaseNivel(prediccion.NivelRiesgo)">
            ● RIESGO @prediccion.NivelRiesgo?.ToUpper() - @prediccion.ProbabilidadAbandono.ToString("0.0")%
        </span>
    }

    <div class="detalle-row">
        <div class="detalle-col-izq">
            <div class="card perfil-card">
                <h4 class="card-subtitle">PERFIL DEL SOCIO</h4>
                <div class="perfil-header">
                    <div class="perfil-avatar">👤</div>
                    <div>
                        <div class="perfil-nombre">@cliente.Nombre @cliente.Apellido</div>
                        <div class="perfil-email">@cliente.Email</div>
                    </div>
                </div>
                <div class="perfil-datos">
                    <div class="perfil-dato">
                        <span class="dato-label">Plan Actual</span>
                        <span class="dato-value">@cliente.PlanSocio</span>
                    </div>
                    <div class="perfil-dato">
                        <span class="dato-label">Última Actividad</span>
                        <span class="dato-value">@(ultimaActividad?.ToString("dd/MM/yyyy") ?? "Sin registros")</span>
                    </div>
                    <div class="perfil-dato">
                        <span class="dato-label">Último Pago</span>
                        <span class="dato-value">@(ultimoPago?.ToString("dd/MM/yyyy") ?? "Sin registros")</span>
                    </div>
                </div>
            </div>

            <div class="card segmento-card">
                <h4 class="card-subtitle">VS. MEDIA DEL SEGMENTO</h4>
                <p class="card-hint">Compara al socio con el promedio de los socios activos de su mismo plan (@cliente.PlanSocio), sobre los últimos 30 días.</p>
                <div class="segmento-item">
                    <div class="segmento-label">Uso de instalaciones (visitas al gimnasio)</div>
                    <div class="segmento-value @ClaseRelativo(metricas.UsoInstalaciones)">@FormatearRelativo(metricas.UsoInstalaciones)</div>
                </div>
                <div class="segmento-item">
                    <div class="segmento-label">Interacciones con la App (usos de la app)</div>
                    <div class="segmento-value @ClaseRelativo(metricas.InteraccionesApp)">@FormatearRelativo(metricas.InteraccionesApp)</div>
                </div>

                @if (hayAnomalia)
                {
                    <div class="alerta-anomalia">
                        ⚠️ Anomalía detectada: @detalleAnomalia
                        <div class="anomalia-nota">Se marca cuando el uso del gimnasio o de la app está @(umbralAnomalia)% o más por debajo del promedio de su segmento en los últimos 30 días.</div>
                    </div>
                }
                else
                {
                    <p class="pred-sin-resultados">No se detectaron anomalías.</p>
                }
            </div>

            <a href="retencion-cliente/@IdCliente" class="btn-accion-retencion">
                <span class="btn-icon">🔄</span>
                <span>Acción de Retención Manual</span>
            </a>
        </div>

        <div class="detalle-col-der">
            <div class="card factores-card">
                <div class="factores-header">
                    <div>
                        <h4 class="card-subtitle-dark">Factores que influyen en el riesgo</h4>
                        <p class="card-hint">Parte del riesgo que el modelo le asigna a un socio típico de su mismo plan y suma o resta puntos según cómo se aparta este socio de lo típico en cada indicador, hasta llegar a su probabilidad. <span class="leyenda-riesgo">Rojo: aumenta el riesgo</span> · <span class="leyenda-protector">Verde: lo reduce</span>.</p>
                    </div>
                </div>
                @if (prediccion == null)
                {
                    <p class="pred-sin-resultados">Este cliente aún no tiene una predicción calculada.</p>
                }
                else
                {
                    <div class="factores-content">
                        <div class="factores-lista">
                            <div class="factor-item">
                                <div class="factor-top">
                                    <span class="factor-nombre">Riesgo de un socio típico de su plan</span>
                                    <span class="factor-valor">@riesgoBase.ToString("0.0")%</span>
                                </div>
                            </div>

                            @foreach (var f in factoresVisibles.Where(x => Math.Abs(x.Impacto ?? 0) >= 0.05m).Concat(otros is null ? Array.Empty<FactorRiesgo>() : new[] { otros }))
                            {
                                var pts = f.Impacto ?? 0;
                                <div class="factor-item">
                                    <div class="factor-top">
                                        <span class="factor-nombre">@f.Nombre</span>
                                        <span class="factor-valor @(pts >= 0 ? "factor-positivo" : "factor-negativo")">
                                            @(pts >= 0 ? "+" : "−")@Math.Abs(pts).ToString("0.0") pts
                                        </span>
                                    </div>
                                    <div class="factor-bar">
                                        <div class="factor-fill @(pts >= 0 ? "fill-positivo" : "fill-negativo")" style="width:@(Ancho(pts))%"></div>
                                    </div>
                                    <div class="factor-desc">@f.Descripcion</div>
                                </div>
                            }
                            @{
                                var sinEfecto = factoresVisibles.Where(x => Math.Abs(x.Impacto ?? 0) < 0.05m).Select(x => x.Nombre).ToList();
                            }
                            @if (sinEfecto.Count > 0)
                            {
                                <p class="card-hint">Sin influencia en esta predicción: @string.Join(", ", sinEfecto).</p>
                            }

                            <div class="factor-item">
                                <div class="factor-top">
                                    <span class="factor-nombre"><strong>= Probabilidad de abandono</strong></span>
                                    <span class="factor-valor"><strong>@prediccion?.ProbabilidadAbandono.ToString("0.0")%</strong></span>
                                </div>
                            </div>
                        </div>


                        <div class="radar-container">
                            <svg viewBox="0 0 260 260" class="radar-svg">
                                @for (int i = 0; i < factoresVisibles.Count; i++)
                                {
                                    var (ejeX, ejeY) = RadarPosicion(i, factoresVisibles.Count, 1.0);
                                    <line x1="130" y1="130" x2="@ejeX.ToString(CultureInfo.InvariantCulture)" y2="@ejeY.ToString(CultureInfo.InvariantCulture)"
                                          stroke="#e5e8ee" stroke-width="1" />
                                }
                                <polygon points="@RadarPuntos()" fill="#f2b8c6" fill-opacity="0.35" stroke="#d63939" stroke-width="2" />
                                <circle cx="130" cy="130" r="26" fill="#fff" stroke="#e5e8ee" stroke-width="1" />
                                <text x="130" y="127" text-anchor="middle" font-size="8" fill="#555b6a" font-weight="600">Modelo:</text>
                                <text x="130" y="137" text-anchor="middle" font-size="8" fill="#555b6a" font-weight="600">@NombreModeloCorto()</text>
                                <text x="130" y="112" text-anchor="middle" font-size="14">🎯</text>
                                @for (int i = 0; i < factoresVisibles.Count; i++)
                                {
                                    var (labelX, labelY) = RadarPosicion(i, factoresVisibles.Count);
                                    <g>
                                        <text x="@labelX.ToString(CultureInfo.InvariantCulture)" y="@labelY.ToString(CultureInfo.InvariantCulture)"
                                              text-anchor="middle" font-size="7" fill="#555b6a">@TruncarNombre(factoresVisibles[i].Nombre)</text>
                                    </g>
                                }
                            </svg>
                        </div>
                    </div>
                }
            </div>


            <div class="card engagement-card">
                <div class="factores-header">
                    <h4 class="card-subtitle-dark">Evolución del Compromiso (Engagement Score)</h4>
                    <select class="periodo-select" @onchange="CambiarPeriodo">
                        <option value="semana">Última semana</option>
                        <option value="mes" selected>Último mes</option>
                        <option value="trimestre">Último trimestre</option>
                        <option value="año">Último año</option>
                    </select>
                </div>
                @if (!haySuficienteHistorialEngagement)
                {
                    <p class="pred-sin-resultados">El cliente no cuenta con historial suficiente para generar la evolución del Engagement Score.</p>
                }
                else
                {
                    <svg viewBox="0 0 600 220" class="engagement-svg" preserveAspectRatio="none">

                        <!-- Escala del Engagement Score -->
                        <text x="5" y="23" font-size="9" fill="#777">100</text>
                        <text x="5" y="73" font-size="9" fill="#777">75</text>
                        <text x="5" y="123" font-size="9" fill="#777">50</text>
                        <text x="5" y="173" font-size="9" fill="#777">25</text>
                        <text x="5" y="198" font-size="9" fill="#777">0</text>

                        <!-- Líneas de referencia -->
                        <line x1="0" y1="20" x2="600" y2="20" stroke="#f0f2f6" stroke-width="1" />
                        <line x1="0" y1="70" x2="600" y2="70" stroke="#f0f2f6" stroke-width="1" />
                        <line x1="0" y1="120" x2="600" y2="120" stroke="#f0f2f6" stroke-width="1" />
                        <line x1="0" y1="170" x2="600" y2="170" stroke="#f0f2f6" stroke-width="1" />

                        <!-- Evolución del Engagement Score -->
                        <polyline fill="none"
                                  stroke="#d63939"
                                  stroke-width="3"
                                  points="@EngagementPolylinePuntos()" />

                        @for (int i = 0; i < puntosEngagement.Count; i++)
                        {
                            double x = puntosEngagement.Count == 1
                            ? 300
                            : 600.0 * i / (puntosEngagement.Count - 1);

                            double y = 195 -
                            (puntosEngagement[i].Score / 100.0) * (195 - 20);

                            <circle cx="@x.ToString(CultureInfo.InvariantCulture)"
                                    cy="@y.ToString(CultureInfo.InvariantCulture)"
                                    r="4"
                                    fill="white"
                                    stroke="#d63939"
                                    stroke-width="2" />
                        }
                    </svg>
                    <div class="engagement-labels">
                        @foreach (var p in puntosEngagement)
                        {
                            <span>@p.Etiqueta</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int IdCliente { get; set; }

    private bool cargando = true;
    private Cliente? cliente;
    private Prediccion? prediccion;
    private (double UsoInstalaciones, double InteraccionesApp) metricas = (0, 0);
    private List<FactorRiesgo> factores = new();
    private string nombreModelo = "";
    private string periodoActivo = "mes";
    private bool hayAnomalia;
    private string detalleAnomalia = "";
    private const int umbralAnomalia = BLL.BLLCliente.UmbralAnomalia;
    private DateTime? ultimaActividad;
    private DateTime? ultimoPago;

    protected override async Task OnInitializedAsync()
    {
        try { await CargarDatos(); }
        finally { cargando = false; }
    }

    private async Task CargarDatos()
    {
        cliente = await BLLCliente.ObtenerCliente(IdCliente);
        if (cliente == null) return;

        ultimaActividad = BLLCliente.ObtenerUltimaActividad(cliente);
        ultimoPago = BLLCliente.ObtenerUltimoPago(cliente);
        metricas = await BLLCliente.ObtenerMetricasRelativasMedia(IdCliente);
        (hayAnomalia, detalleAnomalia) = BLLCliente.VerificarAnomalias(metricas);
                
        prediccion = await BLLPrediccion.ObtenerPrediccionPorCliente(IdCliente);
        if (prediccion != null)
        {
            factores = await BLLFactorRiesgo.ObtenerFactorRiesgo(IdCliente);
            nombreModelo = await BLLModelo.ObtenerNombreModelo(prediccion.IdModelo);
            GenerarGraficoFactores();
        }
        GenerarGraficoEngagement(cliente);
    }

    private void CambiarPeriodo(ChangeEventArgs e)
    {
        periodoActivo = e.Value?.ToString() ?? "mes";
        GenerarGraficoEngagement(cliente);
    }

    private static string ClaseNivel(string? nivel) => $"nivel-{(nivel ?? "").ToLowerInvariant()}";

    // La BD guarda "Random Forest - Predicción de Churn"; en el gráfico solo se muestra el algoritmo.
    private string NombreModeloCorto() => nombreModelo.Split(" - ")[0];

    private string FormatearRelativo(double valor) =>
        valor == 0 ? "En la media del segmento"
        : valor > 0 ? $"+{valor}% por encima de la media"
        : $"{Math.Abs(valor)}% por debajo de la media";

    private string ClaseRelativo(double valor) => valor >= 0 ? "positivo" : "negativo";

    private const int RadarCX = 130, RadarCY = 130, RadarRadioMax = 95;

    private string RadarPuntos()
    {
        if (factoresVisibles.Count == 0) return "";
        double maxImpacto = factoresVisibles.Max(f => (double)Math.Abs(f.Impacto ?? 0));
        if (maxImpacto == 0) maxImpacto = 1;

        var puntos = new List<string>();
        for (int i = 0; i < factoresVisibles.Count; i++)
        {
            double magnitud = (double)Math.Abs(factoresVisibles[i].Impacto ?? 0) / maxImpacto;
            var (x, y) = PuntoEnAngulo(i, factoresVisibles.Count, magnitud * RadarRadioMax);
            puntos.Add($"{x.ToString(CultureInfo.InvariantCulture)},{y.ToString(CultureInfo.InvariantCulture)}");
        }
        return string.Join(" ", puntos);
    }

    private (double x, double y) RadarPosicion(int i, int total, double factorRadio = 1.18)
        => PuntoEnAngulo(i, total, RadarRadioMax * factorRadio);

    private (double x, double y) PuntoEnAngulo(int i, int total, double radio)
    {
        double angulo = (Math.PI * 2 * i / total) - (Math.PI / 2);
        return (RadarCX + radio * Math.Cos(angulo), RadarCY + radio * Math.Sin(angulo));
    }

    private string TruncarNombre(string nombre) => nombre.Length > 14 ? nombre[..12] + "…" : nombre;

    private List<(string Etiqueta, double Score)> puntosEngagement = new();
    private bool haySuficienteHistorialEngagement = true;

    // El cálculo vive en la BLL; la GUI solo dibuja. Lista vacía = sin historial en el período.
    private void GenerarGraficoEngagement(Cliente? clienteActual)
    {
        puntosEngagement = clienteActual == null
            ? new()
            : BLLCliente.ObtenerEvolucionEngagement(clienteActual, periodoActivo);
        haySuficienteHistorialEngagement = puntosEngagement.Count > 0;
    }

    private string EngagementPolylinePuntos()
    {
        if (puntosEngagement.Count == 0) return "";
        const double alto = 195, techo = 20;
        int n = puntosEngagement.Count;
        var partes = new List<string>();
        for (int i = 0; i < n; i++)
        {
            double x = n == 1 ? 300 : 600.0 * i / (n - 1);
            double y = alto - (puntosEngagement[i].Score / 100.0) * (alto - techo);
            partes.Add($"{x.ToString(CultureInfo.InvariantCulture)},{y.ToString(CultureInfo.InvariantCulture)}");
        }
        return string.Join(" ", partes);
    }
    private List<FactorRiesgo> factoresVisibles = new();
    private FactorRiesgo? otros;
    private double riesgoBase, maxPuntos = 1;

    private void GenerarGraficoFactores()
    {
        otros = factores.FirstOrDefault(f => f.Nombre == NombresFactorRiesgo.OtrosFactores);
        factoresVisibles = factores.Where(f => f.Nombre != NombresFactorRiesgo.OtrosFactores)
                                   .OrderByDescending(f => f.Impacto ?? 0).ToList();

        riesgoBase = BLLFactorRiesgo.CalcularRiesgoBase(prediccion, factores);
        maxPuntos = factores.Count == 0
            ? 1
            : Math.Max(1, factores.Max(f => Math.Abs((double)(f.Impacto ?? 0))));
    }

    private string Ancho(decimal? pts) =>
        Math.Min(100, Math.Abs((double)(pts ?? 0)) / maxPuntos * 100).ToString(CultureInfo.InvariantCulture);
}
