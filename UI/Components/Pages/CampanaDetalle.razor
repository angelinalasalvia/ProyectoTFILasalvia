@page "/campanas/detalle/{IdCampania:int}"
@inject BLL.BLLCampana BLLCampana
@inject BLL.BLLHistorialAcciones BLLHistorialAcciones
@inject UI.Services.GeneradorPdf GeneradorPdf
@inject IJSRuntime JS
@rendermode InteractiveServer
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using BE

<PageTitle>@(campana?.Nombre ?? "Detalle de Campaña")</PageTitle>

<div class="page-header">
    <a href="campanas" class="back-link">‹ Volver a Campañas</a>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

@if (campana == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="camp-detalle-title-row">
        <div>
            <h1 class="detalle-title camp-detalle-title">@campana.Nombre</h1>
            <div class="camp-detalle-canal">@IconoCanal(campana.Canal) @campana.Canal</div>
        </div>
        <button class="btn-exportar" @onclick="ExportarInforme" disabled="@exportando">
            @(exportando ? "Generando..." : "⬇ Exportar Reporte")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExportacion))
    {
        <div class="login-alerta">@mensajeExportacion</div>
    }

    <div class="camp-detalle-kpi-row">
        <div class="card camp-detalle-kpi-card">
            <div class="camp-detalle-kpi-label">TASA DE APERTURA</div>
            <div class="camp-detalle-kpi-value">@TasaApertura.ToString("0.0")%</div>
            <div class="camp-detalle-kpi-sub">@MensajesEntregados mensajes entregados</div>
        </div>

        <div class="card camp-detalle-kpi-card">
            <div class="camp-detalle-kpi-label">CLICS EN ENLACE</div>
            <div class="camp-detalle-kpi-value">@TasaClics.ToString("0.0")%</div>
            <div class="camp-detalle-kpi-sub">@ClicsEnlace interacciones únicas</div>
        </div>

        <div class="card camp-detalle-kpi-card">
            <div class="camp-detalle-kpi-label">SOCIOS RECUPERADOS</div>
            <div class="camp-detalle-kpi-value">@SociosRecuperados <span class="camp-detalle-kpi-meta">/ @(campana.Meta ?? 0) objetivo</span></div>
            <div class="camp-detalle-kpi-sub">Conversión del @TasaConversion.ToString("0.0")%</div>
        </div>
    </div>

    <div class="card camp-rendimiento-card">
        <div class="camp-rendimiento-header">
            <div>
                <h3 class="card-subtitle-dark">Rendimiento Temporal</h3>
                <p class="camp-rendimiento-sub">Distribución de conversiones durante los primeros 7 días</p>
            </div>
            <div class="camp-rendimiento-leyenda">
                <span class="leyenda-item"><span class="leyenda-dot dot-conversion"></span> Conversiones</span>
                <span class="leyenda-item"><span class="leyenda-dot dot-leidos"></span> Mensajes Leídos</span>
            </div>
        </div>

        @if (historial.Count == 0)
        {
            <p class="pred-sin-resultados">Todavía no hay actividad registrada para esta campaña.</p>
        }
        else
        {
            <div class="camp-chart-container">
                @foreach (var dia in rendimiento)
                {
                    <div class="camp-chart-col">
                        <div class="camp-chart-bar-wrap">
                            <div class="camp-chart-bar-leido" style="height:@(dia.AlturaLeidos)px"></div>
                            <div class="camp-chart-bar-conversion" style="height:@(dia.AlturaConversiones)px"></div>
                        </div>
                        <div class="camp-chart-label">@dia.Dia</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card camp-socios-card">
        <div class="camp-socios-header">
            <h3 class="camp-socios-title">Socios Impactados</h3>
            <div class="camp-socios-filtros">
                <div class="filtro-inline">
                    <span class="filtro-inline-label">Plan</span>
                    <select class="filtro-inline-select" @onchange="e => CambiarFiltro(plan: e.Value?.ToString())">
                        <option value="Todos">Todos</option>
                        @foreach (var p in PlanesDisponibles)
                        {
                            <option value="@p" selected="@(planActivo == p)">@p</option>
                        }
                    </select>
                </div>
                <div class="filtro-inline">
                    <span class="filtro-inline-label">Resultado</span>
                    <select class="filtro-inline-select" @onchange="e => CambiarFiltro(resultado: e.Value?.ToString())">
                        <option value="Todos">Todos</option>
                        <option value="Rescatado">Rescatado</option>
                        <option value="Sin acción">Sin acción</option>
                        <option value="Clic en enlace">Clic en enlace</option>
                    </select>
                </div>
                @if (planActivo != "Todos" || resultadoActivo != "Todos")
                {
                    <button class="filtro-limpiar" @onclick="LimpiarFiltros">Limpiar filtros</button>
                }
            </div>
        </div>

        @if (historial.Count == 0)
        {
            <p class="pred-sin-resultados">No existen clientes para los criterios seleccionados.</p>
        }
        else
        {
            <table class="camp-socios-table">
                <thead>
                    <tr>
                        <th class="th-ordenable" @onclick='() => OrdenarPor("nombre")'>SOCIO</th>
                        <th class="th-ordenable" @onclick='() => OrdenarPor("plan")'>PLAN ACTUAL</th>
                        <th>ESTADO ENVÍO</th>
                        <th class="th-ordenable" @onclick='() => OrdenarPor("resultado")'>RESULTADO</th>
                        <th class="th-ordenable" @onclick='() => OrdenarPor("fecha")'>FECHA ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in HistorialPaginaActual)
                    {
                        <tr>
                            <td>
                                <div class="client-cell">
                                    <div class="client-avatar-initials">@Iniciales(h)</div>
                                    <div>
                                        <div class="client-name">@h.NombreCliente @h.ApellidoCliente</div>
                                        <div class="socio-id">ID: @h.IdCliente</div>
                                    </div>
                                </div>
                            </td>
                            <td>@h.PlanCliente</td>
                            <td><span class="estado-envio-cell @ClaseEstado(h.EstadoEnvio)">@IconoEstado(h.EstadoEnvio) @h.EstadoEnvio</span></td>
                            <td><span class="resultado-badge-camp @ClaseResultado(h.Resultado)">@h.Resultado</span></td>
                            <td class="fecha-cell">@h.FechaAccion.ToString("dd MMM yyyy, HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="camp-socios-pagination">
                <span class="pagination-info">
                    Mostrando @(Math.Min((paginaActual - 1) * tamanioPagina + 1, historial.Count))-@(Math.Min(paginaActual * tamanioPagina, historial.Count)) de @historial.Count socios
                </span>
                <div class="pagination-controls">
                    <button class="page-btn" @onclick="() => IrAPagina(paginaActual - 1)" disabled="@(paginaActual == 1)">‹</button>
                    @{
                        var anterior = 0;
                    }
                    @foreach (var num in NumerosDePagina())
                    {
                        @if (anterior != 0 && num - anterior > 1)
                        {
                            <span>...</span>
                        }
                        <button class="page-btn @(num == paginaActual ? "active" : "")" @onclick="() => IrAPagina(num)">@num</button>
                        anterior = num;
                    }
                    <button class="page-btn" @onclick="() => IrAPagina(paginaActual + 1)" disabled="@(paginaActual == TotalPaginas)">›</button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int IdCampania { get; set; }

    private Campana? campana;
    private List<HistorialAccion> historial = new();
    private List<(string Dia, int AlturaLeidos, int AlturaConversiones)> rendimiento = new();

    private string columnaOrden = "fecha";
    private string planActivo = "Todos";
    private string resultadoActivo = "Todos";

    private int paginaActual = 1;
    private const int tamanioPagina = 5;

    private bool exportando = false;
    private string mensajeExportacion = "";

    protected override async Task OnInitializedAsync()
    {
        campana = await BLLCampana.ObtenerCampañaPorId(IdCampania);
        historial = await BLLHistorialAcciones.ObtenerHistorialCampania(IdCampania);
        CalcularGraficoRendimiento();
    }

    // ----- Paso 4: KPIs (self-call de la GUI, según el diagrama) -----
    private int MensajesEntregados => historial.Count;
    private int MensajesLeidos => historial.Count(h => h.EstadoEnvio == "Leído");
    private double TasaApertura => MensajesEntregados == 0 ? 0 : Math.Round(MensajesLeidos * 100.0 / MensajesEntregados, 1);

    private int ClicsEnlace => historial.Count(h => h.Resultado == "Clic en enlace");
    private double TasaClics => MensajesEntregados == 0 ? 0 : Math.Round(ClicsEnlace * 100.0 / MensajesEntregados, 1);

    private int SociosRecuperados => historial.Count(h => h.Resultado == "Rescatado");
    private double TasaConversion => (campana?.Meta ?? 0) == 0 ? 0 : Math.Round(SociosRecuperados * 100.0 / campana!.Meta!.Value, 1);

    // ----- Paso 5: gráfico de 7 días (self-call de la GUI) -----
    private void CalcularGraficoRendimiento()
    {
        rendimiento = new();
        if (historial.Count == 0) return;

        var inicio = historial.Min(h => h.FechaEnvio).Date;

        var crudo = new List<(string Dia, int Leidos, int Conversiones)>();
        for (int dia = 1; dia <= 7; dia++)
        {
            var desde = inicio.AddDays(dia - 1);
            var hasta = desde.AddDays(1);
            int leidos = historial.Count(h => h.FechaLectura is { } fl && fl >= desde && fl < hasta);
            int conversiones = historial.Count(h => h.FechaConversion is { } fc && fc >= desde && fc < hasta);
            crudo.Add(($"Día {dia}", leidos, conversiones));
        }

        int maximo = Math.Max(1, crudo.Max(d => Math.Max(d.Leidos, d.Conversiones)));
        const int alturaMaximaPx = 120;

        rendimiento = crudo.Select(d => (
            d.Dia,
            (int)Math.Round(d.Leidos * alturaMaximaPx / (double)maximo),
            (int)Math.Round(d.Conversiones * alturaMaximaPx / (double)maximo)
        )).ToList();
    }

    // ----- Pasos 8-9: orden -----
    private async Task OrdenarPor(string columna)
    {
        columnaOrden = columna;
        await RecargarConFiltrosYOrden();
    }

    // ----- Pasos 10-13: filtros -----
    private async Task CambiarFiltro(string? plan = null, string? resultado = null)
    {
        if (plan != null) planActivo = plan;
        if (resultado != null) resultadoActivo = resultado;
        paginaActual = 1;
        await RecargarConFiltrosYOrden();
    }

    private async Task LimpiarFiltros()
    {
        planActivo = "Todos";
        resultadoActivo = "Todos";
        paginaActual = 1;
        historial = await BLLHistorialAcciones.ObtenerHistorialCampania(IdCampania);
    }

    private async Task RecargarConFiltrosYOrden()
    {
        historial = (planActivo != "Todos" || resultadoActivo != "Todos")
            ? await BLLHistorialAcciones.FiltrarPorClientes(IdCampania, resultadoActivo, planActivo)
            : await BLLHistorialAcciones.OrdenarHistorialCampania(IdCampania, columnaOrden);
    }

    private List<string> PlanesDisponibles => historial.Select(h => h.PlanCliente).Distinct().OrderBy(p => p).ToList();

    // ----- Paginación -----
    private List<HistorialAccion> HistorialPaginaActual =>
        historial.Skip((paginaActual - 1) * tamanioPagina).Take(tamanioPagina).ToList();

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(historial.Count / (double)tamanioPagina));

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    private List<int> NumerosDePagina()
    {
        var numeros = new List<int> { 1 };
        int desde = Math.Max(2, paginaActual - 1);
        int hasta = Math.Min(TotalPaginas - 1, paginaActual + 1);
        for (int i = desde; i <= hasta; i++) numeros.Add(i);
        if (TotalPaginas > 1) numeros.Add(TotalPaginas);
        return numeros.Distinct().ToList();
    }

    // ----- Paso 14-16: exportar (self-call de la GUI) -----
    private async Task ExportarInforme()
    {
        exportando = true;
        mensajeExportacion = "";
        try
        {
            var pdfBytes = GeneradorPdf.GenerarInformeCampana(campana!, historial,
                MensajesEntregados, TasaApertura, ClicsEnlace, TasaClics, SociosRecuperados, TasaConversion);
            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("descargarArchivo", $"Campana_{campana!.Nombre}_{DateTime.Now:yyyyMMdd_HHmm}.pdf", base64);
        }
        catch (Exception)
        {
            mensajeExportacion = "No fue posible generar el archivo. Podés reintentar o seguir navegando el detalle normalmente.";
        }
        finally
        {
            exportando = false;
        }
    }

    // ----- Helpers visuales -----
    private string Iniciales(HistorialAccion h) =>
        $"{h.NombreCliente.FirstOrDefault()}{h.ApellidoCliente.FirstOrDefault()}".ToUpper();

    private string IconoCanal(string canal) => canal switch
    {
        "WhatsApp" => "📱",
        "Email" => "✉️",
        _ => "📣"
    };

    private string ClaseEstado(string estado) => estado == "Leído" ? "estado-leido" : "estado-entregado";
    private string IconoEstado(string estado) => "✓";

    private string ClaseResultado(string resultado) => resultado switch
    {
        "Rescatado" => "resultado-rescatado",
        "Clic en enlace" => "resultado-clic",
        _ => "resultado-sin-accion"
    };
}