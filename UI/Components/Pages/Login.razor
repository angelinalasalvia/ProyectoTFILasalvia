@page "/"
@page "/login"
@layout Components.Layout.AuthLayout
@inject NavigationManager Navigation
@inject BLLUsuario UsuarioBLL
@inject BLLBitacora BitacoraBLL
@inject BLLRol RolBLL
@using BE
@using BLL
@using Servicios
@using System.Text.RegularExpressions

<PageTitle>Iniciar Sesión</PageTitle>

<div class="login-card">
    <!-- Panel izquierdo -->
    <div class="login-panel-izq">
        <div class="login-panel-contenido">
            <h2>Maximiza tu Retención</h2>
            <p>Utiliza algoritmos de aprendizaje profundo para identificar cuentas en riesgo antes de que sea demasiado tarde.</p>
            <hr class="login-divisor-izq" />
            <div class="login-stat-valor">98%</div>
            <div class="login-stat-label">Precisión</div>
        </div>

        <svg class="login-ondas" viewBox="0 0 400 260" preserveAspectRatio="none">
            <path d="M0,120 C60,90 100,150 160,120 C220,90 260,150 320,120 C350,105 380,115 400,110"
                  fill="none" stroke="rgba(255,255,255,0.10)" stroke-width="1.5" />
            <path d="M0,150 C60,120 100,180 160,150 C220,120 260,180 320,150 C350,135 380,145 400,140"
                  fill="none" stroke="rgba(255,255,255,0.14)" stroke-width="1.5" />
            <path d="M0,180 C60,150 100,210 160,180 C220,150 260,210 320,180 C350,165 380,175 400,170"
                  fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" />
            <path d="M0,200 C60,175 100,225 160,200 C220,175 260,225 320,200 C350,190 380,196 400,193"
                  fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1.5" />
        </svg>
    </div>

    <!-- Panel derecho: formulario -->
    <div class="login-panel-der">
        <h2>Bienvenido de nuevo</h2>
        <p class="login-subtitulo">Accede a tu panel estratégico de retención.</p>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="login-alerta">⚠️ @mensajeError</div>
        }
        @if (cuentaBloqueada)
        {
            <div class="login-alerta login-alerta-bloqueo">
                🔒 Tu cuenta fue bloqueada por exceso de intentos fallidos.
                <a href="#" @onclick:preventDefault @onclick="IrARecuperarContrasena">Recuperar contraseña</a>
            </div>
        }

        <label class="form-label">DIRECCIÓN DE EMAIL</label>
        <div class="login-input-wrap @(errores.Contains("email") ? "input-error" : "")">
            <span class="login-input-icon">✉️</span>
            <input type="text" @bind="email" @bind:event="oninput"
                   placeholder="nombre@gmail.com" />
        </div>

        <div class="login-label-row">
            <label class="form-label">CONTRASEÑA</label>
            <a href="#" class="login-forgot-link" @onclick:preventDefault @onclick="IrARecuperarContrasena">
                ¿Olvidaste tu contraseña?
            </a>
        </div>
        <div class="login-input-wrap @(errores.Contains("password") ? "input-error" : "")">
            <span class="login-input-icon">🔒</span>
            <input type="password" @bind="password" @bind:event="oninput"
                   placeholder="••••••••" />
        </div>

        <button class="login-btn-submit" disabled="@procesando" @onclick="IniciarSesion">
            Iniciar Sesión
        </button>

        <hr class="login-divisor-der" />
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string mensajeError = "";
    private bool cuentaBloqueada = false;
    private bool procesando = false;
    private HashSet<string> errores = new();

    // Usuario devuelto por ObtenerUsuario; ValidarContraseña(contraseña) lo usa para comparar.
    private Usuario? usuarioEncontrado;

    // Duración de la sesión (DeterminarDuracionSesion)
    private static readonly TimeSpan DuracionNormal = TimeSpan.FromHours(8);

    // DS CU18: "Selecciona botón Iniciar Sesión()"
    private async Task IniciarSesion()
    {
        if (procesando) return;

        procesando = true;
        errores.Clear();
        mensajeError = "";
        cuentaBloqueada = false;

        try
        {
            if (!ValidarCamposObligatoriosYFormato(email, password))
                return;

            usuarioEncontrado = await UsuarioBLL.ObtenerUsuario(email, password);

            // [Usuario no existe]
            if (usuarioEncontrado is null)
            {
                errores.Add("email");
                mensajeError = "No existe una cuenta registrada con el email ingresado.";
                return;
            }

            // [Usuario Inactivo]
            if (!string.Equals(usuarioEncontrado.Estado, EstadoUsuario.Activo, StringComparison.OrdinalIgnoreCase))
            {
                mensajeError = "La cuenta se encuentra inactiva. Contacte al administrador.";
                return;
            }

            // [Usuario Activo] -> ¿cuenta bloqueada?
            var intentos = await BitacoraBLL.ObtenerIntentosFallidosConsecutivos(email);
            if (intentos >= BLLBitacora.MaxIntentosFallidos)
            {
                cuentaBloqueada = true;
                return;
            }

            // [Cuenta no bloqueada]
            if (ValidarContraseña(password))
            {
                // [Contraseña correcta]
                var rol = await RolBLL.ObtenerRolYPermisos(usuarioEncontrado.Id);
                await BitacoraBLL.ReiniciarContadorIntentosFallidos(email);
                await BitacoraBLL.RegistrarInicioSesion(usuarioEncontrado.Id, AccionBitacora.InicioSesion, DateTime.Now);

                CargarPermisosEnSesion(rol);
                var duracion = DeterminarDuracionSesion();
                SessionManager.GetInstance().DefinirDuracion(duracion);

                RedirigirAMenuPrincipal();
            }
            else
            {
                // [Contraseña incorrecta]
                errores.Add("password");
                password = "";
                var intentoFallido = await BitacoraBLL.RegistrarIntentoFallido(email);

                if (intentoFallido >= BLLBitacora.MaxIntentosFallidos)
                    cuentaBloqueada = true;   // "Se ha alcanzado el límite de intentos. La cuenta ha sido bloqueada"
                else
                    mensajeError = "El email o la contraseña son incorrectos.";
            }
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado. Intentá nuevamente en unos minutos.";
        }
        finally
        {
            procesando = false;
        }
    }

    // DS: ValidarCamposObligatoriosYFormato(string email, string contraseña): bool
    private bool ValidarCamposObligatoriosYFormato(string email, string contraseña)
    {
        if (string.IsNullOrWhiteSpace(email)) errores.Add("email");
        if (string.IsNullOrEmpty(contraseña)) errores.Add("password");

        if (errores.Count > 0)
        {
            mensajeError = "Todos los campos son obligatorios.";
            return false;
        }

        if (!Regex.IsMatch(email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            errores.Add("email");
            mensajeError = "El formato del email ingresado no es válido.";
            return false;
        }

        return true;
    }

    // DS: ValidarContraseña(contraseña): bool  (compara contra el hash del usuario encontrado)
    private bool ValidarContraseña(string contraseña)
    {
        return usuarioEncontrado is not null
            && CifradoService.Verificar(contraseña, usuarioEncontrado.Contrasena);
    }

    // DS: CargarPermisosEnSesion(Rol)
    private void CargarPermisosEnSesion(Rol rol)
    {
        usuarioEncontrado!.Contrasena = "";   // el hash no se guarda en la sesión
        var sesion = SessionManager.GetInstance();
        sesion.Login(usuarioEncontrado);
        sesion.CargarPermisos(rol);
    }

    // DS: DeterminarDuracionSesion(): TimeSpan (duración fija, sin "recordar sesión")
    private TimeSpan DeterminarDuracionSesion() => DuracionNormal;

    // DS: RedirigirAMenúPrincipal()
    // DS: RedirigirAMenúPrincipal()  (a la primera pantalla a la que el usuario tiene acceso)
    private void RedirigirAMenuPrincipal()
    {
        var sesion = SessionManager.GetInstance();
        var destino =
            sesion.TienePermiso("Predicciones") ? "/predicciones" :
            sesion.TienePermiso("Reportes") ? "/reportes/efectividad" :
            sesion.TienePermiso("Campañas") ? "/campanas" :
            sesion.TienePermiso("Reglas") ? "/automatizacion" :
            sesion.TienePermiso("Gestión de Usuarios") ? "/administracion/usuarios" :
                                                         "/clientes";
        Navigation.NavigateTo(destino);
    }

    // DS: opción "¿Olvidaste tu contraseña?" -> CU19 Recuperar contraseña
    private void IrARecuperarContrasena()
    {
        Navigation.NavigateTo("/recuperar-contrasena");
    }

    protected override void OnInitialized()
    {
        if (SessionManager.GetInstance().EstaLogueado)
            Navigation.NavigateTo("/predicciones");
    }
}
