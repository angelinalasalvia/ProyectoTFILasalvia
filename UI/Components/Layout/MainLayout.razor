@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using Servicios

@if (estado == Acceso.Permitido)
{
    <div class="app-container">
        <NavMenu />
        <main class="main-content">
            @Body
        </main>
    </div>
}
else if (estado == Acceso.SinPermiso)
{
    <div class="app-container">
        <NavMenu />
        <main class="main-content">
            <h3>Acceso denegado</h3>
            <p>No tenés permisos para ver esta pantalla.</p>
        </main>
    </div>
}

@code {
    private enum Acceso { SinSesion, SinPermiso, Permitido }
    private Acceso estado = Acceso.SinSesion;

    private static readonly Dictionary<string, string> PermisoPorRuta = new()
    {
        ["campanas"] = "Campañas",
        ["predicciones"] = "Predicciones",
        ["detalle-prediccion"] = "Predicciones",
        ["automatizacion"] = "Reglas",
        ["reportes"] = "Reportes",
        ["administracion"] = "Gestión de Usuarios",   // usuarios y roles
    };

    // Corre en cada navegación, no solo la primera vez.
    protected override void OnParametersSet()
    {
        var sesion = SessionManager.GetInstance();

        if (!sesion.EstaLogueado)
        {
            estado = Acceso.SinSesion;
            Navigation.NavigateTo("/login");
            return;
        }

        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].ToLowerInvariant();
        var requerido = PermisoPorRuta.FirstOrDefault(p => ruta.StartsWith(p.Key)).Value;

        estado = requerido is null || sesion.TienePermiso(requerido)
            ? Acceso.Permitido
            : Acceso.SinPermiso;
    }
}