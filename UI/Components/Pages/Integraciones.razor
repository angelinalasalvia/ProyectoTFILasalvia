@page "/integraciones"
@inject NavigationManager Navigation
@using BE
@inject BLL.BLLIntegracion BLLIntegracion
@inject IJSRuntime JS

<PageTitle>Gestión de Integraciones</PageTitle>

<div class="page-header">
    <div class="search-box integ-search-box">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="Buscar fuentes o datos..." @bind="textoBusqueda" @bind:event="oninput" />
    </div>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

<div class="breadcrumb">CONFIGURACIÓN <span class="breadcrumb-sep">›</span> FUENTES DE DATOS</div>
<h1 class="detalle-title">Gestión de Integraciones</h1>
<p class="camp-subtitle">Conecta tus herramientas de CRM y bases de datos para potenciar el análisis predictivo.</p>

<!-- KPIs -->
<div class="integ-kpi-row">
    <div class="card integ-kpi-card">
        <div class="integ-kpi-icon integ-kpi-icon-ok">✅</div>
        <div>
            <div class="integ-kpi-label">ACTIVAS</div>
            <div class="integ-kpi-valor-row">
                <span class="integ-kpi-valor">@activas</span>
                <span class="integ-kpi-sub">Fuentes</span>
            </div>
        </div>
    </div>
    <div class="card integ-kpi-card">
        <div class="integ-kpi-icon integ-kpi-icon-error">⚠️</div>
        <div>
            <div class="integ-kpi-label">CON ERRORES</div>
            <div class="integ-kpi-valor-row">
                <span class="integ-kpi-valor integ-kpi-valor-error">@errores.ToString("D2")</span>
                <span class="integ-kpi-sub integ-kpi-sub-error">Falla crítica</span>
            </div>
        </div>
    </div>
    <div class="card integ-kpi-card">
        <div class="integ-kpi-icon integ-kpi-icon-sync">🕐</div>
        <div>
            <div class="integ-kpi-label">PRÓX. SYNC</div>
            <div class="integ-kpi-valor-row">
                <span class="integ-kpi-valor">@proxSyncTexto</span>
                <span class="integ-kpi-sub">en promedio</span>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="integ-toast @(mensajeEsError ? "" : "integ-toast-ok")" role="alert">
        <span class="integ-toast-icono">@(mensajeEsError ? "⚠️" : "✔")</span>
        <span class="integ-toast-texto">@mensaje</span>
        <button class="integ-toast-cerrar" @onclick="CerrarMensaje" title="Cerrar">✕</button>
    </div>
}

<!-- Listado de fuentes -->
<div class="integ-grid">

    @if (!fuentes.Any())
    {
        <p class="pred-sin-resultados">No hay integraciones configuradas.</p>
    }
    else if (!FuentesFiltradas.Any())
    {
        <p class="pred-sin-resultados">No hay integraciones que coincidan con el texto ingresado.</p>
    }
    @foreach (var f in FuentesFiltradas)
    {
        var enError = f.Estado == Integracion.EstadoError;
        <div class="card integ-fuente-card @(enError ? "integ-fuente-error" : "")">
            @if (enError)
            {
                <div class="integ-error-badge" title="Falla crítica">!</div>
            }

            <div class="integ-fuente-header">
                <div class="integ-fuente-icon @ClaseIcono(f.Tipo)">@Icono(f.Tipo)</div>
                <div class="integ-fuente-nombre-wrap">
                    <div class="integ-fuente-nombre">@f.Nombre</div>
                    <div class="integ-fuente-estado">
                        <span class="integ-estado-dot @(enError ? "integ-dot-rojo" : "integ-dot-verde")"></span>
                        @f.Estado
                    </div>
                </div>
            </div>

            <div class="integ-fuente-datos">
                <div class="integ-dato-row"><span>Tipo</span><span>@f.Tipo</span></div>
                @if (enError)
                {
                    <div class="integ-dato-row">
                        <span>@(f.MensajeError ?? "Error de autenticación")</span>
                        <a href="#" class="integ-link-error" @onclick:preventDefault
                           @onclick="() => EditarCredenciales(f.IdIntegracion)">Revisar credenciales</a>
                    </div>
                    <div class="integ-dato-row"><span>Último éxito</span><span>@FormatearFecha(f.UltimaSincronizacion)</span></div>
                }
                else
                {
                    <div class="integ-dato-row"><span>Última sincronización</span><span>@FormatearFecha(f.UltimaSincronizacion)</span></div>
                    <div class="integ-dato-row"><span>Registros mapeados</span><span>@(f.CantidadRegistros?.ToString("N0") ?? "—")</span></div>
                }
            </div>

            <div class="integ-fuente-actions">
                <button class="integ-btn-editar @(enError ? "integ-btn-editar-alerta" : "")"
                        @onclick="() => EditarCredenciales(f.IdIntegracion)">
                    Editar credenciales
                </button>
                <button class="integ-btn-sync" disabled="@(enError || sincronizandoId == f.IdIntegracion)"
                        @onclick="() => Sincronizar(f.IdIntegracion)">
                    @(sincronizandoId == f.IdIntegracion ? "Sincronizando…" : "↻ Sincronizar")
                </button>
                <button class="integ-btn-eliminar" @onclick="() => SolicitarConfirmacion(f)">Eliminar</button>
            </div>
        </div>
    }

    <!-- Card para añadir nueva fuente -->
    <div class="card integ-add-card" @onclick="AñadirNuevaFuente">
        <div class="integ-add-icon">+</div>
        <div class="integ-add-titulo">Añadir nueva fuente</div>
        <div class="integ-add-sub">Conecta Slack, Zendesk, Intercom o tu API personalizada.</div>
    </div>
</div>

@code {
    private string textoBusqueda = "";
    private string mensaje = "";
    private List<Integracion> fuentes = new();
    private int activas;
    private int errores;
    private string proxSyncTexto = "—";
    private bool mensajeEsError = true;
    private int? sincronizandoId;

    protected override async Task OnInitializedAsync()
    {
        fuentes = await BLLIntegracion.ObtenerIntegraciones();
        CalcularMetricasGlobales();
    }

    private IEnumerable<Integracion> FuentesFiltradas =>
        fuentes.Where(f => string.IsNullOrWhiteSpace(textoBusqueda) ||
                           f.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    // Diagrama CU14: CalcularMetricasGlobales(activas, errores, proxSync)
    private void CalcularMetricasGlobales()
    {
        errores = fuentes.Count(f => f.Estado == Integracion.EstadoError);
        activas = fuentes.Count - errores;

        var minutosRestantes = fuentes
            .Where(f => f.Estado == Integracion.EstadoActiva && f.UltimaSincronizacion != null)
            .Select(f => Math.Max(0, (f.UltimaSincronizacion!.Value + BLL.BLLIntegracion.IntervaloSincronizacion - DateTime.Now).TotalMinutes))
            .ToList();
        proxSyncTexto = minutosRestantes.Count == 0 ? "—" : $"{Math.Round(minutosRestantes.Average())}m";
    }

    private void RecalcularMetricas() => CalcularMetricasGlobales();

    private async Task SolicitarConfirmacion(Integracion f)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm",
            $"¿Eliminar la integración \"{f.Nombre}\"? Esta acción no se puede deshacer.");
        if (confirmado) await ConfirmarEliminacion(f);
        else CancelarEliminacion();
    }

    private async Task ConfirmarEliminacion(Integracion f)
    {
        mensaje = "";
        if (await BLLIntegracion.ValidarDependenciasActivas(f.IdIntegracion))
        {
            MostrarMensaje("La integración posee dependencias activas y no se puede eliminar.");
            return;
        }
        await BLLIntegracion.EliminarIntegracion(f.IdIntegracion);
        EliminarDeLaVista(f);
        RecalcularMetricas();
    }

    private void CancelarEliminacion() { }

    private void EliminarDeLaVista(Integracion f) => fuentes.Remove(f);

    private void EditarCredenciales(int id) => Navigation.NavigateTo($"/integraciones/editar/{id}");

    private void AñadirNuevaFuente() => Navigation.NavigateTo("/integraciones/nueva");

    private async Task Sincronizar(int id)
    {
        sincronizandoId = id;
        mensaje = "";
        try
        {
            var resultado = await BLLIntegracion.ActualizarInformacionIntegracion(id);
            await RefrescarIntegraciones();
            MostrarMensaje(resultado.Mensaje, esError: !resultado.Exito);
        }
        catch (Exception)
        {
            MostrarMensaje("No fue posible completar la sincronización.");
            await RefrescarIntegraciones();
        }
        finally
        {
            sincronizandoId = null;
        }
    }

    // Diagrama CU14: RefrescarIntegraciones() (autollamada de la pantalla): refresca tarjetas y métricas.
    private async Task RefrescarIntegraciones()
    {
        fuentes = await BLLIntegracion.ObtenerIntegraciones();
        RecalcularMetricas();
    }

    // Diagrama CU14: ActualizarInformacionIntegracion() (autollamada de la pantalla): refresca tarjetas y métricas.
    private async Task ActualizarInformacionIntegracion()
    {
        fuentes = await BLLIntegracion.ObtenerIntegraciones();
        RecalcularMetricas();
    }

    private static string FormatearFecha(DateTime? fecha) =>
        fecha is null ? "Nunca" : fecha.Value.ToString("dd/MM/yyyy HH:mm");

    private static string Icono(string tipo) => tipo switch
    {
        Integracion.TipoCRM => "🔗",
        Integracion.TipoBD => "🗄️",
        _ => "🧩"
    };

    private static string ClaseIcono(string tipo) => tipo switch
    {
        Integracion.TipoCRM => "integ-icon-azul",
        Integracion.TipoBD => "integ-icon-gris",
        _ => "integ-icon-morado"
    };

    private void MostrarMensaje(string texto, bool esError = true)
    {
        mensaje = texto;
        mensajeEsError = esError;
        _ = OcultarMensajeLuego(texto);
    }

    private async Task OcultarMensajeLuego(string texto)
    {
        await Task.Delay(5000);
        if (mensaje != texto) return;
        mensaje = "";
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void CerrarMensaje() => mensaje = "";
}