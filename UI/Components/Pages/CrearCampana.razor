@page "/campanas/crear"
@page "/campanas/editar/{CampanaId}"
@using System.Linq
@using BE
@using BLL
@inject NavigationManager Navigation
@inject BLLCampana BLLCampana

<PageTitle>@(EsEdicion ? "Editar Campaña" : "Crear Campaña")</PageTitle>

<div class="page-header">
    <div>
        <h1 class="detalle-title camp-form-title">@(EsEdicion ? "Editar Campaña" : "Crear Campaña")</h1>
        <p class="camp-subtitle">
            @(EsEdicion
                        ? "Modificá los datos de esta campaña de retención."
                        : "Configurá los parámetros básicos para iniciar tu acción de retención predictiva.")
        </p>
    </div>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

<div class="camp-form-layout">

    <div class="camp-form-col">

        <div class="card camp-form-card">
            <label class="form-label">NOMBRE DE LA CAMPAÑA</label>
            <input class="campana-select camp-form-input @(errores.Contains("nombre") ? "input-error" : "")"
                   @bind="nombreCampana" @bind:event="oninput"
                   disabled="@EsEdicion"
                   placeholder="Ej: Campaña de Retención Premium" />
            @if (errores.Contains("nombre"))
            {
                <span class="camp-form-error">El nombre de la campaña es obligatorio.</span>
            }
        </div>

        <div class="card camp-form-card">
            <label class="form-label camp-form-label-icon">🔀 Canal de Envío</label>
            <div class="camp-form-canal-row">
                <button type="button"
                        class="camp-form-canal-btn @(canal == "Email" ? "camp-form-canal-btn-active" : "")"
                        @onclick='() => CambiarCanal("Email")'>
                    ✉️ Email
                </button>
                <button type="button"
                        class="camp-form-canal-btn @(canal == "WhatsApp" ? "camp-form-canal-btn-active" : "")"
                        @onclick='() => CambiarCanal("WhatsApp")'>
                    💬 WhatsApp
                </button>
            </div>
        </div>

        <div class="card camp-form-card">
            <div class="camp-form-editor-header">
                <label class="form-label camp-form-label-icon">📝 Editor de Mensaje</label>
                <button type="button" class="camp-form-plantilla-link" @onclick="CargarPlantillaBase">
                    Cargar Plantilla Base
                </button>
            </div>

            @if (canal == "Email")
            {
                <label class="camp-form-sublabel">ASUNTO</label>
                <input class="campana-select camp-form-input @(errores.Contains("asuntoEmail") ? "input-error" : "")"
                       @bind="asuntoEmail" @bind:event="oninput" />
                @if (errores.Contains("asuntoEmail"))
                {
                    <span class="camp-form-error">El asunto es obligatorio para campañas por Email.</span>
                }
            }

            <label class="camp-form-sublabel">CUERPO DEL MENSAJE</label>
            <div class="camp-form-toolbar">
                <span><b>B</b></span>
                <span><i>I</i></span>
                <span>🔗</span>
            </div>
            <textarea class="camp-form-textarea @(errores.Contains("mensaje") ? "input-error" : "")"
                      rows="6"
                      @bind="mensaje" @bind:event="oninput"></textarea>
            @if (errores.Contains("mensaje"))
            {
                <span class="camp-form-error">El mensaje no puede estar vacío.</span>
            }
        </div>

        <div class="card camp-form-card">
            <label class="form-label camp-form-label-icon">🎯 Público Objetivo</label>
            <textarea class="camp-form-textarea @(errores.Contains("objetivoDescripcion") ? "input-error" : "")"
                      rows="2"
                      @bind="objetivoDescripcion" @bind:event="oninput"
                      placeholder="Ej: Clientes con riesgo alto que no visitaron en los últimos 30 días"></textarea>
            @if (errores.Contains("objetivoDescripcion"))
            {
                <span class="camp-form-error">Describí a qué clientes apunta esta campaña.</span>
            }
        </div>

        <div class="camp-form-row-2">
            <div class="card camp-form-card">
                <label class="form-label camp-form-label-icon">🎁 Incentivo</label>
                <select class="campana-select camp-form-input @(errores.Contains("incentivo") ? "input-error" : "")"
                        @bind="idIncentivoSeleccionado">
                    <option value="">Seleccionar incentivo...</option>
                    @foreach (var inc in incentivosDisponibles)
                    {
                        <option value="@inc.IdIncentivo">@inc.Nombre</option>
                    }
                </select>
                @if (errores.Contains("incentivo"))
                {
                    <span class="camp-form-error">Elegí un incentivo.</span>
                }
            </div>
            <div class="card camp-form-card">
                <label class="form-label camp-form-label-icon">🏆 Meta</label>
                <label class="camp-form-sublabel">CLIENTES A RECUPERAR</label>
                <input type="number" min="1"
                       class="campana-select camp-form-input @(errores.Contains("metaClientes") ? "input-error" : "")"
                       @bind="metaClientes" />
                @if (errores.Contains("metaClientes"))
                {
                    <span class="camp-form-error">Ingresá una cantidad válida.</span>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeConfirmacion))
        {
            <div class="camp-form-confirmacion">✔ @mensajeConfirmacion</div>
        }
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="login-alerta">@mensajeError</div>
        }

        <div class="camp-form-actions">
            <button type="button" class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
            <button type="button" class="btn-confirmar" @onclick="GuardarCampana" disabled="@guardando">
                @(guardando ? "Guardando..." : "Guardar campaña ✓")
            </button>
        </div>
    </div>

    <div class="camp-form-col-preview">
        <div class="camp-form-preview-wrap">
            <div class="camp-form-preview-topbar">
                <span class="camp-form-preview-dots">
                    <i></i><i></i><i></i>
                </span>
                <span class="camp-form-preview-titulo">Vista Previa: @canal</span>
            </div>

            @if (canal == "Email")
            {
                <div class="camp-form-preview-email">
                    <h3>@(string.IsNullOrWhiteSpace(asuntoEmail) ? "Asunto del mensaje" : asuntoEmail)</h3>
                    <p class="camp-form-preview-saludo">Hola @NombreClienteEjemplo,</p>
                    <p class="camp-form-preview-cuerpo">@MensajeConSalto</p>

                    @if (!string.IsNullOrEmpty(NombreIncentivoSeleccionado))
                    {
                        <div class="camp-form-beneficio-box">
                            <div class="camp-form-beneficio-label">TU BENEFICIO ESPECIAL</div>
                            <div class="camp-form-beneficio-valor">@NombreIncentivoSeleccionado</div>
                        </div>
                    }

                    <button class="camp-form-preview-cta">Canjear Beneficio Ahora</button>
                    <div class="camp-form-preview-footer">
                        ¿Ya no querés recibir estos correos? <a href="#">Desuscribirme</a>
                    </div>
                </div>
            }
            else
            {
                <div class="camp-form-preview-whatsapp">
                    <div class="camp-form-preview-wa-bubble">
                        <p class="camp-form-preview-cuerpo">@MensajeConSalto</p>
                        @if (!string.IsNullOrEmpty(NombreIncentivoSeleccionado))
                        {
                            <div class="camp-form-beneficio-box camp-form-beneficio-box-wa">
                                <div class="camp-form-beneficio-label">TU BENEFICIO ESPECIAL</div>
                                <div class="camp-form-beneficio-valor">@NombreIncentivoSeleccionado</div>
                            </div>
                        }
                        <span class="camp-form-preview-wa-hora">10:24 ✓✓</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? CampanaId { get; set; }

    private bool EsEdicion => !string.IsNullOrWhiteSpace(CampanaId);
    private int idCampaniaActual;

    private string nombreCampana = "";
    private string canal = "Email";
    private string asuntoEmail = "";
    private string mensaje = "";
    private string objetivoDescripcion = "";
    private int? idIncentivoSeleccionado;
    private int? metaClientes;
    private string mensajeConfirmacion = "";
    private string mensajeError = "";
    private bool guardando = false;
    private HashSet<string> errores = new();

    private List<Incentivo> incentivosDisponibles = new();

    private const string plantillaBase =
        "¡Te extrañamos! Tenemos un regalo exclusivo para ti\n\n" +
        "Hola {nombre_cliente},\n\n" +
        "Notamos que no has visitado nuestras instalaciones últimamente y queremos que vuelvas. " +
        "Como eres uno de nuestros clientes más valorados, hemos activado un beneficio especial " +
        "para tu próxima renovación.";

    private string NombreClienteEjemplo => "María";

    private string MensajeConSalto =>
        (mensaje ?? "").Replace("{nombre_cliente}", NombreClienteEjemplo);

    private string NombreIncentivoSeleccionado =>
        incentivosDisponibles.FirstOrDefault(i => i.IdIncentivo == idIncentivoSeleccionado)?.Nombre ?? "";

    protected override async Task OnInitializedAsync()
    {
        incentivosDisponibles = await BLLCampana.ObtenerIncentivosDisponibles();

        if (EsEdicion && int.TryParse(CampanaId, out var id))
        {
            await CargarCampanaExistente(id);
        }
        else
        {
            CargarPlantillaBase();
        }
    }

    private async Task CargarCampanaExistente(int id)
    {
        var campana = await BLLCampana.ObtenerCampañaPorId(id);
        if (campana is null)
        {
            mensajeError = "No se encontró la campaña solicitada.";
            return;
        }

        idCampaniaActual = campana.IdCampania;
        nombreCampana = campana.Nombre;
        canal = campana.Canal;
        asuntoEmail = campana.AsuntoEmail ?? "";
        mensaje = campana.Mensaje;
        objetivoDescripcion = campana.Objetivo;
        idIncentivoSeleccionado = campana.IdIncentivo;
        metaClientes = campana.Meta;
    }

    private void CargarPlantillaBase()
    {
        mensaje = plantillaBase;
        if (canal == "Email" && string.IsNullOrWhiteSpace(asuntoEmail))
        {
            asuntoEmail = "¡Te extrañamos! Tenemos un regalo exclusivo para ti";
        }
    }

    private void CambiarCanal(string nuevoCanal)
    {
        canal = nuevoCanal;
        if (canal != "Email")
        {
            asuntoEmail = "";
        }
    }

    private bool Validar()
    {
        errores.Clear();

        if (string.IsNullOrWhiteSpace(nombreCampana)) errores.Add("nombre");
        if (canal == "Email" && string.IsNullOrWhiteSpace(asuntoEmail)) errores.Add("asuntoEmail");
        if (string.IsNullOrWhiteSpace(mensaje)) errores.Add("mensaje");
        if (string.IsNullOrWhiteSpace(objetivoDescripcion)) errores.Add("objetivoDescripcion");
        if (idIncentivoSeleccionado is null) errores.Add("incentivo");
        if (metaClientes is null or <= 0) errores.Add("metaClientes");

        return errores.Count == 0;
    }

    private async Task GuardarCampana()
    {
        mensajeError = "";
        if (!Validar())
        {
            mensajeConfirmacion = "";
            return;
        }

        guardando = true;
        try
        {
            var idCanal = await BLLCampana.ObtenerIdCanalPorNombre(canal);

            var campana = new Campana
            {
                IdCampania = idCampaniaActual,
                Nombre = nombreCampana,
                IdCanal = idCanal,
                Objetivo = objetivoDescripcion,
                Meta = metaClientes,
                AsuntoEmail = canal == "Email" ? asuntoEmail : null,
                Mensaje = mensaje,
                IdIncentivo = idIncentivoSeleccionado
            };

            if (EsEdicion)
            {
                await BLLCampana.ActualizarCampana(campana);
                mensajeConfirmacion = "Campaña actualizada exitosamente.";
            }
            else
            {
                await BLLCampana.CrearCampana(campana);
                mensajeConfirmacion = "Campaña creada exitosamente.";
            }

            StateHasChanged();
            _ = RedirigirConDelay();
        }
        catch (Exception)
        {
            mensajeError = "No fue posible guardar la campaña. Intentá nuevamente.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task RedirigirConDelay()
    {
        await Task.Delay(1200);
        Navigation.NavigateTo("/campanas");
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/campanas");
    }
}