@page "/administracion/usuarios"
@inject NavigationManager Navigation
@inject BLLUsuario UsuarioBLL
@inject BLLRol RolBLL
@inject BLLTokenActivacion TokenActivacionBLL
@inject ServicioEnvio Envio
@using BE
@using BLL
@using Servicios

<PageTitle>Gestión de Usuarios</PageTitle>

<div class="usr-topbar">
    <div class="search-box usr-search-box">
        <span class="search-icon">🔍</span>
        <input type="text" placeholder="Buscar por nombre o correo..." @bind="textoBusqueda" @bind:event="oninput" @bind:after="BuscarUsuarioAsync" />
    </div>
    <div class="usr-topbar-icons">
        <button class="usr-icon-btn" title="Notificaciones">
            🔔
            <span class="usr-notif-dot"></span>
        </button>
        <button class="usr-icon-btn" title="Ayuda">❓</button>
        <button class="usr-icon-btn" title="Configuración">⚙️</button>
    </div>
</div>

<div class="page-header">
    <div>
        <h1>Gestión de Usuarios</h1>
        <p class="camp-subtitle">Administra el acceso de tu equipo y define sus niveles de privilegio.</p>
    </div>
    <button class="btn-crear-campana" @onclick="AbrirFormularioUsuario">
        <span>➕</span> Agregar usuario
    </button>
</div>

<div class="usr-kpi-row">
    <div class="card usr-kpi-card">
        <div class="usr-kpi-icon usr-kpi-icon-total">👥</div>
        <div>
            <div class="usr-kpi-label">TOTAL USUARIOS</div>
            <div class="usr-kpi-value">@totalUsuarios.ToString("N0")</div>
        </div>
    </div>
    <div class="card usr-kpi-card">
        <div class="usr-kpi-icon usr-kpi-icon-activos">✔</div>
        <div>
            <div class="usr-kpi-label">USUARIOS ACTIVOS</div>
            <div class="usr-kpi-value">@usuariosActivos.ToString("N0")</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensajeExito))
{
    <div class="usr-mensaje">✔ @mensajeExito</div>
}
@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="usr-mensaje usr-mensaje-error">⚠ @mensajeError</div>
}

<div class="card">
    <div class="pred-filter-row">
        <div class="filter-left">
            <span class="filter-label">Filtrar por:</span>
            <select class="filtro-select" @bind="rolFiltro" @bind:after="FiltrarTabla">
                <option value="">Todos los roles</option>
                @foreach (var r in rolesDisponibles)
                {
                    <option value="@r.IdRol">@r.Nombre</option>
                }
            </select>
        </div>
        <span class="pagination-info">Mostrando @usuariosPagina.Count de @totalUsuarios.ToString("N0") usuarios</span>
    </div>

    @if (cargando)
    {
        <div class="usr-vacio">Cargando usuarios…</div>
    }
    else if (todosLosUsuarios.Count == 0)
    {
        <div class="usr-vacio">No existen usuarios registrados en la plataforma. Podés registrar uno con "Agregar usuario".</div>
    }
    else if (usuarios.Count == 0)
    {
        <div class="usr-vacio">
            <span>@MensajeSinResultados</span>
            @if (!string.IsNullOrEmpty(rolFiltro))
            {
                <button class="page-btn" @onclick="QuitarFiltro">Quitar filtro</button>
            }
        </div>
    }
    else
    {
        <table class="cli-table">
            <thead>
                <tr>
                    <th>NOMBRE COMPLETO</th>
                    <th>ROL ASIGNADO</th>
                    <th>ESTADO</th>
                    <th class="usr-th-acciones">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in usuariosPagina)
                {
                    <tr>
                        <td>
                            <div class="client-cell">
                                <div class="cli-avatar @usuario.AvatarClase">@usuario.Iniciales</div>
                                <div>
                                    <div class="client-name">@usuario.NombreCompleto</div>
                                    <div class="cli-email">@usuario.Email</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="usr-rol-badge">@usuario.NombreRol</span></td>
                        <td>
                            <div class="integ-fuente-estado">
                                <span class="integ-estado-dot @(usuario.Activo ? "integ-dot-verde" : "usr-dot-gris")"></span>
                                @(usuario.Activo ? "Activo" : "Inactivo")
                            </div>
                        </td>
                        <td class="usr-acciones-cell">
                            @if (!usuario.Activo)
                            {
                                <button class="auto-icon-btn usr-mail-alert" title="Reenviar invitación" @onclick="() => ReenviarInvitacion(usuario)">✉️</button>
                            }
                            <button class="auto-icon-btn" title="Editar" @onclick="() => EditarUsuario(usuario)">✏️</button>
                            <button class="auto-icon-btn" title="Eliminar" @onclick="() => SolicitarEliminacion(usuario)">🗑️</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pred-pagination">
            <span class="pagination-info">Página @paginaActual de @totalPaginas</span>
            <div class="pagination-controls">
                <button class="page-btn" disabled="@(paginaActual == 1)" @onclick="PaginaAnterior">‹ Anterior</button>
                @for (int i = 1; i <= Math.Min(3, totalPaginas); i++)
                {
                    var pagina = i;
                    <button class="page-btn @(paginaActual == pagina ? "active" : "")" @onclick="() => IrAPagina(pagina)">@pagina</button>
                }
                @if (totalPaginas > 3)
                {
                    <span class="pagination-info">…</span>
                    <button class="page-btn" @onclick="() => IrAPagina(totalPaginas)">@totalPaginas</button>
                }
                <button class="page-btn" disabled="@(paginaActual == totalPaginas)" @onclick="PaginaSiguiente">Siguiente ›</button>
            </div>
        </div>
    }
</div>

@if (usuarioAEliminar is not null)
{
    <div class="usr-modal-overlay">
        <div class="card usr-modal">
            <h3>Eliminar usuario</h3>
            <p>
                ¿Confirmás que querés eliminar a <strong>@usuarioAEliminar.NombreCompleto</strong>?
                El usuario dejará de tener acceso a la plataforma.
            </p>
            <div class="usr-modal-actions">
                <button class="btn-cancelar" @onclick="CancelarEliminacion">Cancelar</button>
                <button class="btn-confirmar" @onclick="ConfirmarEliminacion">Eliminar</button>
            </div>
        </div>
    </div>
}

@code {
    private const int TamanoPagina = 10;
    private static readonly string[] AvatarClases = { "cli-avatar-azul", "cli-avatar-ambar", "cli-avatar-rojo" };

    private string textoBusqueda = "";
    private string rolFiltro = "";
    private int paginaActual = 1;
    private bool cargando = true;

    private string mensajeExito = "";
    private string mensajeError = "";

    private List<Rol> rolesDisponibles = new();
    private List<Usuario> todosLosUsuarios = new();   
    private List<UsuarioItem> usuarios = new();      
    private UsuarioItem? usuarioAEliminar;

    private int totalUsuarios => todosLosUsuarios.Count;
    private int usuariosActivos => todosLosUsuarios.Count(u => EsActivo(u.Estado));
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling(usuarios.Count / (double)TamanoPagina));
    private List<UsuarioItem> usuariosPagina =>
        usuarios.Skip((paginaActual - 1) * TamanoPagina).Take(TamanoPagina).ToList();

    private string MensajeSinResultados =>
        !string.IsNullOrWhiteSpace(textoBusqueda)
            ? "No se encontraron usuarios que coincidan con el criterio ingresado."   // CU20 8.1
            : "No se encontraron usuarios para el rol filtrado.";                      // CU20 6.1

    // DS: Ingresa a "Gestión de usuarios"
    protected override async Task OnInitializedAsync()
    {
        try
        {
            rolesDisponibles = await RolBLL.ObtenerRoles();
            await CargarUsuarios();
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar el listado de usuarios.";
        }
        finally
        {
            cargando = false;
        }
    }

    // DS: ObtenerUsuarios() + MostrarTablaUsuarios()
    private async Task CargarUsuarios()
    {
        todosLosUsuarios = await UsuarioBLL.ObtenerUsuarios();
        await AplicarFiltros();
    }

    // DS: FiltrarTabla() -> ObtenerUsuariosPorRol()  /  Buscar usuario() -> BuscarUsuario(dato)
    private async Task AplicarFiltros()
    {
        IEnumerable<Usuario> resultado = todosLosUsuarios;

        if (int.TryParse(rolFiltro, out var idRol))
            resultado = await UsuarioBLL.ObtenerUsuariosPorRol(idRol);

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var coincidencias = (await UsuarioBLL.BuscarUsuario(textoBusqueda)).Select(u => u.Id).ToHashSet();
            resultado = resultado.Where(u => coincidencias.Contains(u.Id));
        }

        usuarios = resultado.Select(ArmarItem).ToList();
        paginaActual = Math.Min(paginaActual, totalPaginas);
    }

    private async Task FiltrarTabla()
    {
        paginaActual = 1;
        await AplicarFiltrosSeguro();
    }

    private async Task BuscarUsuarioAsync()
    {
        paginaActual = 1;
        await AplicarFiltrosSeguro();
    }

    private async Task QuitarFiltro()
    {
        rolFiltro = "";
        await FiltrarTabla();
    }

    private async Task AplicarFiltrosSeguro()
    {
        mensajeExito = "";
        mensajeError = "";
        try
        {
            await AplicarFiltros();
        }
        catch (Exception)
        {
            mensajeError = "No se pudo actualizar el listado.";
        }
    }

    // DS: Solicita eliminar un usuario(int idUsuario) -> SolicitarConfirmacion()
    private void SolicitarEliminacion(UsuarioItem usuario)
    {
        mensajeExito = "";
        mensajeError = "";
        usuarioAEliminar = usuario;
    }

    // DS: ConfirmarEliminacion()
    private async Task ConfirmarEliminacion()
    {
        var usuario = usuarioAEliminar;
        if (usuario is null) return;

        usuarioAEliminar = null;

        try
        {
            // DS: ValidarEliminacion(idUsuario, idUsuarioSesion) -> :Usuario (BLL)
            var idSesion = SessionManager.GetInstance().Usuario?.Id ?? 0;
            var validacion = await UsuarioBLL.ValidarEliminacion(usuario.Id, idSesion);

            if (!validacion.Valido)
            {
                mensajeError = $"No es posible eliminar el usuario: {validacion.Motivo}";
                return;
            }

            await UsuarioBLL.EliminarUsuario(usuario.Id);
            await CargarUsuarios();   // DS: ObtenerUsuarios() + MostrarTablaUsuarios()
            mensajeExito = "El usuario fue eliminado correctamente.";
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado al eliminar el usuario.";
        }
    }

    

    // DS: CancelarEliminacion() -> MantenerVistaSinCambios()
    private void CancelarEliminacion() => MantenerVistaSinCambios();

    private void MantenerVistaSinCambios() => usuarioAEliminar = null;

    // DS: Selecciona "Nuevo Usuario" -> CU21
    private void AbrirFormularioUsuario()
    {
        Navigation.NavigateTo("/administracion/usuarios/nuevo");
    }

    // DS: Selecciona "Modificar Usuario" -> CU22
    private void EditarUsuario(UsuarioItem usuario)
    {
        Navigation.NavigateTo($"/administracion/usuarios/editar/{usuario.Id}");
    }

    // DS: Solicita reenvío de correo de activación(int idUsuario)
    private async Task ReenviarInvitacion(UsuarioItem usuario)
    {
        mensajeExito = "";
        mensajeError = "";

        if (await EnviarCorreoActivacion(usuario.Id))
            mensajeExito = "Correo de activación reenviado con éxito.";
        else
            mensajeError = "No fue posible reenviar el correo de activación.";
    }

    // DS: EnviarCorreoActivacion(int idUsuario): bool
    private async Task<bool> EnviarCorreoActivacion(int idUsuario)
    {
        try
        {
            var usuario = await UsuarioBLL.ObtenerUsuario(idUsuario);
            if (usuario is null) return false;

            var tokenLink = await TokenActivacionBLL.GenerarTokenActivacion(usuario.Email, Navigation.BaseUri);
            var resultado = await Envio.EnviarInstruccionesAcceso(usuario.Email, tokenLink);
            return resultado.Exito;
        }
        catch (Exception)
        {
            return false;
        }
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1) paginaActual--;
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas) paginaActual++;
    }

    private void IrAPagina(int pagina)
    {
        paginaActual = pagina;
    }

    private UsuarioItem ArmarItem(Usuario u) => new()
    {
        Id = u.Id,
        NombreCompleto = u.NombreCompleto,
        Email = u.Email,
        Iniciales = Inicial(u.Nombre) + Inicial(u.Apellido),
        AvatarClase = AvatarClases[u.Id % AvatarClases.Length],
        IdRol = u.IdRol,
        NombreRol = rolesDisponibles.FirstOrDefault(r => r.IdRol == u.IdRol)?.Nombre ?? "",
        Activo = EsActivo(u.Estado)
    };

    private static string Inicial(string texto)
        => string.IsNullOrWhiteSpace(texto) ? "" : texto.Trim()[..1].ToUpper();

    private static bool EsActivo(string estado)
        => string.Equals(estado, EstadoUsuario.Activo, StringComparison.OrdinalIgnoreCase);

    private class UsuarioItem
    {
        public int Id { get; set; }
        public string NombreCompleto { get; set; } = "";
        public string Email { get; set; } = "";
        public string Iniciales { get; set; } = "";
        public string AvatarClase { get; set; } = "";
        public int IdRol { get; set; }
        public string NombreRol { get; set; } = "";
        public bool Activo { get; set; }
    }
}