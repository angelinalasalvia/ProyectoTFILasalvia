@page "/administracion/roles"

@inject NavigationManager Navigation

<PageTitle>Gestión de Roles y Permisos</PageTitle>

<!-- Barra superior -->
<div class="usr-topbar">
    <div class="search-box usr-search-box">
        <span class="search-icon">🔍</span>

        <input type="text"
               placeholder="Buscar permisos..."
               @bind="textoBusqueda"
               @bind:event="oninput" />
    </div>

    <div class="usr-topbar-icons">

        <button class="usr-icon-btn" title="Notificaciones">
            🔔
        </button>

        <button class="usr-icon-btn" title="Ayuda">
            ❓
        </button>

        <button class="usr-icon-btn" title="Configuración">
            ⚙️
        </button>

    </div>
</div>


<!-- Encabezado -->
<div class="page-header">

    <div>
        <h1>Gestión de Roles y Permisos</h1>

        <p class="camp-subtitle">
            Define y administra el nivel de acceso para cada tipo de usuario en el sistema.
        </p>
    </div>

    <button class="btn-crear-campana"
            @onclick="CrearRolPersonalizado">

        <span>＋</span>
        Nuevo Rol Personalizado

    </button>

</div>


<!-- Roles -->
<div class="roles-grid">

    @foreach (var rol in roles)
    {
        <div class="card rol-card">

            <div class="rol-card-header">

                <div class="rol-icon @rol.ClaseIcono">
                    @rol.Icono
                </div>

                <div class="rol-nombre">
                    @rol.Nombre
                </div>

                @if (rol.EsAdministrador)
                {
                    <div class="rol-lock"
                         title="Rol con permisos obligatorios">
                        🛡
                    </div>
                }

            </div>

            <p class="rol-descripcion">
                @rol.Descripcion
            </p>

        </div>
    }

</div>


<!-- Matriz -->
<div class="card roles-matriz-card">

    <div class="roles-matriz-header">

        <div>
            <h2>Matriz de Permisos Específicos</h2>

            <p>
                Configura granularmente qué puede hacer cada rol dentro del ecosistema.
            </p>
        </div>

        <div class="roles-matriz-actions">

            <button class="btn-cancelar"
                    @onclick="Cancelar">
                Cancelar
            </button>

            <button class="btn-confirmar"
                    @onclick="GuardarCambios">
                Guardar Cambios
            </button>

        </div>

    </div>


    <!-- Tabla -->
    <div class="roles-table-container">

        <table class="roles-permisos-table">

            <thead>
                <tr>

                    <th>PERMISO</th>

                    @foreach (var rol in roles)
                    {
                        <th>
                            @rol.Nombre
                        </th>
                    }

                </tr>
            </thead>

            <tbody>

                @foreach (var permiso in permisos)
                {
                    <tr>

                        <td>
                            <div class="permiso-nombre">

                                <span class="permiso-icon">
                                    @permiso.Icono
                                </span>

                                <span>
                                    @permiso.Nombre
                                </span>

                            </div>
                        </td>


                        @foreach (var rol in roles)
                        {
                            <td>

                                <input type="checkbox"
                                       class="permiso-checkbox"
                                       checked="@TienePermiso(rol, permiso)"
                                       disabled="@EsPermisoObligatorio(rol, permiso)"
                                       @onchange="e => CambiarPermiso(rol, permiso, e)" />

                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="roles-mensaje">
        ✔ @mensaje
    </div>
}


<!-- Paginación -->
<div class="roles-pagination">

    <button class="page-btn"
            disabled="@(paginaActual == 1)"
            @onclick="PaginaAnterior">
        ‹ Anterior
    </button>

    <div class="roles-pagination-pages">

        @for (int i = 1; i <= totalPaginas; i++)
        {
            var pagina = i;

            <button class="page-btn @(paginaActual == pagina ? "active" : "")"
                    @onclick="() => IrAPagina(pagina)">
                @pagina
            </button>
        }

    </div>

    <button class="page-btn"
            disabled="@(paginaActual == totalPaginas)"
            @onclick="PaginaSiguiente">
        Siguiente ›
    </button>

</div>


@code {

    private string textoBusqueda = "";

    private int paginaActual = 1;

    private int totalPaginas = 12;

    private string mensaje = "";


    private List<RolItem> roles = new()
    {
        new RolItem
        {
            Id = 1,
            Nombre = "Administrador",
            Descripcion = "Acceso total a todas las funciones.",
            Icono = "⚿",
            ClaseIcono = "rol-icon-admin",
            EsAdministrador = true
        },

        new RolItem
        {
            Id = 2,
            Nombre = "Gerente",
            Descripcion = "Tiene acceso a reportes de efectividad y de retención.",
            Icono = "↗",
            ClaseIcono = "rol-icon-gerente",
            EsAdministrador = false
        },

        new RolItem
        {
            Id = 3,
            Nombre = "Ejecutivo Comercial",
            Descripcion = "Puede gestionar predicciones, campañas y reglas.",
            Icono = "▧",
            ClaseIcono = "rol-icon-ejecutivo",
            EsAdministrador = false
        }
    };


    private List<PermisoItem> permisos = new()
    {
        new PermisoItem
        {
            Id = 1,
            Nombre = "Reportes",
            Icono = "▣"
        },

        new PermisoItem
        {
            Id = 2,
            Nombre = "Campañas",
            Icono = "☷"
        },

        new PermisoItem
        {
            Id = 3,
            Nombre = "Reglas",
            Icono = "♧"
        },

        new PermisoItem
        {
            Id = 4,
            Nombre = "Predicciones",
            Icono = "✥"
        },

        new PermisoItem
        {
            Id = 5,
            Nombre = "Gestión de Usuarios",
            Icono = "♢"
        }
    };


    /*
     * Configuración inicial de permisos.
     *
     * Esta parte después debería venir de BLL/DAL.
     */
    private Dictionary<(int RolId, int PermisoId), bool> permisosAsignados = new()
    {
        // Administrador
        { (1, 1), true },
        { (1, 2), true },
        { (1, 3), true },
        { (1, 4), true },
        { (1, 5), true },

        // Gerente
        { (2, 1), true },
        { (2, 2), false },
        { (2, 3), false },
        { (2, 4), false },
        { (2, 5), false },

        // Ejecutivo Comercial
        { (3, 1), false },
        { (3, 2), true },
        { (3, 3), true },
        { (3, 4), true },
        { (3, 5), false }
    };


    private bool TienePermiso(RolItem rol, PermisoItem permiso)
    {
        if (permisosAsignados.TryGetValue(
                (rol.Id, permiso.Id),
                out bool asignado))
        {
            return asignado;
        }

        return false;
    }


    private bool EsPermisoObligatorio(
        RolItem rol,
        PermisoItem permiso)
    {
        /*
         * CU22 - Alternativo 9.2:
         * El Administrador posee permisos obligatorios.
         *
         * Por ahora se considera que todos los permisos
         * del Administrador son obligatorios.
         *
         * Si después definís cuáles son específicamente
         * obligatorios, esto se cambia acá.
         */

        return rol.EsAdministrador;
    }


    private void CambiarPermiso(
        RolItem rol,
        PermisoItem permiso,
        ChangeEventArgs e)
    {
        /*
         * El Administrador no puede modificar permisos
         * obligatorios.
         */

        if (EsPermisoObligatorio(rol, permiso))
            return;


        bool nuevoValor = e.Value is bool valor && valor;

        permisosAsignados[(rol.Id, permiso.Id)] = nuevoValor;

        mensaje = "";
    }


    private void GuardarCambios()
    {
        /*
         * CU22 paso 9:
         * validar consistencia de la configuración.
         */

        if (!ConfiguracionValida())
        {
            mensaje = "La configuración seleccionada es inconsistente.";
            return;
        }


        /*
         * TODO:
         * Persistir mediante BLL/DAL.
         */

        mensaje = "La configuración fue actualizada correctamente.";

        StateHasChanged();
    }


    private bool ConfiguracionValida()
    {
        /*
         * Acá después pueden agregarse las reglas
         * reales de consistencia.
         *
         * Por ahora el Administrador mantiene todos
         * sus permisos obligatorios.
         */

        foreach (var permiso in permisos)
        {
            if (!TienePermiso(roles.First(r => r.EsAdministrador), permiso))
                return false;
        }

        return true;
    }


    private void Cancelar()
    {
        /*
         * CU22 - Alternativo 8.1:
         * descartar modificaciones.
         *
         * Volvemos a cargar la configuración original.
         */

        CargarConfiguracionOriginal();

        mensaje = "";
    }


    private void CargarConfiguracionOriginal()
    {
        /*
         * TODO:
         * volver a consultar los permisos desde BLL/DAL.
         *
         * Por ahora se restablece la configuración
         * inicial de demostración.
         */

        permisosAsignados = new()
        {
            { (1, 1), true },
            { (1, 2), true },
            { (1, 3), true },
            { (1, 4), true },
            { (1, 5), true },

            { (2, 1), true },
            { (2, 2), false },
            { (2, 3), false },
            { (2, 4), false },
            { (2, 5), false },

            { (3, 1), false },
            { (3, 2), true },
            { (3, 3), true },
            { (3, 4), true },
            { (3, 5), false }
        };
    }


    private void CrearRolPersonalizado()
    {
        /*
         * La captura tiene este botón,
         * pero CU22 no describe el CU de creación
         * de roles personalizados.
         *
         * Por ahora no implementamos el flujo.
         */
    }


    private void PaginaAnterior()
    {
        if (paginaActual > 1)
            paginaActual--;
    }


    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
            paginaActual++;
    }


    private void IrAPagina(int pagina)
    {
        paginaActual = pagina;
    }


    private class RolItem
    {
        public int Id { get; set; }

        public string Nombre { get; set; } = "";

        public string Descripcion { get; set; } = "";

        public string Icono { get; set; } = "";

        public string ClaseIcono { get; set; } = "";

        public bool EsAdministrador { get; set; }
    }


    private class PermisoItem
    {
        public int Id { get; set; }

        public string Nombre { get; set; } = "";

        public string Icono { get; set; } = "";
    }
}
