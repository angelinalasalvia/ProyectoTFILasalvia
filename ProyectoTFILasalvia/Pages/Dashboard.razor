@page "/"

<PageTitle>Panel de Retención</PageTitle>

<div class="page-header">
    <h1>Panel de Retención</h1>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

<div class="kpi-row">
    <div class="card kpi-card">
        <div class="kpi-label">TASA DE CHURN</div>
        <div class="kpi-value">2.4% <span class="badge badge-red">↗0.3%</span></div>
        <div class="kpi-sub">vs. mes anterior (2.1%)</div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-label">CLIENTES EN RIESGO</div>
        <div class="kpi-value">142 <span class="badge badge-critical">CRÍTICO</span></div>
        <div class="kpi-sub">9 nuevos detectados hoy</div>
    </div>

    <div class="card kpi-card">
        <div class="kpi-label">CLIENTES RECUPERADOS</div>
        <div class="kpi-value">28 <span class="badge badge-blue">↘-5%</span></div>
        <div class="kpi-sub">Mediante automatización</div>
    </div>
</div>

<div class="main-row">
    <div class="card chart-card">
        <div class="chart-header">
            <h3>Tendencia de Abandono (6 meses)</h3>
            <div class="toggle-group">
                <button class="toggle active">Mes</button>
                <button class="toggle">Trimestre</button>
            </div>
        </div>
        <div class="chart-placeholder">
            <svg viewBox="0 0 600 200" preserveAspectRatio="none" class="trend-svg">
                <polyline fill="none" stroke="#cbd5e1" stroke-width="2"
                          points="0,140 40,120 80,150 120,110 160,130 200,90 240,100 280,80 320,95 360,60 400,75 440,50 480,55 520,35 560,20 600,15" />
            </svg>
            <div class="chart-months">
                <span>ENE</span><span>FEB</span><span>MAR</span><span>ABR</span><span>MAY</span><span class="current">JUN</span>
            </div>
        </div>
    </div>

    <div class="card risk-card">
        <h3>Distribución de Riesgo</h3>
        <div class="risk-donut" style="--alto:15; --medio:32; --bajo:53;">
            <div class="risk-donut-center">
                <div class="risk-total">840</div>
                <div class="risk-total-label">TOTAL</div>
            </div>
        </div>
        <ul class="risk-legend">
            <li><span class="dot dot-alto"></span> Alto <span class="legend-value">15%</span></li>
            <li><span class="dot dot-medio"></span> Medio <span class="legend-value">32%</span></li>
            <li><span class="dot dot-bajo"></span> Bajo <span class="legend-value">53%</span></li>
        </ul>
    </div>
</div>

<div class="card table-card">
    <h3>Clientes en Riesgo Crítico</h3>
    <p class="table-subtitle">Acción recomendada inmediata para estos perfiles</p>

    <table class="risk-table">
        <thead>
            <tr>
                <th>CLIENTE</th>
                <th>PROBABILIDAD</th>
                <th>ÚLTIMA ACTIVIDAD</th>
                <th>USO DE PRODUCTO</th>
                <th>ACCIÓN</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in clientes)
            {
                <tr>
                    <td>
                        <div class="client-cell">
                            <div class="client-avatar"></div>
                            <div>
                                <div class="client-name">@c.Nombre</div>
                                <div class="client-plan">@c.Plan</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="prob-cell">
                            <div class="prob-bar"><div class="prob-fill" style="width:@(c.Probabilidad)%"></div></div>
                            <span>@c.Probabilidad%</span>
                        </div>
                    </td>
                    <td>@c.UltimaActividad</td>
                    <td><span class="uso-badge">@c.UsoProducto</span></td>
                    <td><button class="btn-contactar" @onclick="() => Contactar(c.Nombre)">Contactar</button></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private record Cliente(string Nombre, string Plan, int Probabilidad, string UltimaActividad, string UsoProducto);

    private List<Cliente> clientes = new()
    {
        new("Alejandro Mendoza", "Plan Enterprise • $4.5k/mes", 92, "Hace 4 días", "-40% este mes"),
        new("Valeria Torres", "Plan Pro • $1.2k/mes", 84, "Hace 2 días", "-25% este mes"),
        new("Ricardo Salcedo", "Plan Enterprise • $8.9k/mes", 79, "Hoy", "Sin cambios"),
    };

    private void Contactar(string nombre)
    {
        // TODO: navegar a la ficha del cliente o abrir modal de contacto
        Console.WriteLine($"Contactar a {nombre}");
    }
}
