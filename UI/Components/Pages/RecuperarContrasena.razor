@page "/recuperar-contrasena"
@layout Components.Layout.AuthLayout
@inject NavigationManager Navigation
@inject BLLUsuario UsuarioBLL
@inject BLLTokenRecuperacion TokenBLL
@inject ServicioEnvio Envio
@inject ILogger<RecuperarContrasena> Logger
@using BE
@using BLL
@using Servicios
@using Microsoft.Extensions.Logging
@using System.Text.RegularExpressions

<PageTitle>Recuperar acceso</PageTitle>

<div class="auth-screen">
    <div class="auth-card-simple">
        <h2 class="auth-card-title">Recuperar acceso</h2>
        <p class="auth-card-subtitle">Introduce tu correo electrónico para recibir las instrucciones de restablecimiento.</p>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="login-alerta login-alerta-exito">✅ @mensajeExito</div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="login-alerta">⚠️ @mensajeError</div>
            }

            <label class="form-label">CORREO ELECTRÓNICO</label>
            <div class="login-input-wrap @(error ? "input-error" : "")">
                <span class="login-input-icon">✉️</span>
                <input type="text" @bind="email" @bind:event="oninput" placeholder="nombre@gmail.com" />
            </div>

            <button class="login-btn-submit" disabled="@procesando" @onclick="EnviarInstrucciones">
                Enviar instrucciones de recuperación
            </button>
        }
    </div>

    <div class="auth-below-card">
        <a href="login" class="auth-back-link">← Volver al inicio de sesión</a>
        <hr class="auth-footer-divisor" />
        <div class="auth-footer">
            <span>¿Necesitas ayuda?</span>
            <a href="#" class="auth-footer-link">Soporte Técnico</a>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private bool error = false;
    private bool procesando = false;
    private string mensajeError = "";
    private string mensajeExito = "";

    // DS CU19: "Selecciona botón Enviar instrucciones()"
    private async Task EnviarInstrucciones()
    {
        if (procesando) return;

        procesando = true;
        error = false;
        mensajeError = "";

        try
        {
            if (!ValidarFormatoEmail(email))
                return;

            // Se muestra siempre el mismo mensaje para no revelar qué emails están registrados.
            var mensajeInstrucciones = $"Las instrucciones fueron enviadas a {email.Trim()}. Revise su bandeja de entrada.";

            var usuario = await UsuarioBLL.ObtenerUsuario(email);

            // [Usuario no existe o está inactivo]
            if (usuario is null ||
                !string.Equals(usuario.Estado, EstadoUsuario.Activo, StringComparison.OrdinalIgnoreCase))
            {
                mensajeExito = mensajeInstrucciones;
                return;
            }

            try
            {
                var tokenId = await TokenBLL.GenerarTokenRecuperacion(email);
                var tokenLink = TokenBLL.ConstruirTokenLink(tokenId, Navigation.BaseUri);
                await Envio.EnviarCorreoRecuperacion(email.Trim(), tokenLink);
            }
            catch (Exception ex)
            {
                // No se le cuenta al usuario (revelaría que la cuenta existe); queda en el log.
                Logger.LogError(ex, "Falló el envío del correo de recuperación.");
            }

            mensajeExito = mensajeInstrucciones;
        }
        catch (Exception)
        {
            mensajeError = "Ocurrió un error inesperado. Intentá nuevamente en unos minutos.";
        }
        finally
        {
            procesando = false;
        }
    }

    // DS: ValidarFormatoEmail(email): bool
    private bool ValidarFormatoEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            error = true;
            mensajeError = "Ingresá tu correo electrónico.";
            return false;
        }

        if (!Regex.IsMatch(email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
        {
            error = true;
            mensajeError = "El formato del correo electrónico no es válido.";
            return false;
        }

        return true;
    }
}
