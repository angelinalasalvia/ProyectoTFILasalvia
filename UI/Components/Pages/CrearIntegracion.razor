@page "/integraciones/nueva"
@page "/integraciones/editar/{IntegracionId}"
@inject NavigationManager Navigation
@using BE
@inject BLL.BLLIntegracion BLLIntegracion

<PageTitle>@(EsEdicion ? "Editar Integración" : "Nueva Integración")</PageTitle>

<div class="page-header">
    <div></div>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

<div class="breadcrumb">CONFIGURACIÓN <span class="breadcrumb-sep">›</span> @(EsEdicion ? "EDITAR FUENTE" : "NUEVA FUENTE")</div>

<div class="retencion-header-row">
    <div>
        <h1 class="detalle-title">@(EsEdicion ? $"Editar Integración: {nombreFuente}" : "Configurar Nueva Integración")</h1>
        <p class="camp-subtitle">@(EsEdicion ? "Actualizá las credenciales y el mapeo de datos de esta fuente." : "Conectá una nueva fuente de datos siguiendo estos tres pasos.")</p>
    </div>
    <div class="retencion-actions">
        <button class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
        <button class="btn-confirmar" disabled="@(!conexionProbada)" @onclick="Guardar">
            💾 @(EsEdicion ? "Guardar Cambios" : "Guardar e integrar")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeConfirmacion))
{
    <div class="camp-form-confirmacion regla-confirmacion">✔ @mensajeConfirmacion</div>
}
@if (!string.IsNullOrEmpty(errorConexion))
{
    <div class="integ-error-conexion">⚠️ @errorConexion</div>
}

<!-- Stepper -->
<div class="integ-stepper">
    <div class="integ-step">
        <span class="integ-step-num integ-step-done">✓</span>
        <span class="integ-step-label">Tipo de Fuente</span>
    </div>
    <div class="integ-step-line"></div>
    <div class="integ-step">
        <span class="integ-step-num @(camposCredencialesCompletos ? "integ-step-done" : "integ-step-actual")">
            @(camposCredencialesCompletos ? "✓" : "2")
        </span>
        <span class="integ-step-label">Credenciales</span>
    </div>
    <div class="integ-step-line"></div>
    <div class="integ-step">
        <span class="integ-step-num @(conexionProbada ? "integ-step-actual" : "")">3</span>
        <span class="integ-step-label">Mapeo de Datos</span>
    </div>
</div>

<!-- Paso 1: Tipo de fuente -->
<div class="card regla-card">
    <p class="integ-paso-titulo">Paso 1: Seleccione el tipo de integración</p>
    <div class="integ-tipo-row">
        @foreach (var t in tiposDisponibles)
        {
            <div class="integ-tipo-card @(tipoSeleccionado == t.Nombre ? "integ-tipo-card-activa" : "") @(EsEdicion ? "integ-tipo-card-readonly" : "")"
                 @onclick="() => SeleccionarTipo(t.Nombre)">
                @if (tipoSeleccionado == t.Nombre)
                {
                    <span class="integ-tipo-check">✓</span>
                }
                <div class="integ-tipo-icon">@t.Icono</div>
                <div class="integ-tipo-nombre">@t.Nombre</div>
                <div class="integ-tipo-sub">@t.Descripcion</div>
            </div>
        }
    </div>
    @if (EsEdicion)
    {
        <p class="integ-tipo-nota">El tipo de fuente no puede modificarse una vez creada la integración.</p>
    }
</div>

<div class="integ-main-row">
    <!-- Paso 2: Credenciales -->
    <div class="card regla-card">
        <p class="integ-paso-titulo">Paso 2: Credenciales de conexión</p>

        <label class="form-label">NOMBRE DE LA INTEGRACIÓN</label>
        <input class="integ-input @(errores.Contains("nombre") ? "input-error" : "")"
               @bind="nombreFuente" @bind:event="oninput" placeholder="Ej: API de socios" />

        <label class="form-label">@EtiquetaUrl</label>
        <input class="integ-input @(errores.Contains("url") ? "input-error" : "")"
               @bind="urlServidor" @bind:event="oninput" @bind:after="InvalidarConexion"
               placeholder="@PlaceholderUrl" />

        <div class="integ-cred-row-2">
            @if (NecesitaUsuario)
            {
                <div>
                    <label class="form-label">@EtiquetaUsuario</label>
                    <input class="integ-input @(errores.Contains("usuario") ? "input-error" : "")"
                           @bind="usuario" @bind:event="oninput" @bind:after="InvalidarConexion" />
                </div>
            }
            <div>
                <label class="form-label">@EtiquetaSecreto</label>
                <input type="password" class="integ-input @(errores.Contains("apiKey") ? "input-error" : "")"
                       @bind="apiKey" @bind:event="oninput" @bind:after="InvalidarConexion" placeholder="••••••••••" />
            </div>
        </div>

        @if (tipoSeleccionado == Integracion.TipoBD)
        {
            <label class="form-label">NOMBRE DE LA BASE DE DATOS</label>
            <input class="integ-input @(errores.Contains("dbName") ? "input-error" : "")"
                   @bind="nombreBaseDatos" @bind:event="oninput" @bind:after="InvalidarConexion" />
        }

        <button class="integ-btn-probar" disabled="@(!camposCredencialesCompletos || probandoConexion)" @onclick="ProbarConexion">
            @(probandoConexion ? "Probando…" : "🔌 Probar conexión")
        </button>
        @if (!camposCredencialesCompletos)
        {
            <span class="camp-form-error">Hay campos obligatorios sin completar.</span>
        }
    </div>

    <!-- Paso 3: Mapeo de campos -->
    <div class="card regla-card">
        <p class="integ-paso-titulo">Paso 3: Mapeo de campos</p>

        @if (!conexionProbada)
        {
            <div class="integ-mapeo-vacio">
                🔌 Probá la conexión para ver los campos disponibles en la fuente de datos.
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMapeo))
            {
                <div class="integ-error-conexion">⚠️ @errorMapeo</div>
            }

            @if (esquema.Count == 0)
            {
                <div class="integ-mapeo-vacio">La fuente no devolvió campos para mapear.</div>
            }
            else
            {
                @foreach (var plat in BLL.BLLIntegracion.CamposPlataforma)
                {
                    var seleccionado = mapeo.GetValueOrDefault(plat.Key, "");
                    <div class="integ-mapeo-row">
                        <select class="integ-mapeo-select" @onchange="e => OnMapeoCambia(e, plat.Key)">
                            <option value="" selected="@(seleccionado == "")">— Sin mapear —</option>
                            @foreach (var campo in esquema)
                            {
                                <option value="@campo.Key" selected="@(campo.Key == seleccionado)">@campo.Key (@campo.Value)</option>
                            }
                        </select>
                        <span class="integ-mapeo-flecha">→</span>
                        <div class="integ-mapeo-externo">@plat.Key <small>(@plat.Value)</small></div>
                    </div>
                }

                <div class="integ-mapeo-info">
                    ℹ️ Elegí, para cada dato de la plataforma, qué campo de la fuente lo alimenta.
                    Los campos de texto aceptan cualquier tipo; Fecha y Número solo aceptan campos del mismo tipo.
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public string? IntegracionId { get; set; }

    private bool EsEdicion => !string.IsNullOrWhiteSpace(IntegracionId);
    private int IdEdicion => int.TryParse(IntegracionId, out var id) ? id : 0;

    private string nombreFuente = "";
    private string tipoSeleccionado = Integracion.TipoBD;
    private string urlServidor = "";
    private string usuario = "";
    private string apiKey = "";
    private string nombreBaseDatos = "";
    private bool conexionProbada;
    private bool probandoConexion;
    private string mensajeConfirmacion = "";
    private string errorConexion = "";
    private string errorMapeo = "";
    private HashSet<string> errores = new();

    private Dictionary<string, string> esquema = new();   // campo de la fuente -> tipo
    private Dictionary<string, string> mapeo = new();     // campo de la plataforma -> campo de la fuente

    private record TipoFuente(string Nombre, string Icono, string Descripcion);

    private List<TipoFuente> tiposDisponibles = new()
    {
        new(Integracion.TipoCRM, "🔗", "Salesforce (OAuth 2.0, client credentials)."),
        new(Integracion.TipoBD, "🗄️", "SQL Server (usuario y contraseña)."),
        new(Integracion.TipoAPI, "🧩", "Endpoint REST que responde JSON."),
    };

    private bool NecesitaUsuario => tipoSeleccionado != Integracion.TipoAPI;

    private string EtiquetaUrl => tipoSeleccionado switch
    {
        Integracion.TipoBD => "SERVIDOR",
        Integracion.TipoCRM => "URL DE LA ORGANIZACIÓN",
        _ => "ENDPOINT DE LA API"
    };

    private string PlaceholderUrl => tipoSeleccionado switch
    {
        Integracion.TipoBD => "servidor\\instancia  o  host,1433",
        Integracion.TipoCRM => "https://miempresa.my.salesforce.com",
        _ => "https://api.miempresa.com/socios"
    };

    private string EtiquetaUsuario => tipoSeleccionado == Integracion.TipoCRM ? "CLIENT ID" : "USUARIO";

    private string EtiquetaSecreto => tipoSeleccionado switch
    {
        Integracion.TipoBD => "CONTRASEÑA",
        Integracion.TipoCRM => "CLIENT SECRET",
        _ => "API KEY"
    };

    private List<string> CamposFaltantes()
    {
        var faltan = new List<string>();
        if (string.IsNullOrWhiteSpace(nombreFuente)) faltan.Add("nombre");
        if (string.IsNullOrWhiteSpace(urlServidor)) faltan.Add("url");
        if (NecesitaUsuario && string.IsNullOrWhiteSpace(usuario)) faltan.Add("usuario");
        if (string.IsNullOrWhiteSpace(apiKey)) faltan.Add("apiKey");
        if (tipoSeleccionado == Integracion.TipoBD && string.IsNullOrWhiteSpace(nombreBaseDatos)) faltan.Add("dbName");
        return faltan;
    }

    // Habilita "Probar conexión" (CU15 paso 6 / CU16 paso 7).
    private bool camposCredencialesCompletos => CamposFaltantes().Count == 0;

    // Diagramas CU15/CU16: RevisarCampos()
    private bool RevisarCampos()
    {
        errores = CamposFaltantes().ToHashSet();
        return errores.Count == 0;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!EsEdicion) return;

        var integracion = await BLLIntegracion.ObtenerIntegracion(IdEdicion);
        if (integracion is null)
        {
            Navigation.NavigateTo("/integraciones");
            return;
        }
        MostrarDatosConfigurados(integracion);
    }

    // CU16 pasos 3-4. El secreto llega enmascarado y solo se reemplaza si el administrador lo modifica.
    private void MostrarDatosConfigurados(Integracion i)
    {
        nombreFuente = i.Nombre;
        tipoSeleccionado = i.Tipo;
        urlServidor = i.Url ?? "";
        usuario = i.Usuario ?? "";
        apiKey = i.Secreto ?? "";
        nombreBaseDatos = i.BaseDatos ?? "";
    }

    private void SeleccionarTipo(string tipo)
    {
        if (EsEdicion) return;   // CU16: el tipo no se puede modificar
        tipoSeleccionado = tipo;
        InvalidarConexion();
    }

    // Cualquier cambio en las credenciales obliga a volver a probar la conexión.
    private void InvalidarConexion()
    {
        conexionProbada = false;
        esquema = new();
        mapeo = new();
        errorConexion = "";
        errorMapeo = "";
        mensajeConfirmacion = "";
    }

    private CredencialesIntegracion ConstruirCredenciales(string url, string usuarioId, string clave, string baseDatos) => new()
    {
        Nombre = nombreFuente.Trim(),
        Url = url.Trim(),
        Usuario = usuarioId.Trim(),
        Secreto = clave,
        BaseDatos = string.IsNullOrWhiteSpace(baseDatos) ? null : baseDatos.Trim()
    };

    // Diagramas CU15/CU16: TestearConexion(url, usuarioId, apiKey, baseDatos): bool
    private async Task<bool> TestearConexion(string url, string usuarioId, string clave, string baseDatos)
    {
        var resultado = await BLLIntegracion.ProbarConexion(
            tipoSeleccionado,
            ConstruirCredenciales(url, usuarioId, clave, baseDatos).Serializar(),
            EsEdicion ? IdEdicion : null);

        errorConexion = resultado.Exito ? "" : resultado.Mensaje;
        return resultado.Exito;
    }

    // Botón "Probar conexión"
    private async Task ProbarConexion()
    {
        if (!RevisarCampos()) return;

        probandoConexion = true;
        errorConexion = "";
        errorMapeo = "";
        mensajeConfirmacion = "";
        try
        {
            if (!await TestearConexion(urlServidor, usuario, apiKey, nombreBaseDatos))
            {
                conexionProbada = false;
                errorConexion = "Error de conexión: " + errorConexion;
                return;
            }

            ConfirmarConexionExitosa();
            await CargarCamposParaMapeo();
        }
        finally
        {
            probandoConexion = false;
        }
    }

    private void ConfirmarConexionExitosa()
    {
        conexionProbada = true;
        mensajeConfirmacion = "Conexión exitosa.";
    }

    // CU15: ObtenerEsquemaCampos + MostrarCamposParaMapeo. CU16: además ObtenerMapeoActual + MostrarMapeoActual.
    private async Task CargarCamposParaMapeo()
    {
        try
        {
            var campos = await BLLIntegracion.ObtenerEsquemaCampos(
                tipoSeleccionado,
                ConstruirCredenciales(urlServidor, usuario, apiKey, nombreBaseDatos).Serializar(),
                EsEdicion ? IdEdicion : null);

            esquema = campos
                .Select(c => c.Split('|'))
                .ToDictionary(p => p[0], p => p.Length > 1 ? p[1] : "otro");
            mapeo = new();

            if (EsEdicion)
            {
                foreach (var par in await BLLIntegracion.ObtenerMapeoActual(IdEdicion))
                {
                    var p = par.Split('=');
                    if (p.Length == 2 && esquema.ContainsKey(p[0]) && BLL.BLLIntegracion.CamposPlataforma.ContainsKey(p[1]))
                        mapeo[p[1]] = p[0];
                }
            }
        }
        catch (Exception ex)
        {
            conexionProbada = false;
            mensajeConfirmacion = "";
            errorConexion = "No se pudieron leer los campos de la fuente: " + ex.Message;
        }
    }

    private void OnMapeoCambia(ChangeEventArgs e, string campoPlataforma)
    {
        var campoExterno = e.Value?.ToString() ?? "";
        if (EsEdicion) ModificarMapeo(campoExterno, campoPlataforma);
        else MapearCampos(campoExterno, campoPlataforma);
    }

    // Diagrama CU15
    private void MapearCampos(string campoExterno, string campoPlataforma)
    {
        errorMapeo = "";
        mapeo[campoPlataforma] = campoExterno;
    }

    // Diagrama CU16
    private void ModificarMapeo(string campoExterno, string campoPlataforma) =>
        MapearCampos(campoExterno, campoPlataforma);

    // "campoExterno=campoPlataforma;campoExterno=campoPlataforma" (el formato que espera la BLL)
    private string SerializarMapeo() =>
        string.Join(";", mapeo.Where(m => !string.IsNullOrEmpty(m.Value)).Select(m => $"{m.Value}={m.Key}"));

    // Diagramas CU15/CU16: ValidarConsistenciaMapeo(mapeo): bool
    private bool ValidarConsistenciaMapeo(string mapeoSerializado)
    {
        foreach (var par in mapeoSerializado.Split(';', StringSplitOptions.RemoveEmptyEntries))
        {
            var partes = par.Split('=');
            var tipoExterno = esquema.GetValueOrDefault(partes[0], "otro");
            var tipoPlataforma = BLL.BLLIntegracion.CamposPlataforma[partes[1]];

            // Un campo de texto de la plataforma acepta cualquier tipo; fecha y número exigen el mismo tipo.
            if (tipoPlataforma != "texto" && tipoExterno != tipoPlataforma) return false;
        }
        return true;
    }

    // Botón "Guardar e integrar" / "Guardar cambios"
    private async Task Guardar()
    {
        if (!RevisarCampos() || !conexionProbada) return;

        var mapeoTexto = SerializarMapeo();
        if (mapeoTexto.Length == 0)
        {
            errorMapeo = "Asociá al menos un campo de la fuente con un campo de la plataforma.";
            return;
        }
        if (!ValidarConsistenciaMapeo(mapeoTexto))
        {
            errorMapeo = "Campos con tipos de datos inconsistentes.";
            return;
        }

        try
        {
            var credenciales = ConstruirCredenciales(urlServidor, usuario, apiKey, nombreBaseDatos).Serializar();

            if (EsEdicion)
                await BLLIntegracion.ActualizarConfiguracion(IdEdicion, credenciales, mapeoTexto, Integracion.EstadoActiva);
            else
                await BLLIntegracion.RegistrarNuevaIntegracion(tipoSeleccionado, credenciales, mapeoTexto, Integracion.EstadoActiva);
        }
        catch (Exception ex)
        {
            errorConexion = "No se pudo guardar la integración: " + ex.Message;
            return;
        }

        mensajeConfirmacion = EsEdicion
            ? "Integración actualizada exitosamente."
            : "Integración creada exitosamente con estado Conexión Activa.";

        StateHasChanged();
        _ = RedirigirConDelay();
    }

    private async Task RedirigirConDelay()
    {
        await Task.Delay(1200);
        Navigation.NavigateTo("/integraciones");
    }

    private void Cancelar() => Navigation.NavigateTo("/integraciones");
}
