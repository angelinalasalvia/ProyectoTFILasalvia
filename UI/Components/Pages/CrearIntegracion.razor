@page "/integraciones/nueva"
@page "/integraciones/editar/{IntegracionId}"
@using BE
@inject NavigationManager Navigation
@inject BLL.BLLIntegracion BLLIntegracion

<PageTitle>@(EsEdicion ? "Editar Integración" : "Nueva Integración")</PageTitle>

<div class="page-header">
    <div></div>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

<div class="breadcrumb">CONFIGURACIÓN <span class="breadcrumb-sep">›</span> @(EsEdicion ? "EDITAR FUENTE" : "NUEVA FUENTE")</div>

<div class="retencion-header-row">
    <div>
        <h1 class="detalle-title">@(EsEdicion ? $"Editar Integración: {nombreFuente}" : "Configurar Nueva Integración")</h1>
        <p class="camp-subtitle">@(EsEdicion ? "Actualizá las credenciales y el mapeo de datos de esta fuente." : "Conectá una nueva fuente de datos siguiendo estos tres pasos.")</p>
    </div>
    <div class="retencion-actions">
        <button class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
        <button class="btn-confirmar" disabled="@(!conexionProbada)" @onclick="Guardar">
            💾 @(EsEdicion ? "Guardar Cambios" : "Guardar e integrar")
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeConfirmacion))
{
    <div class="camp-form-confirmacion regla-confirmacion">✔ @mensajeConfirmacion</div>
}
@if (!string.IsNullOrEmpty(errorConexion))
{
    <div class="integ-error-conexion">⚠️ @errorConexion</div>
}

<!-- Stepper -->
<div class="integ-stepper">
    <div class="integ-step">
        <span class="integ-step-num integ-step-done">✓</span>
        <span class="integ-step-label">Tipo de Fuente</span>
    </div>
    <div class="integ-step-line"></div>
    <div class="integ-step">
        <span class="integ-step-num @(camposCredencialesCompletos ? "integ-step-done" : "integ-step-actual")">
            @(camposCredencialesCompletos ? "✓" : "2")
        </span>
        <span class="integ-step-label">Credenciales</span>
    </div>
    <div class="integ-step-line"></div>
    <div class="integ-step">
        <span class="integ-step-num @(conexionProbada ? "integ-step-actual" : "")">3</span>
        <span class="integ-step-label">Mapeo de Datos</span>
    </div>
</div>

<!-- Paso 1: Tipo de fuente -->
<div class="card regla-card">
    <p class="integ-paso-titulo">Paso 1: Seleccione el tipo de integración</p>
    <div class="integ-tipo-row">
        @foreach (var t in tiposDisponibles)
        {
            <div class="integ-tipo-card @(tipoSeleccionado == t.Nombre ? "integ-tipo-card-activa" : "") @(EsEdicion ? "integ-tipo-card-readonly" : "")"
                 @onclick="() => SeleccionarTipo(t.Nombre)">
                @if (tipoSeleccionado == t.Nombre)
                {
                    <span class="integ-tipo-check">✓</span>
                }
                <div class="integ-tipo-icon">@t.Icono</div>
                <div class="integ-tipo-nombre">@t.Nombre</div>
                <div class="integ-tipo-sub">@t.Descripcion</div>
            </div>
        }
    </div>
    @if (EsEdicion)
    {
        <p class="integ-tipo-nota">El tipo de fuente no puede modificarse una vez creada la integración.</p>
    }
</div>

<!-- Paso 2: Credenciales -->
<div class="card regla-card">
    <p class="integ-paso-titulo">Paso 2: Credenciales de conexión</p>

    <label class="form-label">NOMBRE DE LA INTEGRACIÓN</label>
    <input class="integ-input @(errores.Contains("nombre") ? "input-error" : "")"
           @bind="nombreFuente" @bind:event="oninput" placeholder="Ej: API de socios" />

    <label class="form-label">@EtiquetaUrl</label>
    <input class="integ-input @(errores.Contains("url") ? "input-error" : "")"
           @bind="urlServidor" @bind:event="oninput" @bind:after="InvalidarConexion"
           placeholder="@PlaceholderUrl" />

    @if (EsApi)
    {
        <label class="form-label">ENDPOINT DE EVENTOS</label>
        <input class="integ-input @(errores.Contains("urlEventos") ? "input-error" : "")"
               @bind="urlEventos" @bind:event="oninput" @bind:after="InvalidarConexion"
               placeholder="https://api.miempresa.com/eventos" />
    }

    <div class="integ-cred-row-2">
        @if (NecesitaUsuario)
        {
            <div>
                <label class="form-label">@EtiquetaUsuario</label>
                <input class="integ-input @(errores.Contains("usuario") ? "input-error" : "")"
                       @bind="usuario" @bind:event="oninput" @bind:after="InvalidarConexion" />
            </div>
        }
        <div>
            <label class="form-label">@EtiquetaSecreto</label>
            <input type="password" class="integ-input @(errores.Contains("apiKey") ? "input-error" : "")"
                   @bind="apiKey" @bind:event="oninput" @bind:after="InvalidarConexion" placeholder="••••••••••" />
        </div>
    </div>

    @if (tipoSeleccionado == Integracion.TipoBD)
    {
        <label class="form-label">NOMBRE DE LA BASE DE DATOS</label>
        <input class="integ-input @(errores.Contains("dbName") ? "input-error" : "")"
               @bind="nombreBaseDatos" @bind:event="oninput" @bind:after="InvalidarConexion" />
    }

    <button class="integ-btn-probar" disabled="@(!camposCredencialesCompletos || probandoConexion)" @onclick="ProbarConexion">
        @(probandoConexion ? "Probando…" : "🔌 Probar conexión")
    </button>
    @if (!camposCredencialesCompletos)
    {
        <span class="camp-form-error">Hay campos obligatorios sin completar.</span>
    }
</div>

<!-- Paso 3: Mapeo de datos -->
<div class="card regla-card">
    <p class="integ-paso-titulo">Paso 3: Mapeo de datos</p>

    @if (!conexionProbada)
    {
        <div class="integ-mapeo-vacio">
            🔌 Probá la conexión para ver los datos disponibles en la fuente.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMapeo))
        {
            <div class="integ-error-conexion">⚠️ @errorMapeo</div>
        }

        @if (esquema.Count == 0)
        {
            <div class="integ-mapeo-vacio">La fuente no devolvió campos para mapear.</div>
        }
        else
        {
            <!-- ---------------- Clientes ---------------- -->
            <p class="integ-mapeo-seccion">1. Clientes</p>

            <label class="form-label">@EtiquetaOrigen DE LOS CLIENTES</label>
            <select class="campana-select" @onchange="OnOrigenClientesCambia">
                <option value="" selected="@(mapeo.OrigenClientes == "")">— Elegir —</option>
                @foreach (var o in origenes)
                {
                    <option value="@o" selected="@(o == mapeo.OrigenClientes)">@o</option>
                }
            </select>

            @if (mapeo.OrigenClientes != "")
            {
                <label class="form-label">IDENTIFICAR AL CLIENTE POR</label>
                <select class="campana-select" @onchange="OnClaveCambia">
                    <option value="@DefinicionMapeo.ClaveEmail" selected="@(mapeo.ClaveCliente == DefinicionMapeo.ClaveEmail)">Email</option>
                    <option value="@DefinicionMapeo.ClaveIdExterno" selected="@(mapeo.ClaveCliente == DefinicionMapeo.ClaveIdExterno)">ID del cliente en la fuente</option>
                </select>

                <div class="integ-mapeo-grupo">
                    @foreach (var campo in DefinicionMapeo.CamposCliente)
                    {
                        var clave = $"{DefinicionMapeo.EntidadCliente}.{campo.Nombre}";
                        var asignado = mapeo.Clientes.GetValueOrDefault(campo.Nombre, "");
                        <div class="integ-mapeo-row">
                            <select class="integ-mapeo-select" @onchange="e => OnMapeoCambia(e, clave)">
                                <option value="" selected="@(asignado == "")">— Sin mapear —</option>
                                @foreach (var f in CamposDe(mapeo.OrigenClientes))
                                {
                                    <option value="@f" selected="@(f == asignado)">@MapeoIntegracion.Campo(f) (@esquema[f])</option>
                                }
                            </select>
                            <span class="integ-mapeo-flecha">→</span>
                            <div class="integ-mapeo-externo">@campo.Nombre@(campo.Obligatorio ? " *" : "") <small>(@campo.Tipo)</small></div>
                        </div>
                    }
                </div>

                @if (valoresEstadoFuente.Count > 0)
                {
                    <p class="integ-mapeo-subtitulo">Traducí cada valor del campo Estado</p>
                    <div class="integ-mapeo-grupo">
                        @foreach (var valor in valoresEstadoFuente)
                        {
                            <div class="integ-mapeo-row">
                                <div class="integ-mapeo-externo">@valor</div>
                                <span class="integ-mapeo-flecha">→</span>
                                <select class="integ-mapeo-select" @onchange="e => OnValorEstadoCambia(e, valor)">
                                    <option value="" selected="@(!mapeo.ValoresEstado.ContainsKey(valor))">— Elegir —</option>
                                    @foreach (var estado in DefinicionMapeo.EstadosCliente)
                                    {
                                        <option value="@estado" selected="@(mapeo.ValoresEstado.GetValueOrDefault(valor) == estado)">@estado</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                }
            }

            <!-- ---------------- Eventos ---------------- -->
            <p class="integ-mapeo-seccion">2. Eventos de los clientes</p>

            <label class="form-label">@EtiquetaOrigen DE LOS EVENTOS</label>
            <select class="campana-select" @onchange="OnOrigenEventosCambia">
                <option value="" selected="@(mapeo.OrigenEventos == "")">— Elegir —</option>
                @foreach (var o in origenes)
                {
                    <option value="@o" selected="@(o == mapeo.OrigenEventos)">@o</option>
                }
            </select>

            @if (mapeo.OrigenEventos != "")
            {
                <div class="integ-mapeo-grupo">
                    @foreach (var campo in DefinicionMapeo.CamposEvento)
                    {
                        var clave = $"{DefinicionMapeo.EntidadEvento}.{campo.Nombre}";
                        var asignado = mapeo.Eventos.GetValueOrDefault(campo.Nombre, "");
                        <div class="integ-mapeo-row">
                            <select class="integ-mapeo-select" @onchange="e => OnMapeoCambia(e, clave)">
                                <option value="" selected="@(asignado == "")">— Sin mapear —</option>
                                @foreach (var f in CamposDe(mapeo.OrigenEventos))
                                {
                                    <option value="@f" selected="@(f == asignado)">@MapeoIntegracion.Campo(f) (@esquema[f])</option>
                                }
                            </select>
                            <span class="integ-mapeo-flecha">→</span>
                            <div class="integ-mapeo-externo">@(campo.Nombre == "Cliente" ? "Cliente (según la clave elegida)" : campo.Nombre) * <small>(@campo.Tipo)</small></div>
                        </div>
                    }
                </div>

                @if (valoresEventoFuente.Count > 0)
                {
                    <p class="integ-mapeo-subtitulo">Traducí cada tipo de evento de la fuente a uno que entienda el modelo (los que dejes sin elegir se ignoran)</p>
                    <div class="integ-mapeo-grupo">
                        @foreach (var valor in valoresEventoFuente)
                        {
                            <div class="integ-mapeo-row">
                                <div class="integ-mapeo-externo">@valor</div>
                                <span class="integ-mapeo-flecha">→</span>
                                <select class="integ-mapeo-select" @onchange="e => OnValorEventoCambia(e, valor)">
                                    <option value="" selected="@(!mapeo.ValoresEvento.ContainsKey(valor))">— Ignorar —</option>
                                    @foreach (var tipoEvento in DefinicionMapeo.TiposEvento)
                                    {
                                        <option value="@tipoEvento" selected="@(mapeo.ValoresEvento.GetValueOrDefault(valor) == tipoEvento)">@tipoEvento</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                }
            }

            <div class="integ-mapeo-info">
                ℹ️ El modelo de predicción se alimenta de los clientes y de sus eventos (visitas, pagos, uso de la app...).
                Los campos con * son obligatorios. Los campos de texto aceptan cualquier tipo; Fecha solo acepta campos de fecha.
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string? IntegracionId { get; set; }

    private bool EsEdicion => !string.IsNullOrWhiteSpace(IntegracionId);
    private int IdEdicion => int.TryParse(IntegracionId, out var id) ? id : 0;

    private string nombreFuente = "";
    private string tipoSeleccionado = Integracion.TipoBD;
    private string urlServidor = "";
    private string urlEventos = "";
    private string usuario = "";
    private string apiKey = "";
    private string nombreBaseDatos = "";
    private bool conexionProbada;
    private bool probandoConexion;
    private string mensajeConfirmacion = "";
    private string errorConexion = "";
    private string errorMapeo = "";
    private HashSet<string> errores = new();

    // Esquema de la fuente: "Origen.Campo" -> tipo (texto | fecha | numero | otro).
    private Dictionary<string, string> esquema = new();
    private List<string> origenes = new();

    private MapeoIntegracion mapeo = new();
    private List<string> valoresEventoFuente = new();
    private List<string> valoresEstadoFuente = new();

    private record TipoFuente(string Nombre, string Icono, string Descripcion);

    private List<TipoFuente> tiposDisponibles = new()
    {
        new(Integracion.TipoCRM, "🔗", "Salesforce (OAuth 2.0, client credentials)."),
        new(Integracion.TipoBD, "🗄️", "SQL Server (usuario y contraseña)."),
        new(Integracion.TipoAPI, "🧩", "Dos endpoints REST que responden JSON: clientes y eventos."),
    };

    private bool EsApi => tipoSeleccionado == Integracion.TipoAPI;
    private bool NecesitaUsuario => tipoSeleccionado != Integracion.TipoAPI;

    private string EtiquetaUrl => tipoSeleccionado switch
    {
        Integracion.TipoBD => "SERVIDOR",
        Integracion.TipoCRM => "URL DE LA ORGANIZACIÓN",
        _ => "ENDPOINT DE CLIENTES"
    };

    private string PlaceholderUrl => tipoSeleccionado switch
    {
        Integracion.TipoBD => "servidor\\instancia  o  host,1433",
        Integracion.TipoCRM => "https://miempresa.my.salesforce.com",
        _ => "https://api.miempresa.com/clientes"
    };

    private string EtiquetaUsuario => tipoSeleccionado == Integracion.TipoCRM ? "CLIENT ID" : "USUARIO";

    private string EtiquetaSecreto => tipoSeleccionado switch
    {
        Integracion.TipoBD => "CONTRASEÑA",
        Integracion.TipoCRM => "CLIENT SECRET",
        _ => "API KEY"
    };

    private string EtiquetaOrigen => tipoSeleccionado switch
    {
        Integracion.TipoBD => "TABLA",
        Integracion.TipoCRM => "OBJETO",
        _ => "ENDPOINT"
    };

    private List<string> CamposFaltantes()
    {
        var faltan = new List<string>();
        if (string.IsNullOrWhiteSpace(nombreFuente)) faltan.Add("nombre");
        if (string.IsNullOrWhiteSpace(urlServidor)) faltan.Add("url");
        if (EsApi && string.IsNullOrWhiteSpace(urlEventos)) faltan.Add("urlEventos");
        if (NecesitaUsuario && string.IsNullOrWhiteSpace(usuario)) faltan.Add("usuario");
        if (string.IsNullOrWhiteSpace(apiKey)) faltan.Add("apiKey");
        if (tipoSeleccionado == Integracion.TipoBD && string.IsNullOrWhiteSpace(nombreBaseDatos)) faltan.Add("dbName");
        return faltan;
    }

    // Habilita "Probar conexión" (CU15 paso 6 / CU16 paso 7).
    private bool camposCredencialesCompletos => CamposFaltantes().Count == 0;

    // Diagramas CU15/CU16: RevisarCampos()
    private bool RevisarCampos()
    {
        errores = CamposFaltantes().ToHashSet();
        return errores.Count == 0;
    }

    private IEnumerable<string> CamposDe(string origen) =>
        esquema.Keys.Where(k => MapeoIntegracion.Origen(k) == origen);

    protected override async Task OnInitializedAsync()
    {
        if (!EsEdicion) return;

        var integracion = await BLLIntegracion.ObtenerIntegracion(IdEdicion);
        if (integracion is null)
        {
            Navigation.NavigateTo("/integraciones");
            return;
        }
        MostrarDatosConfigurados(integracion);
    }

    // CU16 pasos 3-4. El secreto llega enmascarado y solo se reemplaza si el administrador lo modifica.
    private void MostrarDatosConfigurados(Integracion i)
    {
        nombreFuente = i.Nombre;
        tipoSeleccionado = i.Tipo;
        urlServidor = i.Url ?? "";
        urlEventos = i.UrlEventos ?? "";
        usuario = i.Usuario ?? "";
        apiKey = i.Secreto ?? "";
        nombreBaseDatos = i.BaseDatos ?? "";
    }

    private void SeleccionarTipo(string tipo)
    {
        if (EsEdicion) return;   // CU16: el tipo no se puede modificar
        tipoSeleccionado = tipo;
        InvalidarConexion();
    }

    // Cualquier cambio en las credenciales obliga a volver a probar la conexión.
    private void InvalidarConexion()
    {
        conexionProbada = false;
        esquema = new();
        origenes = new();
        mapeo = new();
        valoresEventoFuente = new();
        valoresEstadoFuente = new();
        errorConexion = "";
        errorMapeo = "";
        mensajeConfirmacion = "";
    }

    private CredencialesIntegracion ConstruirCredenciales(string url, string usuarioId, string clave, string baseDatos) => new()
    {
        Nombre = nombreFuente.Trim(),
        Url = url.Trim(),
        UrlEventos = EsApi ? urlEventos.Trim() : null,
        Usuario = usuarioId.Trim(),
        Secreto = clave,
        BaseDatos = string.IsNullOrWhiteSpace(baseDatos) ? null : baseDatos.Trim()
    };

    private string CredencialesSerializadas() =>
        ConstruirCredenciales(urlServidor, usuario, apiKey, nombreBaseDatos).Serializar();

    // Diagramas CU15/CU16: TestearConexion(url, usuarioId, apiKey, baseDatos): bool
    private async Task<bool> TestearConexion(string url, string usuarioId, string clave, string baseDatos)
    {
        var resultado = await BLLIntegracion.ProbarConexion(
            tipoSeleccionado,
            ConstruirCredenciales(url, usuarioId, clave, baseDatos).Serializar(),
            EsEdicion ? IdEdicion : null);

        errorConexion = resultado.Exito ? "" : resultado.Mensaje;
        return resultado.Exito;
    }

    // Botón "Probar conexión"
    private async Task ProbarConexion()
    {
        if (!RevisarCampos()) return;

        probandoConexion = true;
        errorConexion = "";
        errorMapeo = "";
        mensajeConfirmacion = "";
        try
        {
            if (!await TestearConexion(urlServidor, usuario, apiKey, nombreBaseDatos))
            {
                conexionProbada = false;
                errorConexion = "Error de conexión: " + errorConexion;
                return;
            }

            ConfirmarConexionExitosa();
            await CargarCamposParaMapeo();
        }
        finally
        {
            probandoConexion = false;
        }
    }

    private void ConfirmarConexionExitosa()
    {
        conexionProbada = true;
        mensajeConfirmacion = "Conexión exitosa.";
    }

    // CU15: ObtenerEsquemaCampos + MostrarCamposParaMapeo. CU16: además ObtenerMapeoActual + MostrarMapeoActual.
    private async Task CargarCamposParaMapeo()
    {
        try
        {
            var campos = await BLLIntegracion.ObtenerEsquemaCampos(
                tipoSeleccionado, CredencialesSerializadas(), EsEdicion ? IdEdicion : null);

            esquema = new();
            foreach (var campo in campos)
            {
                var partes = campo.Split('|');
                esquema[partes[0]] = partes.Length > 1 ? partes[1] : "otro";
            }
            origenes = esquema.Keys.Select(MapeoIntegracion.Origen).Distinct().ToList();
            valoresEventoFuente = new();
            valoresEstadoFuente = new();

            if (EsEdicion)
            {
                mapeo = await BLLIntegracion.ObtenerMapeoActual(IdEdicion);
                DepurarMapeo();
                await CargarValoresEstado();
                await CargarValoresEvento();
            }
            else
            {
                mapeo = new MapeoIntegracion();
                await SugerirOrigenes();
            }
        }
        catch (Exception ex)
        {
            conexionProbada = false;
            mensajeConfirmacion = "";
            errorConexion = "No se pudieron leer los datos de la fuente: " + ex.Message;
        }
    }

    // Si la fuente cambió desde que se guardó el mapeo, se descartan las asignaciones que ya no existen.
    private void DepurarMapeo()
    {
        if (!origenes.Contains(mapeo.OrigenClientes)) { mapeo.OrigenClientes = ""; mapeo.Clientes = new(); }
        if (!origenes.Contains(mapeo.OrigenEventos)) { mapeo.OrigenEventos = ""; mapeo.Eventos = new(); }

        mapeo.Clientes = mapeo.Clientes.Where(m => esquema.ContainsKey(m.Value)).ToDictionary(m => m.Key, m => m.Value);
        mapeo.Eventos = mapeo.Eventos.Where(m => esquema.ContainsKey(m.Value)).ToDictionary(m => m.Key, m => m.Value);
    }

    // Propone el origen de clientes y el de eventos según el nombre (se puede cambiar).
    private async Task SugerirOrigenes()
    {
        var clientes = origenes.FirstOrDefault(o =>
            new[] { "cliente", "socio", "contact" }.Any(p => o.Contains(p, StringComparison.OrdinalIgnoreCase))
            && !o.Contains("evento", StringComparison.OrdinalIgnoreCase));

        var eventos = origenes.FirstOrDefault(o =>
            new[] { "evento", "actividad", "accion", "acción", "task" }.Any(p => o.Contains(p, StringComparison.OrdinalIgnoreCase)));

        if (clientes is not null) SeleccionarOrigenClientes(clientes);
        if (eventos is not null) SeleccionarOrigenEventos(eventos);

        await CargarValoresEstado();
        await CargarValoresEvento();
    }

    private async Task OnOrigenClientesCambia(ChangeEventArgs e)
    {
        SeleccionarOrigenClientes(e.Value?.ToString() ?? "");
        await CargarValoresEstado();
    }

    private async Task OnOrigenEventosCambia(ChangeEventArgs e)
    {
        SeleccionarOrigenEventos(e.Value?.ToString() ?? "");
        await CargarValoresEvento();
    }

    private void SeleccionarOrigenClientes(string origen)
    {
        errorMapeo = "";
        mapeo.OrigenClientes = origen;
        mapeo.Clientes = new();
        mapeo.ValoresEstado = new();
        valoresEstadoFuente = new();
        foreach (var campo in DefinicionMapeo.CamposCliente) AutoMapear(mapeo.Clientes, campo.Nombre, origen);
    }

    private void SeleccionarOrigenEventos(string origen)
    {
        errorMapeo = "";
        mapeo.OrigenEventos = origen;
        mapeo.Eventos = new();
        mapeo.ValoresEvento = new();
        valoresEventoFuente = new();
        foreach (var campo in DefinicionMapeo.CamposEvento) AutoMapear(mapeo.Eventos, campo.Nombre, origen);
    }

    // Si la fuente tiene un campo con el mismo nombre que el de la plataforma, se asigna solo.
    private void AutoMapear(Dictionary<string, string> destino, string nombrePlataforma, string origen)
    {
        var coincidencia = CamposDe(origen)
            .FirstOrDefault(k => MapeoIntegracion.Campo(k).Equals(nombrePlataforma, StringComparison.OrdinalIgnoreCase));
        if (coincidencia is not null) destino[nombrePlataforma] = coincidencia;
    }

    private void OnClaveCambia(ChangeEventArgs e)
    {
        errorMapeo = "";
        mapeo.ClaveCliente = e.Value?.ToString() ?? DefinicionMapeo.ClaveEmail;
    }

    // "campoPlataforma" llega calificado con la entidad: "Cliente.Nombre" / "Evento.Fecha".
    private async Task OnMapeoCambia(ChangeEventArgs e, string campoPlataforma)
    {
        var campoExterno = e.Value?.ToString() ?? "";
        if (EsEdicion) ModificarMapeo(campoExterno, campoPlataforma);
        else MapearCampos(campoExterno, campoPlataforma);

        // Al cambiar el campo del tipo de evento (o del estado) hay que volver a leer sus valores.
        if (campoPlataforma == $"{DefinicionMapeo.EntidadEvento}.Evento")
        {
            mapeo.ValoresEvento = new();
            await CargarValoresEvento();
        }
        else if (campoPlataforma == $"{DefinicionMapeo.EntidadCliente}.Estado")
        {
            mapeo.ValoresEstado = new();
            await CargarValoresEstado();
        }
    }

    // Diagrama CU15
    private void MapearCampos(string campoExterno, string campoPlataforma)
    {
        errorMapeo = "";
        var destino = MapeoIntegracion.Origen(campoPlataforma) == DefinicionMapeo.EntidadEvento ? mapeo.Eventos : mapeo.Clientes;
        var campo = MapeoIntegracion.Campo(campoPlataforma);

        if (string.IsNullOrEmpty(campoExterno)) destino.Remove(campo);
        else destino[campo] = campoExterno;
    }

    // Diagrama CU16
    private void ModificarMapeo(string campoExterno, string campoPlataforma) =>
        MapearCampos(campoExterno, campoPlataforma);

    private void OnValorEventoCambia(ChangeEventArgs e, string valor)
    {
        errorMapeo = "";
        var tipoEvento = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(tipoEvento)) mapeo.ValoresEvento.Remove(valor);
        else mapeo.ValoresEvento[valor] = tipoEvento;
    }

    private void OnValorEstadoCambia(ChangeEventArgs e, string valor)
    {
        errorMapeo = "";
        var estado = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(estado)) mapeo.ValoresEstado.Remove(valor);
        else mapeo.ValoresEstado[valor] = estado;
    }

    private async Task CargarValoresEvento()
    {
        mapeo.Eventos.TryGetValue("Evento", out var campoExterno);
        valoresEventoFuente = await ObtenerValores(campoExterno, mapeo.ValoresEvento.Keys);

        // Si el valor de la fuente se llama igual que un tipo del modelo, se asigna solo.
        foreach (var valor in valoresEventoFuente.Where(v => !mapeo.ValoresEvento.ContainsKey(v)))
        {
            var coincidencia = DefinicionMapeo.TiposEvento.FirstOrDefault(t => t.Equals(valor, StringComparison.OrdinalIgnoreCase));
            if (coincidencia is not null) mapeo.ValoresEvento[valor] = coincidencia;
        }
    }

    private async Task CargarValoresEstado()
    {
        mapeo.Clientes.TryGetValue("Estado", out var campoExterno);
        valoresEstadoFuente = await ObtenerValores(campoExterno, mapeo.ValoresEstado.Keys);

        foreach (var valor in valoresEstadoFuente.Where(v => !mapeo.ValoresEstado.ContainsKey(v)))
        {
            var v = valor.Trim().ToLowerInvariant();
            if (v is "socio activo" or "activo" or "active") mapeo.ValoresEstado[valor] = "Socio Activo";
            else if (v is "inactivo" or "baja" or "inactive") mapeo.ValoresEstado[valor] = "Inactivo";
        }
    }

    private async Task<List<string>> ObtenerValores(string? campoExterno, IEnumerable<string> yaAsignados)
    {
        if (string.IsNullOrEmpty(campoExterno)) return new List<string>();
        try
        {
            var valores = await BLLIntegracion.ObtenerValoresDistintos(
                tipoSeleccionado, CredencialesSerializadas(), campoExterno, EsEdicion ? IdEdicion : null);
            return valores.Union(yaAsignados).OrderBy(v => v).ToList();
        }
        catch (Exception ex)
        {
            errorMapeo = "No se pudieron leer los valores del campo: " + ex.Message;
            return new List<string>();
        }
    }

    // Diagramas CU15/CU16: ValidarConsistenciaMapeo(mapeo): bool. Deja el motivo en errorMapeo.
    private bool ValidarConsistenciaMapeo(string mapeoSerializado)
    {
        var m = MapeoIntegracion.Deserializar(mapeoSerializado);

        var faltantes = DefinicionMapeo.CamposCliente
            .Where(c => c.Obligatorio && !m.Clientes.ContainsKey(c.Nombre)).Select(c => $"Cliente: {c.Nombre}")
            .Concat(DefinicionMapeo.CamposEvento
                .Where(c => c.Obligatorio && !m.Eventos.ContainsKey(c.Nombre)).Select(c => $"Evento: {c.Nombre}"))
            .ToList();
        if (m.ClaveCliente == DefinicionMapeo.ClaveIdExterno && !m.Clientes.ContainsKey("IdExterno"))
            faltantes.Add("Cliente: IdExterno (es la clave elegida)");

        if (faltantes.Count > 0)
        {
            errorMapeo = "Faltan campos obligatorios en el mapeo: " + string.Join(", ", faltantes) + ".";
            return false;
        }

        // Un campo de texto de la plataforma acepta cualquier tipo; los demás exigen el mismo tipo.
        foreach (var (campos, asignados) in new[] { (DefinicionMapeo.CamposCliente, m.Clientes), (DefinicionMapeo.CamposEvento, m.Eventos) })
        {
            foreach (var campo in campos)
            {
                if (asignados.TryGetValue(campo.Nombre, out var externo)
                    && campo.Tipo != "texto"
                    && esquema.GetValueOrDefault(externo, "otro") != campo.Tipo)
                {
                    errorMapeo = "Campos con tipos de datos inconsistentes.";
                    return false;
                }
            }
        }

        if (!m.ValoresEvento.Values.Any(v => !string.IsNullOrEmpty(v)))
        {
            errorMapeo = "Asigná al menos un tipo de evento de la fuente a un tipo del modelo.";
            return false;
        }

        if (m.Clientes.ContainsKey("Estado") && valoresEstadoFuente.Any(v => !m.ValoresEstado.ContainsKey(v)))
        {
            errorMapeo = "Asigná un estado a cada valor del campo Estado.";
            return false;
        }

        return true;
    }

    // Botón "Guardar e integrar" / "Guardar cambios"
    private async Task Guardar()
    {
        if (!RevisarCampos() || !conexionProbada) return;

        var mapeoTexto = mapeo.Serializar();
        if (!ValidarConsistenciaMapeo(mapeoTexto)) return;

        try
        {
            var credenciales = CredencialesSerializadas();

            if (EsEdicion)
                await BLLIntegracion.ActualizarConfiguracion(IdEdicion, credenciales, mapeoTexto, Integracion.EstadoActiva);
            else
                await BLLIntegracion.RegistrarNuevaIntegracion(tipoSeleccionado, credenciales, mapeoTexto, Integracion.EstadoActiva);
        }
        catch (Exception ex)
        {
            errorConexion = "No se pudo guardar la integración: " + ex.Message;
            return;
        }

        mensajeConfirmacion = EsEdicion
            ? "Integración actualizada exitosamente."
            : "Integración creada exitosamente con estado Conexión Activa.";

        StateHasChanged();
        _ = RedirigirConDelay();
    }

    private async Task RedirigirConDelay()
    {
        await Task.Delay(1200);
        Navigation.NavigateTo("/integraciones");
    }

    private void Cancelar() => Navigation.NavigateTo("/integraciones");
}
