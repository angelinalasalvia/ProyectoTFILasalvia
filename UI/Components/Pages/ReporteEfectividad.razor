@page "/reportes/efectividad"
@inject BLL.BLLHistorialAcciones BLLHistorialAcciones
@inject BLL.BLLCliente BLLCliente
@inject BLL.BLLCampana BLLCampana
@inject UI.Services.GeneradorPdf GeneradorPdf
@inject IJSRuntime JS
@rendermode InteractiveServer
@using BE
@using UI.Services

<PageTitle>Reporte de Efectividad</PageTitle>

<div class="rep-icons-row">
    <span>🔔</span>
    <span>❓</span>
    <span>⚙️</span>
</div>

<div class="breadcrumb">Reportes <span class="breadcrumb-sep">›</span> Reporte de efectividad</div>

<div class="retencion-header-row">
    <div>
        <h1 class="detalle-title">Reporte de efectividad</h1>
        <p class="camp-subtitle">Análisis detallado de rendimiento de acciones de retención automatizadas.</p>
    </div>
    <div class="retencion-actions">
        <label class="rep-filtro-fecha">
            Desde
            <input type="date" @bind="desde" max="@hasta.ToString("yyyy-MM-dd")" />
        </label>
        <label class="rep-filtro-fecha">
            Hasta
            <input type="date" @bind="hasta" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </label>
        <button class="btn-cancelar" @onclick="AplicarFiltro" disabled="@cargando">Aplicar</button>
        <button class="btn-confirmar" @onclick="ExportarPdf" disabled="@(exportando || datosAcciones is null)">
            @(exportando ? "Generando..." : "⬇ Exportar PDF")
        </button>
    </div>
</div>


@if (!string.IsNullOrEmpty(mensajeError)) { <div class="login-alerta">@mensajeError</div> }
@if (!string.IsNullOrEmpty(mensajeInfo)) { <div class="login-alerta">@mensajeInfo</div> }

@if (cargando && datosAcciones is null)
{
    <p>Cargando...</p>
}
else if (datosAcciones is not null)
{
    <!-- KPIs principales -->
    <div class="rep-kpi-row">
        @foreach (var k in kpis)
        {
            <div class="card rep-kpi-card">
                <div class="rep-kpi-top">
                    <div class="rep-kpi-icon">@k.Icono</div>
                    <span class="rep-kpi-badge @k.BadgeClase">@k.Badge</span>
                </div>
                <div class="rep-kpi-label">@k.Label</div>
                <div class="rep-kpi-valor">@k.Valor</div>
                <div class="rep-kpi-sub">@k.Sub</div>
            </div>
        }
    </div>

    <div class="rep-main-row">
        <!-- Rendimiento por canal -->
        <div class="card rep-canal-card">
            <h3 class="card-subtitle-dark">Rendimiento por canal</h3>
            <div class="rep-canal-cols">
                @foreach (var c in canales)
                {
                    <div class="rep-canal-col">
                        <div class="rep-canal-nombre"><span class="rep-canal-icono">@c.Icono</span> @c.Nombre</div>
                        @foreach (var m in c.Metricas)
                        {
                            <div class="rep-canal-metrica">
                                <div class="rep-canal-metrica-top">
                                    <span>@m.Label</span>
                                    <span class="rep-canal-metrica-valor">@m.Valor</span>
                                </div>
                                <div class="rep-canal-barra-fondo">
                                    <div class="rep-canal-barra-fill @m.ColorClase" style="width:@(m.Pct)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Mejores incentivos -->
        <div class="card rep-incentivos-card">
            <h3 class="card-subtitle-dark">Mejores incentivos</h3>
            <ul class="rep-incentivos-list">
                @foreach (var inc in incentivos)
                {
                    <li class="rep-incentivo-item">
                        <div class="rep-incentivo-top">
                            <span class="rep-incentivo-nombre">@inc.Nombre</span>
                            <span class="rep-incentivo-clientes">@inc.Clientes Clientes · @inc.Efectividad efectividad</span>
                        </div>
                        <div class="rep-incentivo-barra-fondo">
                            <div class="rep-incentivo-barra-fill" style="width:@(inc.PctBarra)%"></div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- ROI de retención -->
    <div class="card rep-roi-card">
        <div class="rep-roi-texto">
            <h3 class="card-subtitle-dark">ROI de retención</h3>
            <p>
                Comparando el costo total de todos los descuentos e incentivos otorgados frente al Valor de Vida
                del Cliente (LTV) proyectado de las cuentas recuperadas exitosamente.
            </p>
            <div class="rep-roi-legend">
                <span><i class="rep-dot rep-dot-azul"></i> Costo</span>
                <span><i class="rep-dot rep-dot-negro"></i> Valor Recuperado</span>
            </div>
        </div>

        <div class="rep-roi-proyeccion">
            <div class="rep-roi-label">Proyección Mensual</div>
            <div class="rep-roi-bar">
                <div class="rep-roi-bar-costo" style="width:@(pctCosto)%">@Abreviar(costo)</div>
                <div class="rep-roi-bar-valor">@Abreviar(ltv)</div>
            </div>
            <div class="rep-roi-stats">
                <div>
                    <div class="rep-roi-stats-label">COSTO DE INCENTIVOS</div>
                    <div class="rep-roi-stats-value">$@costo.ToString("N0")</div>
                </div>
                <div>
                    <div class="rep-roi-stats-label">VALOR RECUPERADO (LTV)</div>
                    <div class="rep-roi-stats-value">$@ltv.ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="rep-roi-margen">
            <div class="rep-roi-margen-badge">@margenTexto</div>
            <div class="rep-roi-margen-label">MARGEN NETO</div>
        </div>

        <div class="rep-roi-stats-label">$@((ltv - costo).ToString("N0"))</div>
    </div>
}

@code {
    private DateTime desde = DateTime.Today.AddDays(-29); // últimos 30 días (CU paso 2)
    private DateTime hasta = DateTime.Today;
    private bool cargando, exportando;
    private string mensajeError = "", mensajeInfo = "";

    private MetricasEfectividad? datosAcciones;
    private DatosFinancieros datosFinancieros = new();
    private DatosIncentivos datosIncentivos = new();

    private List<KpiReporte> kpis = new();
    private List<CanalReporte> canales = new();
    private List<IncentivoReporte> incentivos = new();
    private decimal costo, ltv;
    private string margenTexto = "—";
    private int pctCosto;

    protected override async Task OnInitializedAsync() => await CargarReporte();

    private async Task AplicarFiltro()
    {
        if (desde > hasta)
        {
            mensajeError = "La fecha \"desde\" no puede ser posterior a la fecha \"hasta\".";
            return;
        }
        await CargarReporte();
    }

    private async Task CargarReporte()
    {
        cargando = true;
        mensajeError = mensajeInfo = "";
        try
        {
            var acciones = await BLLHistorialAcciones.ObtenerMetricasEfectividad(desde, hasta);
            var financieros = await BLLCliente.ObtenerDatosFinancierosRetencion(desde, hasta);
            var datosInc = await BLLCampana.ObtenerEfectividadIncentivos(desde, hasta);

            datosAcciones = acciones;
            datosFinancieros = financieros;
            datosIncentivos = datosInc;

            RecalcularMetricasYGraficos();

            if (acciones.TotalAcciones == 0)
                mensajeInfo = "No existen registros para el período seleccionado.";
        }
        catch
        {
            datosAcciones = null;
            mensajeError = "No fue posible obtener la información.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void RecalcularMetricasYGraficos()
    {
        var a = datosAcciones!;
        costo = datosIncentivos.CostoTotal;
        ltv = datosFinancieros.LtvRecuperado;

        decimal Roi(decimal valor, decimal c) => c == 0 ? 0 : valor / c;
        var roi = Roi(ltv, costo);
        var roiAnt = Roi(datosFinancieros.LtvRecuperadoAnterior, datosIncentivos.CostoTotalAnterior);

        var (bRec, cRec) = Variacion(a.TasaRecuperacion, a.TasaRecuperacionAnterior);
        var (bMrr, cMrr) = Variacion(datosFinancieros.MrrRecuperado, datosFinancieros.MrrRecuperadoAnterior);
        var (bRoi, cRoi) = Variacion(roi, roiAnt);
        var (bAcc, cAcc) = Variacion(a.TotalAcciones, a.TotalAccionesAnterior);

        kpis = new()
        {
            new("📈", "TASA GLOBAL DE RECUPERACIÓN", $"{a.TasaRecuperacion:0.0}%",
                $"vs. {a.TasaRecuperacionAnterior:0.0}% período anterior", bRec, cRec),
            new("💲", "MRR RECUPERADO", $"${datosFinancieros.MrrRecuperado:N0}",
                $"vs. ${datosFinancieros.MrrRecuperadoAnterior:N0} período anterior", bMrr, cMrr),
            new("🗂️", "ROI DE RETENCIÓN", costo == 0 ? "—" : $"{roi:0.0}x",
                "Inversión vs LTV Recuperado", bRoi, cRoi),
            new("✉️", "ACCIONES EJECUTADAS", $"{a.TotalAcciones:N0}",
                $"vs. {a.TotalAccionesAnterior:N0} período anterior", bAcc, cAcc),
        };

        canales = a.Canales.Select(c =>
        {
            var email = c.Canal == "Email";
            var fuerte = email ? "rep-barra-azul" : "rep-barra-verde";
            var suave = email ? "rep-barra-azul-claro" : "rep-barra-verde-claro";
            return new CanalReporte(email ? "Email Marketing" : c.Canal, email ? "@" : "💬", new()
            {
                new("Tasa de apertura", $"{c.TasaApertura:0.0}%", (int)Math.Round(c.TasaApertura), fuerte),
                new("Tasa de clicks", $"{c.TasaClics:0.0}%", (int)Math.Round(c.TasaClics), suave),
                new("Tasa de recuperación", $"{c.TasaRecuperacion:0.0}%", (int)Math.Round(c.TasaRecuperacion), suave),
            });
        }).ToList();

        var max = datosIncentivos.Incentivos.Select(i => i.Rescatados).DefaultIfEmpty(0).Max();
        incentivos = datosIncentivos.Incentivos.Take(5)
            .Select(i => new IncentivoReporte(i.Nombre, i.Rescatados,
            max == 0 ? 0 : (int)(100.0 * i.Rescatados / max),
            i.Enviados == 0 ? "0%" : $"{i.Rescatados * 100.0 / i.Enviados:0.0}%"))
            .ToList();

        pctCosto = costo + ltv == 0 ? 0 : (int)(100.0 * (double)costo / (double)(costo + ltv));
        margenTexto = costo == 0 ? "—" : ((ltv - costo) * 100m / costo).ToString("+0;-0") + "%";
    }

    // Verde = mejora, rojo = empeora (CU paso 5). Sin período anterior comparable no hay variación.
    private static (string Texto, string Clase) Variacion(decimal actual, decimal anterior)
    {
        if (anterior == 0) return ("—", "rep-badge-neutro");
        var pct = Math.Round((actual - anterior) * 100m / anterior, 1);
        if (pct == 0) return ("0%", "rep-badge-neutro");
        return (pct.ToString("+0.0;-0.0") + "%", pct > 0 ? "rep-badge-positivo" : "rep-badge-negativo");
    }

    private static string Abreviar(decimal v) => v >= 1000 ? $"${v / 1000m:0.#}K" : $"${v:0}";

    private async Task ExportarPdf()
    {
        if (datosAcciones is null) return;
        exportando = true;
        mensajeError = mensajeInfo = "";
        try
        {
            var pdf = GeneradorPdf.GenerarReporteEfectividad(desde, hasta, kpis, canales, incentivos,
                costo, ltv, $"{margenTexto} (${ltv - costo:N0})");
            await JS.InvokeVoidAsync("descargarArchivo",
                $"Reporte_Efectividad_{DateTime.Now:yyyyMMdd_HHmm}.pdf", Convert.ToBase64String(pdf));
            mensajeInfo = "El PDF se generó correctamente.";
        }
        catch
        {
            mensajeError = "No fue posible generar el archivo. Podés reintentar o seguir navegando el detalle normalmente.";
        }
        finally
        {
            exportando = false;
        }
    }
}