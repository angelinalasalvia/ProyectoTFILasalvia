@page "/cliente-detalle/{ClienteId:int}"
@inject BLLCliente ClienteBLL
@inject BLLEventosCliente EventosBLL
@inject BLLPrediccion PrediccionBLL
@using System.Globalization
@using BE
@using BLL

<PageTitle>Detalle de Cliente: @NombreCompleto</PageTitle>

<div class="page-header">
    <a href="clientes" class="back-link">‹ Volver a Clientes</a>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

@if (cargando)
{
    <div class="card"><div class="detcli-aviso">Cargando cliente…</div></div>
}
else if (cliente is null)
{
    <div class="detcli-mensaje-error">⚠ @mensajeError</div>
}
else
{
    <!-- Card de perfil -->
    <div class="card detcli-perfil-card">
        <div class="detcli-avatar-wrap">
            <div class="detcli-avatar">🧑</div>
            <span class="detcli-status-dot @(EsActivo ? "" : "detcli-status-inactivo")" title="@cliente.EstadoRegistro"></span>
        </div>
        <div>
            <div class="detcli-nombre">@NombreCompleto</div>
            <div class="detcli-subtitulo">@cliente.EstadoRegistro &nbsp;•&nbsp; @cliente.Sede</div>
            <div class="detcli-meta-row">
                <span>📅 Socio desde: @FormatoFecha(cliente.FechaInicio, "dd MMM yyyy")</span>
                <span>✉️ @cliente.Email</span>
                <span>🏷️ @cliente.PlanSocio</span>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="detcli-mensaje-error">⚠ @mensajeError</div>
    }

    <div class="detcli-main-row">

        @if (datosSuficientes)
        {
            <!-- Asistencia al gimnasio -->
            <div class="card detcli-asistencia-card">
                <div class="detcli-asistencia-header">
                    <div>
                        <h3 class="card-subtitle-dark">Asistencia al Gimnasio (Sesiones)</h3>
                        <p class="detcli-asistencia-sub">Actividad de los últimos @diasPeriodo días</p>
                    </div>
                    <select class="periodo-select" @bind="diasPeriodo" @bind:after="ModificarPeriodoGrafico">
                        <option value="7">Últimos 7 días</option>
                        <option value="30">Últimos 30 días</option>
                        <option value="90">Últimos 90 días</option>
                    </select>
                </div>

                @if (!string.IsNullOrEmpty(mensajePeriodo))
                {
                    <div class="detcli-aviso">@mensajePeriodo</div>
                }
                else
                {
                    <div class="detcli-chart" style="gap:@(GapBarrasPx)px">
                        @foreach (var d in dias)
                        {
                            <div class="detcli-bar-col" title="@(FormatoFecha(d.Fecha, "dd/MM")): @d.Visitas visita(s)">
                                <div class="detcli-bar @(d.EsAlerta ? "detcli-bar-alerta" : "")"
                                     style="height:@(d.AlturaPct)%"></div>
                            </div>
                        }
                    </div>
                    <div class="detcli-chart-labels">
                        <span>HACE @diasPeriodo DÍAS</span>
                        <span>HACE @(diasPeriodo / 2) DÍAS</span>
                        <span>HOY</span>
                    </div>
                    <div class="detcli-leyenda">
                        <span class="detcli-leyenda-cuadro"></span>
                        Días con baja o nula actividad respecto de su frecuencia habitual
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card detcli-asistencia-card">
                <div class="detcli-aviso">@mensajeInfo</div>
            </div>
        }

        <!-- Línea de tiempo -->
        <div class="card detcli-timeline-card">
            <h3 class="card-subtitle-dark">Línea de Tiempo</h3>

            @if (linea.Count == 0)
            {
                <div class="detcli-aviso">Este cliente todavía no tiene eventos registrados.</div>
            }
            else
            {
                <div class="detcli-timeline-scroll">
                    <ul class="detcli-timeline">
                        @foreach (var e in linea)
                        {
                            <li class="detcli-timeline-item">
                                <span class="detcli-timeline-dot @e.DotClase"></span>
                                <div class="detcli-timeline-content">
                                    <div class="detcli-timeline-top">
                                        <span class="detcli-timeline-titulo">@e.Titulo</span>
                                        <span class="detcli-timeline-fecha">@FormatoFecha(e.Fecha, "dd MMM yyyy, HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(e.Descripcion))
                                    {
                                        <div class="detcli-timeline-desc">@e.Descripcion</div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                    @if (HayMasEventos)
                    {
                        <button class="detcli-mas-eventos" disabled="@cargandoMas" @onclick="CargarMasEventos">
                            @(cargandoMas ? "Cargando…" : "Cargar eventos anteriores")
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    @if (datosSuficientes)
    {
        <!-- Métricas de comportamiento + score de churn -->
        <div class="detcli-kpi-row">
            <div class="detcli-kpi-card">
                <div class="detcli-kpi-label">TASA DE ADOPCIÓN</div>
                <div class="detcli-kpi-value">
                    @(metricas.TasaAdopcion.ToString("0.#", Es))%
                    <span class="@IndicarTendencia(metricas.TasaAdopcion, metricas.TasaAdopcionAnterior)">
                        @Variacion(metricas.TasaAdopcion, metricas.TasaAdopcionAnterior, " pts", "0.#")
                    </span>
                </div>
            </div>

            <div class="detcli-kpi-card">
                <div class="detcli-kpi-label">INTERACCIONES CON LA APP</div>
                <div class="detcli-kpi-value">
                    @metricas.InteraccionesApp
                    <span class="detcli-kpi-sub-inline">últimos 30d</span>
                    <span class="@IndicarTendencia(metricas.InteraccionesApp, metricas.InteraccionesAppAnterior)">
                        @Variacion(metricas.InteraccionesApp, metricas.InteraccionesAppAnterior, "", "0")
                    </span>
                </div>
            </div>

            <div class="detcli-kpi-card">
                <div class="detcli-kpi-label">SESIONES PROMEDIO / DÍA</div>
                <div class="detcli-kpi-value">
                    @(metricas.SesionesPromedioDia.ToString("0.##", Es))
                    <span class="@IndicarTendencia(metricas.SesionesPromedioDia, metricas.SesionesPromedioDiaAnterior)">
                        @Variacion(metricas.SesionesPromedioDia, metricas.SesionesPromedioDiaAnterior, "", "0.##")
                    </span>
                </div>
            </div>

            <div class="detcli-kpi-card">
                <div class="detcli-kpi-label">RIESGO DE ABANDONO</div>
                <div class="detcli-kpi-value">
                    @if (probabilidadChurn is null)
                    {
                        <span class="detcli-kpi-sub-inline">Sin predicción disponible</span>
                    }
                    else
                    {
                        @(probabilidadChurn.Value.ToString("0.#", Es))
            
                        <text>%</text>
                        <span class="detcli-riesgo @ClaseRiesgo(nivelRiesgo)">@nivelRiesgo</span>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public int ClienteId { get; set; }

    private static readonly CultureInfo Es = new("es-AR");
    private const int TamanoTanda = 15;

    private Cliente? cliente;
    private MetricasCliente metricas = new();
    private List<DiaAsistencia> dias = new();
    private List<ItemLinea> linea = new();
    private int totalEventos;
    private int diasPeriodo = 30;                // CU09 paso 4: por defecto los últimos 30 días

    private bool cargando = true;
    private bool datosSuficientes;
    private bool cargandoMas;
    private string mensajeError = "";
    private string mensajeInfo = "";
    private string mensajePeriodo = "";

    // Score de churn (CU09 paso 12)
    private decimal? probabilidadChurn;
    private string nivelRiesgo = "";

    private string NombreCompleto => cliente is null ? "" : $"{cliente.Nombre} {cliente.Apellido}";
    private bool EsActivo => cliente?.EstadoRegistro == "Socio Activo";
    private bool HayMasEventos => linea.Count < totalEventos;
    private int GapBarrasPx => diasPeriodo <= 7 ? 14 : diasPeriodo <= 30 ? 4 : 1;

    // DS: Ver detalle cliente() -> ObtenerCliente(int id) + ObtenerHistorialCliente(int id)
    protected override async Task OnInitializedAsync()
    {
        try
        {
            cliente = await ClienteBLL.ObtenerCliente(ClienteId);
            if (cliente is null)
            {
                mensajeError = "El cliente solicitado no existe.";
                return;
            }

            totalEventos = await EventosBLL.ContarEventos(ClienteId);
            await GenerarLineaDeTiempo();

            // DS: [No existen datos suficientes] -> solo datos del cliente + historial
            datosSuficientes = totalEventos >= BLLEventosCliente.MinEventosParaAnalisis;
            if (!datosSuficientes)
            {
                mensajeInfo = "No existen datos suficientes para generar los gráficos de uso ni calcular las métricas de comportamiento.";
                return;
            }

            // DS: [Existen datos] -> CalcularMétricasCliente, gráfico, score
            metricas = await EventosBLL.CalcularMetricasCliente(ClienteId);
            await GenerarGraficoUsoInstalaciones();
            await CargarScoreChurn();
        }
        catch (Exception)
        {
            cliente = null;
            mensajeError = "No se pudo cargar el detalle del cliente.";
        }
        finally
        {
            cargando = false;
        }
    }

    // DS: GenerarLíneaDeTiempo() - cada llamada trae la siguiente tanda de eventos más antiguos
    private async Task GenerarLineaDeTiempo()
    {
        var tanda = await EventosBLL.ObtenerHistorialCliente(ClienteId, linea.Count, TamanoTanda);
        linea.AddRange(tanda.Select(ArmarItem));
    }

    // CU09 pasos 8-9: el usuario baja y pide eventos anteriores
    private async Task CargarMasEventos()
    {
        if (cargandoMas) return;
        cargandoMas = true;
        try
        {
            await GenerarLineaDeTiempo();
        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar más eventos.";
        }
        finally
        {
            cargandoMas = false;
        }
    }

    // DS: GenerarGráficoUsoInstalaciones() <- ObtenerHistorialClienteSegúnPeríodo()
    private async Task GenerarGraficoUsoInstalaciones()
    {
        mensajePeriodo = "";

        var eventos = await EventosBLL.ObtenerHistorialClienteSegunPeriodo(ClienteId, diasPeriodo);

        // CU09 8.1
        if (!eventos.Any(e => e.Evento == TipoEvento.VisitaGimnasio))
        {
            dias = new();
            mensajePeriodo = "No hay registros de asistencia para el período seleccionado.";
            return;
        }

        var visitasPorDia = eventos
            .Where(e => e.Evento == TipoEvento.VisitaGimnasio)
            .GroupBy(e => e.Fecha.Date)
            .ToDictionary(g => g.Key, g => g.Count());

        var hoy = DateTime.Today;
        dias = Enumerable.Range(0, diasPeriodo)
            .Select(i =>
            {
                var fecha = hoy.AddDays(-(diasPeriodo - 1 - i));
                return new DiaAsistencia { Fecha = fecha, Visitas = visitasPorDia.GetValueOrDefault(fecha) };
            })
            .ToList();

        AnalizarPatronAsistencia();

        var maximo = Math.Max(1, dias.Max(d => d.Visitas));
        foreach (var d in dias)
            d.AlturaPct = d.Visitas > 0 ? 30 + 70 * d.Visitas / maximo : d.EsAlerta ? 14 : 4;
    }

    // DS: AnalizarPatrónAsistencia()
    // Un día sin visitas se marca como baja actividad cuando las visitas de esa semana (7 días móviles)
    // no superan (100 - UmbralAnomalia)% de la frecuencia semanal habitual del cliente en el período.
    private void AnalizarPatronAsistencia()
    {
        var total = dias.Sum(d => d.Visitas);
        if (total == 0) return;

        var habitualSemanal = total / (double)dias.Count * 7;
        var umbral = habitualSemanal * (1 - BLLCliente.UmbralAnomalia / 100.0);

        for (int i = 6; i < dias.Count; i++)
        {
            var semana = dias.Skip(i - 6).Take(7).Sum(d => d.Visitas);
            if (dias[i].Visitas == 0 && semana <= umbral)
                dias[i].EsAlerta = true;
        }
    }

    // DS: ModificarPeríodoGráfico()
    private async Task ModificarPeriodoGrafico()
    {
        try
        {
            await GenerarGraficoUsoInstalaciones();
        }
        catch (Exception)
        {
            mensajePeriodo = "No se pudo actualizar el gráfico.";
        }
    }

    // DS: ObtenerScoreChurn(int id): ScoreChurn  (:Predicción)
    private async Task CargarScoreChurn()
    {
        try
        {
            var score = await PrediccionBLL.ObtenerScoreChurn(ClienteId);
            if (score is null) return;   // sin predicción (p. ej. socios inactivos): la tarjeta lo informa

            probabilidadChurn = score.ProbabilidadAbandono;
            nivelRiesgo = score.NivelRiesgo;
        }
        catch (Exception)
        {
            // Si falla solo el score, el resto del detalle se sigue mostrando.
        }
    }

    // DS: IndicarTendenciaMétricas() - verde si mejora, rojo si empeora, gris si no cambia
    private static string IndicarTendencia(decimal actual, decimal anterior)
        => actual > anterior ? "detcli-kpi-delta-pos"
         : actual < anterior ? "detcli-kpi-delta-neg"
         : "detcli-kpi-sub-inline";

    private static string Variacion(decimal actual, decimal anterior, string unidad, string formato)
    {
        var d = actual - anterior;
        var signo = d > 0 ? "+" : d < 0 ? "-" : "";
        return $"({signo}{Math.Abs(d).ToString(formato, Es)}{unidad} vs. mes anterior)";
    }

    private static string ClaseRiesgo(string nivel) => nivel switch
    {
        "Alto" => "detcli-riesgo-alto",
        "Medio" => "detcli-riesgo-medio",
        "Bajo" => "detcli-riesgo-bajo",
        _ => ""
    };

    private static string FormatoFecha(DateTime? fecha, string formato)
        => fecha?.ToString(formato, Es) ?? "Sin registros";

    private static ItemLinea ArmarItem(EventoCliente e) => e.Evento switch
    {
        TipoEvento.PagoRegistrado => new(e.Evento, e.Fecha, "Cuota registrada como paga", "detcli-dot-azul"),
        TipoEvento.PagoVencido => new(e.Evento, e.Fecha, "La cuota quedó vencida sin pago", "detcli-dot-rojo"),
        TipoEvento.VisitaGimnasio => new(e.Evento, e.Fecha, "Ingreso a las instalaciones", "detcli-dot-verde"),
        TipoEvento.UsoApp => new(e.Evento, e.Fecha, "Actividad en la aplicación", "detcli-dot-gris"),
        TipoEvento.ReservaClase => new(e.Evento, e.Fecha, "Reservó una clase", "detcli-dot-ambar"),
        TipoEvento.CancelacionReserva => new(e.Evento, e.Fecha, "Canceló una reserva", "detcli-dot-ambar"),
        TipoEvento.ConsultaSoporte => new(e.Evento, e.Fecha, "Se comunicó con soporte", "detcli-dot-ambar"),
        _ => new(e.Evento, e.Fecha, "", "detcli-dot-gris")
    };

    private record ItemLinea(string Titulo, DateTime Fecha, string Descripcion, string DotClase);

    private class DiaAsistencia
    {
        public DateTime Fecha { get; set; }
        public int Visitas { get; set; }
        public bool EsAlerta { get; set; }
        public int AlturaPct { get; set; }
    }
}