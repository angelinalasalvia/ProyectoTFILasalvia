@inject NavigationManager Navigation
@using Servicios

<div class="sidebar @(isCollapsed ? "collapsed" : "")">
    <div class="sidebar-brand">
        <span class="oi oi-grid-two-up" aria-hidden="true"></span>
        <span class="brand-text">Dashboard</span>
        <button class="collapse-btn" @onclick="ToggleSidebar" title="Minimizar menú">
            @(isCollapsed ? "»" : "«")
        </button>
    </div>

    <nav class="flex-column">
        @if (Puede("Integraciones"))
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="integraciones" title="Integraciones">
                    <span class="icon">🗄️</span> <span class="nav-text">Integraciones</span>
                </NavLink>
            </div>
        }
        @if (Puede("Clientes"))
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="clientes" title="Clientes">
                <span class="icon">👥</span> <span class="nav-text">Clientes</span>
            </NavLink>
        </div>
        }        
        @if (Puede("Predicciones"))
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="predicciones" title="Predicciones">
                <span class="icon">🎯</span> <span class="nav-text">Predicciones</span>
            </NavLink>
        </div>
        }
        @if (Puede("Campañas"))
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="campanas" title="Campañas">
                    <span class="icon">📣</span> <span class="nav-text">Campañas</span>
                </NavLink>
            </div>
        }
        @if (Puede("Automatización"))
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="automatizacion" title="Automatización">
                <span class="icon">⚙️</span> <span class="nav-text">Automatización</span>
            </NavLink>
        </div>
        }
        @if (Puede("Reportes"))
        {
            <div class="nav-item">
                <button class="nav-link nav-link-parent @(reportesAbierto ? "active" : "")"
                @onclick="ToggleReportes" title="Reportes">
                    <span class="icon">📊</span> <span class="nav-text">Reportes</span>
                    <span class="nav-chevron">@(reportesAbierto ? "▾" : "▸")</span>
                </button>
                @if (reportesAbierto)
                {
                    <div class="nav-submenu">
                        @if (Puede("Reporte de Efectividad"))
                        {
                            <NavLink class="nav-sublink" href="reportes/efectividad" title="Reporte de Efectividad">
                                Reporte de Efectividad
                            </NavLink>
                        }
                        @if (Puede("Reporte de Retención"))
                        {
                            <NavLink class="nav-sublink" href="reportes/retencion" title="Reporte de Retención">
                                Reporte de Retención
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        

        <!-- Administración: ítem padre con submenú desplegable (Usuarios / Roles) -->
        @if (Puede("Administración"))
        {
            <div class="nav-item">
                <button class="nav-link nav-link-parent @(administracionAbierto ? "active" : "")"
                @onclick="ToggleAdministracion" title="Administración">
                    <span class="icon">👥</span> <span class="nav-text">Administración</span>
                    <span class="nav-chevron">@(administracionAbierto ? "▾" : "▸")</span>
                </button>
                @if (administracionAbierto)
                {
                    <div class="nav-submenu">
                        @if (Puede("Usuarios"))
                        {
                            <NavLink class="nav-sublink" href="administracion/usuarios" title="Usuarios">
                                Usuarios
                            </NavLink>
                        }
                        @if (Puede("Roles"))
                        {
                            <NavLink class="nav-sublink" href="administracion/roles" title="Roles">
                                Roles
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <div class="nav-item">
            @if (SessionManager.GetInstance().EstaLogueado)
            {
                <button class="nav-link nav-link-parent" @onclick="CerrarSesion" title="Cerrar sesión">
                    <span class="icon">🚪</span> <span class="nav-text">Cerrar sesión</span>
                </button>
            }
            else
            {
                <NavLink class="nav-link" href="login" title="Iniciar sesión">
                    <span class="icon">🔑</span> <span class="nav-text">Iniciar sesión</span>
                </NavLink>
            }
        </div>
    </nav>

    <div class="sidebar-footer">
        <div class="avatar">JD</div>
        <div class="user-info">
            <div class="user-name">Javier Domínguez</div>
            <div class="user-role">Admin Account</div>
        </div>
    </div>
</div>

@code {
    private bool isCollapsed = false;

    private bool reportesAbierto = false;

    private bool administracionAbierto = false;

    protected override void OnInitialized()
    {
        reportesAbierto = Navigation.Uri.Contains("/reportes/");
        administracionAbierto = Navigation.Uri.Contains("/administracion/");
    }

    private void ToggleSidebar()
    {
        isCollapsed = !isCollapsed;
    }

    private void ToggleReportes()
    {
        reportesAbierto = !reportesAbierto;
    }

    private void ToggleAdministracion()
    {
        administracionAbierto = !administracionAbierto;
    }

    private void CerrarSesion()
    {
        SessionManager.GetInstance().Logout();
        Navigation.NavigateTo("/login");
    }

    private static bool Puede(string permiso)
    => SessionManager.GetInstance().TienePermiso(permiso);
}