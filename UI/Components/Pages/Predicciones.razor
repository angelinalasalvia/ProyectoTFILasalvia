@page "/predicciones"
@inject BLL.BLLPrediccion BLLPrediccion
@inject BLL.BLLModelo BLLModelo
@inject UI.Services.GeneradorPdf GeneradorPdf
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ILogger<Predicciones> Logger
@rendermode InteractiveServer
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using BE
@using System.Globalization
@using Microsoft.Extensions.Logging

<PageTitle>Motor de Predicciones ML</PageTitle>

<div class="page-header">
    <div></div>
    <div class="header-icons">
        <span>🔔</span>
        <span>❓</span>
        <span>⚙️</span>
    </div>
</div>

<div class="pred-title-row">
    <div>
        <h1>Motor de Predicciones ML</h1>
        <p class="pred-subtitle">
            Visualización en tiempo real del modelo de propensión al abandono.
            @if (ultimaEjecucion != null)
            {
                <text> Última ejecución del modelo: <strong>@ultimaEjecucion.Value.ToString("dd/MM/yyyy HH:mm")</strong>.</text>
            }
        </p>
    </div>
    <button class="btn-exportar" @onclick="ExportarInforme" disabled="@(exportando || predicciones.Count == 0)">
        @(exportando ? "Generando..." : "⬇ Exportar Informe")
    </button>
</div>

@if (!string.IsNullOrEmpty(mensajeExportacion))
{
    <div class="@(exportacionExitosa ? "alerta-exito" : "alerta-error")">@mensajeExportacion</div>
}

@if (predicciones.Count == 0)
{
    <div class="card pred-table-card">
        <p>Aún no se ha ejecutado ningún modelo de predicción. El cálculo automático corre en segundo plano — volvé a entrar a esta pantalla en unos minutos.</p>
    </div>
}
else
{
    <div class="pred-kpi-row">
        <div class="card pred-kpi-card">
            <div class="pred-kpi-top">
                <span class="pred-kpi-label label-alto">RIESGO ALTO</span>
                <span class="pred-kpi-icon icon-alto">⚠️</span>
            </div>
            <div class="pred-kpi-value">@countAlto</div>
            <div class="pred-kpi-sub">Clientes con probabilidad &gt; 75%</div>
            <div class="pred-bar"><div class="pred-bar-fill fill-alto" style="width:@(PorcentajeKpi(countAlto))%"></div></div>
        </div>

        <div class="card pred-kpi-card">
            <div class="pred-kpi-top">
                <span class="pred-kpi-label label-medio">RIESGO MEDIO</span>
                <span class="pred-kpi-icon icon-medio">📉</span>
            </div>
            <div class="pred-kpi-value">@countMedio</div>
            <div class="pred-kpi-sub">Clientes con probabilidad 40-75%</div>
            <div class="pred-bar"><div class="pred-bar-fill fill-medio" style="width:@(PorcentajeKpi(countMedio))%"></div></div>
        </div>

        <div class="card pred-kpi-card">
            <div class="pred-kpi-top">
                <span class="pred-kpi-label label-bajo">RIESGO BAJO</span>
                <span class="pred-kpi-icon icon-bajo">✅</span>
            </div>
            <div class="pred-kpi-value">@countBajo</div>
            <div class="pred-kpi-sub">Clientes con probabilidad &lt; 40%</div>
            <div class="pred-bar"><div class="pred-bar-fill fill-bajo" style="width:@(PorcentajeKpi(countBajo))%"></div></div>
        </div>
    </div>

    <div class="card pred-table-card">
        <div class="pred-filter-row">
            <div class="filter-left">
                <span class="filter-label">FILTRAR POR RIESGO:</span>
                <button class="filter-pill @(filtroActivo == "Alto" ? "active-alto" : "")" @onclick='() => CambiarFiltro("Alto")'>Alto</button>
                <button class="filter-pill @(filtroActivo == "Medio" ? "active-medio" : "")" @onclick='() => CambiarFiltro("Medio")'>Medio</button>
                <button class="filter-pill @(filtroActivo == "Bajo" ? "active-bajo" : "")" @onclick='() => CambiarFiltro("Bajo")'>Bajo</button>
                <button class="filter-pill @(filtroActivo == "Todos" ? "active-todos" : "")" @onclick='() => CambiarFiltro("Todos")'>Ver todos</button>
            </div>
            <select class="sort-select" @onchange="CambiarOrden">
                <option value="probabilidad">Ordenar por Probabilidad</option>
                <option value="nombre">Ordenar por Nombre</option>
                <option value="nivel">Ordenar por Nivel de Riesgo</option>
            </select>
        </div>

        @if (prediccionesMostradas.Count == 0)
        {
            <p class="pred-sin-resultados">
                No hay clientes que correspondan al nivel de riesgo seleccionado.
                <a href="#" @onclick:preventDefault @onclick='() => CambiarFiltro("Todos")'>Limpiar filtro</a>
            </p>
        }
        else
        {
            <table class="pred-table">
                <thead>
                    <tr>
                        <th>CLIENTE</th>
                        <th>PROBABILIDAD DE ABANDONO</th>
                        <th>NIVEL DE RIESGO</th>
                        <th>FACTOR PRINCIPAL DE RIESGO</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in PrediccionesPaginaActual)
                    {
                        <tr class="pred-row" @onclick="() => IrADetalle(p.IdCliente)">
                            <td>
                                <div class="client-cell">
                                    <div class="client-avatar-initials">@Iniciales(p)</div>
                                    <span class="client-name">@p.Cliente!.Nombre @p.Cliente.Apellido</span>
                                </div>
                            </td>
                            <td>
                                <div class="prob-cell">
                                    <span class="prob-percent @NivelClase(p.NivelRiesgo)">@p.ProbabilidadAbandono.ToString("F1")%</span>
                                    <div class="prob-bar-pred"><div class="prob-fill-pred @NivelClase(p.NivelRiesgo)" style="width:@(AnchoCss(p.ProbabilidadAbandono))%"></div></div>
                                </div>
                            </td>
                            <td><span class="nivel-badge @NivelClase(p.NivelRiesgo)">@p.NivelRiesgo</span></td>
                            <td class="factor-cell">@p.FactorRiesgo!.Nombre</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="pred-pagination">
                <span class="pagination-info">
                    Mostrando @(Math.Min((paginaActual - 1) * tamanioPagina + 1, prediccionesMostradas.Count))-@(Math.Min(paginaActual * tamanioPagina, prediccionesMostradas.Count)) de @prediccionesMostradas.Count clientes analizados
                </span>
                <div class="pagination-controls">
                    <button class="page-btn" @onclick="() => IrAPagina(paginaActual - 1)" disabled="@(paginaActual == 1)">‹</button>

                    @{
                        var anterior = 0;
                    }
                    @foreach (var num in NumerosDePagina())
                    {
                        @if (anterior != 0 && num - anterior > 1)
                        {
                            <span>...</span>
                        }
                        <button class="page-btn @(num == paginaActual ? "active" : "")" @onclick="() => IrAPagina(num)">@num</button>
                        anterior = num;
                    }

                    <button class="page-btn" @onclick="() => IrAPagina(paginaActual + 1)" disabled="@(paginaActual == TotalPaginas)">›</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Prediccion> predicciones = new();
    private List<Prediccion> prediccionesMostradas = new();
    private DateTime? ultimaEjecucion;

    private string filtroActivo = "Todos";
    private string criterioOrden = "probabilidad";

    private int paginaActual = 1;
    private const int tamanioPagina = 5;

    private bool exportando = false;
    private bool exportacionExitosa = false;
    private string mensajeExportacion = "";

    private int countAlto, countMedio, countBajo;

    protected override async Task OnInitializedAsync()
    {
        predicciones = await BLLPrediccion.ObtenerPredicciones();
        prediccionesMostradas = predicciones;
        ultimaEjecucion = await BLLModelo.ObtenerFechaUltimaEjecucion();

        (countAlto, countMedio, countBajo) = await BLLPrediccion.ObtenerResumenNivelesRiesgo();
    }

    // Los porcentajes que van dentro de un style="" deben usar punto decimal siempre,
    // sin importar la cultura (en es-AR "62,5%" sería CSS inválido).
    private string PorcentajeKpi(int cantidad) =>
        (predicciones.Count == 0 ? 0 : Math.Round(cantidad * 100.0 / predicciones.Count, 1))
            .ToString(CultureInfo.InvariantCulture);

    private static string AnchoCss(decimal porcentaje) =>
        porcentaje.ToString("0.##", CultureInfo.InvariantCulture);

    // El filtro y el orden se resuelven en la BLL; cada llamada incluye el otro criterio vigente.
    private async Task CambiarFiltro(string nivel)
    {
        filtroActivo = nivel;
        prediccionesMostradas = await BLLPrediccion.ObtenerPrediccionesSegunFiltro(filtroActivo, criterioOrden);
        paginaActual = 1;
    }

    private async Task CambiarOrden(ChangeEventArgs e)
    {
        criterioOrden = e.Value?.ToString() ?? "probabilidad";
        prediccionesMostradas = await BLLPrediccion.ObtenerPrediccionesOrdenadas(criterioOrden, filtroActivo);
        paginaActual = 1;
    }

    private void IrADetalle(int idCliente) => Nav.NavigateTo($"prediccion-detalle/{idCliente}");

    private List<Prediccion> PrediccionesPaginaActual =>
    prediccionesMostradas.Skip((paginaActual - 1) * tamanioPagina).Take(tamanioPagina).ToList();

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(prediccionesMostradas.Count / (double)tamanioPagina));

    private void IrAPagina(int pagina)
    {
        if (pagina < 1 || pagina > TotalPaginas) return;
        paginaActual = pagina;
    }

    private List<int> NumerosDePagina()
    {
        var numeros = new List<int> { 1 };
        int desde = Math.Max(2, paginaActual - 1);
        int hasta = Math.Min(TotalPaginas - 1, paginaActual + 1);
        for (int i = desde; i <= hasta; i++) numeros.Add(i);
        if (TotalPaginas > 1) numeros.Add(TotalPaginas);
        return numeros.Distinct().ToList();
    }

    private string Iniciales(Prediccion p) =>
        $"{p.Cliente!.Nombre.FirstOrDefault()}{p.Cliente.Apellido.FirstOrDefault()}".ToUpper();

    private string NivelClase(string nivel) => nivel switch
    {
        "Alto" => "nivel-alto",
        "Medio" => "nivel-medio",
        "Bajo" => "nivel-bajo",
        _ => ""
    };

    // Pasos 10-12, y alternativo 11.1 (error al exportar).
    private async Task ExportarInforme()
    {
        exportando = true;
        mensajeExportacion = "";
        StateHasChanged();
        await Task.Yield(); // permite que se pinte "Generando..." antes del trabajo síncrono

        try
        {
            var pdfBytes = GeneradorPdf.GenerarInformePredicciones(prediccionesMostradas, filtroActivo);
            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("descargarArchivo", $"Predicciones_{DateTime.Now:yyyyMMdd_HHmm}.pdf", base64);

            exportacionExitosa = true;
            mensajeExportacion = "El archivo PDF se generó con éxito.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al exportar el informe de predicciones (filtro: {Filtro})", filtroActivo);
            exportacionExitosa = false;
            mensajeExportacion = "No fue posible generar el archivo. Podés reintentar o seguir navegando la vista normalmente.";
        }
        finally
        {
            exportando = false;
        }
    }
}