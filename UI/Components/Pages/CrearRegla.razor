@page "/automatizacion/nueva-regla"
@page "/automatizacion/editar-regla/{ReglaId}"
@using BLL
@inject NavigationManager Navigation
@inject BLLSede BLLSede
@inject BLLPlanSocio BLLPlanSocio
@inject BLLRegla BLLRegla
@inject BLLCampana BLLCampana
@inject BLLIncentivo BLLIncentivo

<PageTitle>@(EsEdicion ? "Editar Regla" : "Nueva Regla")</PageTitle>

<div class="breadcrumb">
    AUTOMATIZACIÓN <span class="breadcrumb-sep">›</span> @(EsEdicion ? "EDITAR REGLA" : "NUEVA REGLA")
</div>

<div class="retencion-header-row">
    <div>
        <h1 class="detalle-title">@(EsEdicion ? "Editar Regla de Automatización" : "Configurar Regla de Automatización")</h1>
        <p class="camp-subtitle">Crea flujos inteligentes para retener a tus clientes antes de que se den de baja.</p>
    </div>
    <div class="retencion-actions">
        <button class="btn-cancelar" @onclick="Cancelar">Cancelar</button>
        <button class="btn-confirmar" @onclick="GuardarRegla">💾 Guardar Regla</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(mensajeConfirmacion))
{
    <div class="camp-form-confirmacion regla-confirmacion">✔ @mensajeConfirmacion</div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="camp-form-error">⚠ @mensajeError</div>
}

<!-- Nombre de la regla -->
<div class="card regla-card">
    <label class="form-label">NOMBRE DE LA REGLA</label>
    <input class="campana-select @(errores.Contains("nombre") ? "input-error" : "")"
           @bind="nombreRegla" @bind:event="oninput"
           disabled="@EsEdicion"
           maxlength="50"
           placeholder="Ej: Rescate de Socios de Alto Riesgo" />
    @if (errores.Contains("nombre"))
    {
        <span class="camp-form-error">El nombre de la regla es obligatorio.</span>
    }
</div>

<!-- 1. Definir condición -->
<div class="card regla-card">
    <div class="regla-section-header">
        <div class="regla-section-titulo">
            <span class="regla-step-num">1</span>
            <h3>Definir Condición (Trigger)</h3>
        </div>
        <span class="regla-badge-logica">LÓGICA BOOLEANA</span>
    </div>

    @for (int i = 0; i < condiciones.Count; i++)
    {
        var idx = i;
        var c = condiciones[idx];
        var atrDef = AtributoDef(c.Atributo);

        @if (idx > 0)
        {
            <div class="regla-conector-pill-wrap">
                <button type="button" class="regla-conector-pill" @onclick="() => AlternarLogica(c)">
                    @c.LogicaConSiguiente
                </button>
            </div>
        }

        <div class="regla-cond-box @(errores.Contains($"condicion-{idx}") ? "input-error" : "")">
            <span class="regla-cond-label">@(idx == 0 ? "SI EL SOCIO TIENE..." : $"{c.LogicaConSiguiente} ADEMÁS...")</span>
            <div class="regla-cond-fields">
                <select class="regla-cond-select-atributo" @bind="c.Atributo">
                    @foreach (var a in atributosDisponibles)
                    {
                        <option value="@a.Nombre">@a.Nombre</option>
                    }
                </select>

                @if (atrDef.EsNumerico)
                {
                    <span class="regla-cond-texto">es mayor a</span>
                    <input type="number" min="0" class="regla-cond-input-num" @bind="c.ValorNumero" />
                    <span class="regla-cond-texto">@atrDef.Unidad</span>
                }
                else
                {
                    <span class="regla-cond-texto">es igual a</span>
                    <select class="regla-cond-select-valor" @bind="c.ValorTexto">
                        @foreach (var op in atrDef.Opciones!)
                        {
                            <option value="@op">@op</option>
                        }
                    </select>
                }
            </div>
            <button type="button" class="auto-icon-btn" title="Eliminar condición" @onclick="() => EliminarCondicion(c)">🗑️</button>
        </div>
    }

    <button type="button" class="regla-btn-agregar-filtro" @onclick="AgregarCondicion">
        ⊕ Añadir Filtro de Comportamiento
    </button>

    <div class="regla-estimacion-box">
        📊 <strong>≈ @EstimacionClientes().ToString("N0") clientes</strong> cumplen esta configuración
    </div>
</div>

<!-- 2. Definir acción -->
<div class="card regla-card">
    <div class="regla-section-header">
        <div class="regla-section-titulo">
            <span class="regla-step-num">2</span>
            <h3>Definir Acción</h3>
        </div>
    </div>

    <label class="form-label">CAMPAÑA ASOCIADA</label>
    @if (cargando)
    {
        <p>Cargando campañas...</p>
    }
    else if (campañasDisponibles.Count == 0)
    {
        <div class="regla-sin-campanias">
            Todavía no hay campañas creadas. Necesitás al menos una campaña para poder configurar una regla.
            <a href="campanas">Ir a Campañas →</a>
        </div>
    }
    else
    {
        <select class="campana-select @(errores.Contains("campana") ? "input-error" : "")" @bind="campañaSeleccionadaId">
            <option value="">Seleccionar campaña...</option>
            @foreach (var camp in campañasDisponibles)
            {
                <option value="@camp.Id">@camp.Nombre</option>
            }
        </select>
        @if (errores.Contains("campana"))
        {
            <span class="camp-form-error">Elegí una campaña asociada.</span>
        }

        <div class="regla-accion-resumen">
            <div>
                <label class="camp-form-sublabel">CANAL DE COMUNICACIÓN</label>
                <div class="camp-form-canal-row">
                    <div class="camp-form-canal-btn regla-canal-readonly @(CampañaSeleccionada?.Canal == "Email" ? "camp-form-canal-btn-active" : "")">
                        ✉️ Email
                    </div>
                    <div class="camp-form-canal-btn regla-canal-readonly @(CampañaSeleccionada?.Canal == "WhatsApp" ? "camp-form-canal-btn-active" : "")">
                        💬 WhatsApp
                    </div>
                </div>
            </div>
            <div>
                <label class="camp-form-sublabel">RECOMPENSA / INCENTIVO</label>
                <input class="campana-select" disabled value="@(CampañaSeleccionada?.Incentivo ?? "—")" />
            </div>
        </div>

        @if (CampañaSeleccionada is not null)
        {
            <div class="regla-vista-previa">
                <strong>Vista Previa:</strong> "@CampañaSeleccionada.MensajePreview"
            </div>
        }
    }
</div>

<!-- 3. Segmentación adicional -->
<div class="card regla-card">
    <div class="regla-section-header">
        <div class="regla-section-titulo">
            <span class="regla-step-num">3</span>
            <h3>Segmentación Adicional (Opcional)</h3>
        </div>
    </div>

    <div class="regla-segmentacion-row">
        <div>
            <label class="camp-form-sublabel">TIPO DE PLAN</label>
            <select class="campana-select" @bind="planSeleccionadoId">
                <option value="">Todos los planes</option>
                @foreach (var plan in planesDisponibles)
                {
                    <option value="@plan.IdPlan">@plan.Nombre</option>
                }
            </select>
        </div>
        <div>
            <label class="camp-form-sublabel">SEDE / UBICACIÓN</label>
            <select class="campana-select" @bind="sedeSeleccionadaId">
                <option value="">Todas las sedes</option>
                @foreach (var sede in sedesDisponibles)
                {
                    <option value="@sede.IdSede">@sede.Nombre</option>
                }
            </select>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? ReglaId { get; set; }

    private bool EsEdicion => !string.IsNullOrWhiteSpace(ReglaId);
    private int? IdRegla => int.TryParse(ReglaId, out var id) ? id : null;

    private string nombreRegla = "";
    private string mensajeConfirmacion = "";
    private string mensajeError = "";
    private bool cargando = true;
    private bool guardando = false;
    private HashSet<string> errores = new();

    // --- Segmentación adicional (CU11, pasos 8-9) ---
    private List<BE.Sede> sedesDisponibles = new();
    private List<BE.PlanSocio> planesDisponibles = new();
    private int? sedeSeleccionadaId;
    private int? planSeleccionadoId;

    // --- Definición de atributos disponibles para las condiciones ---
    private record AtributoDefinicion(string Nombre, bool EsNumerico, string Unidad, List<string>? Opciones);

    private List<AtributoDefinicion> atributosDisponibles = new()
    {
        new("Nivel de Riesgo", false, "", new() { "Bajo", "Medio", "Alto", "Muy Alto" }),
        new("Inactividad", true, "días", null),
        new("Historial de Pagos", false, "", new() { "Al día", "Pendiente", "Vencido" }),
        new("Actividad", true, "%", null),
    };

    private AtributoDefinicion AtributoDef(string nombre) =>
        atributosDisponibles.FirstOrDefault(a => a.Nombre == nombre) ?? atributosDisponibles[0];

    // Condición tal como la maneja el formulario (no es BE.Condicion).
    private class Condicion
    {
        public string Atributo { get; set; } = "Nivel de Riesgo";
        public string ValorTexto { get; set; } = "Alto";
        public int? ValorNumero { get; set; } = 15;
        public string LogicaConSiguiente { get; set; } = "Y"; // conecta esta condición con la ANTERIOR (solo se muestra desde la 2ª)
    }

    private List<Condicion> condiciones = new()
    {
        new Condicion { Atributo = "Nivel de Riesgo", ValorTexto = "Alto" },
    };

    // --- Campañas existentes disponibles para asociar (CU11, paso 5) ---
    private record CampañaResumen(int Id, string Nombre, string Canal, string Incentivo, string MensajePreview);

    private List<CampañaResumen> campañasDisponibles = new();
    private int? campañaSeleccionadaId;

    private CampañaResumen? CampañaSeleccionada =>
        campañasDisponibles.FirstOrDefault(c => c.Id == campañaSeleccionadaId);

    protected override async Task OnInitializedAsync()
    {
        var campanas = await BLLCampana.ObtenerCampanas();
        var incentivos = (await BLLIncentivo.ObtenerIncentivos()).ToDictionary(i => i.IdIncentivo, i => i.Nombre);

        campañasDisponibles = campanas.Select(c => new CampañaResumen(
            c.IdCampania,
            c.Nombre,
            c.Canal,
            c.IdIncentivo is int idInc && incentivos.TryGetValue(idInc, out var nombreInc) ? nombreInc : "—",
            c.Mensaje)).ToList();

        sedesDisponibles = await BLLSede.ObtenerSedes();
        planesDisponibles = await BLLPlanSocio.ObtenerPlanes();

        if (EsEdicion)
        {
            await CargarReglaExistente();
        }

        cargando = false;
    }

    private async Task CargarReglaExistente()
    {
        var regla = IdRegla is int id ? await BLLRegla.ObtenerReglaPorId(id) : null;
        if (regla is null)
        {
            Navigation.NavigateTo("/automatizacion");
            return;
        }

        nombreRegla = regla.Nombre;
        campañaSeleccionadaId = regla.IdCampania;
        sedeSeleccionadaId = regla.IdSede;
        planSeleccionadoId = regla.IdPlan;

        // En BD, Operador es el conector con la condición SIGUIENTE (ver BLLRegla.ArmarResumen).
        // En el formulario, LogicaConSiguiente es el conector con la ANTERIOR.
        condiciones = new();
        for (int i = 0; i < regla.Condiciones.Count; i++)
        {
            var c = regla.Condiciones[i];
            var def = AtributoDef(c.Atributo);

            condiciones.Add(new Condicion
            {
                Atributo = c.Atributo,
                ValorTexto = def.EsNumerico ? def.Opciones?.FirstOrDefault() ?? "" : c.Valor,
                ValorNumero = def.EsNumerico && int.TryParse(c.Valor, out var n) ? n : null,
                LogicaConSiguiente = i > 0 ? regla.Condiciones[i - 1].Operador : "Y"
            });
        }

        if (condiciones.Count == 0) condiciones.Add(new Condicion());
    }

    private void AgregarCondicion()
    {
        condiciones.Add(new Condicion { Atributo = "Inactividad", LogicaConSiguiente = "Y" });
    }

    private void EliminarCondicion(Condicion c)
    {
        // Siempre debe quedar al menos una condición.
        if (condiciones.Count > 1)
        {
            condiciones.Remove(c);
        }
    }

    private void AlternarLogica(Condicion c)
    {
        c.LogicaConSiguiente = c.LogicaConSiguiente == "Y" ? "O" : "Y";
    }

    /// <summary>
    /// Estimación en tiempo real de clientes impactados (CU11, pasos 4, 7 y 9).
    /// Cálculo simulado: en un escenario real vendría del backend / modelo de IA.
    /// </summary>
    private int EstimacionClientes()
    {
        int baseClientes = 3421;
        double factor = 1.0;

        foreach (var c in condiciones)
        {
            factor *= AtributoDef(c.Atributo).EsNumerico ? 0.35 : 0.25;
        }

        if (CampañaSeleccionada is not null) factor *= 0.9;
        if (planSeleccionadoId is not null) factor *= 0.35;
        if (sedeSeleccionadaId is not null) factor *= 0.4;

        return Math.Max(1, (int)(baseClientes * factor));
    }

    private bool Validar()
    {
        errores.Clear();

        if (string.IsNullOrWhiteSpace(nombreRegla)) errores.Add("nombre");

        for (int i = 0; i < condiciones.Count; i++)
        {
            var c = condiciones[i];
            var def = AtributoDef(c.Atributo);
            var incompleta = def.EsNumerico ? c.ValorNumero is null or <= 0 : string.IsNullOrWhiteSpace(c.ValorTexto);
            if (incompleta) errores.Add($"condicion-{i}");
        }

        if (campañaSeleccionadaId is null) errores.Add("campana");

        return errores.Count == 0;
    }

    // Valor que se guarda para una condición. Si el usuario cambió el atributo, ValorTexto puede
    // quedar con un valor de otro atributo (ej. "Alto" en Historial de Pagos): en ese caso el <select>
    // muestra la primera opción, así que se guarda esa, que es lo que el usuario está viendo.
    private string ValorParaGuardar(Condicion c)
    {
        var def = AtributoDef(c.Atributo);
        if (def.EsNumerico) return c.ValorNumero!.Value.ToString();
        return def.Opciones!.Contains(c.ValorTexto) ? c.ValorTexto : def.Opciones[0];
    }

    // Formulario -> BE. Ver nota de CargarReglaExistente: Operador = conector con la SIGUIENTE.
    private List<BE.Condicion> ACondicionesBE()
    {
        var lista = new List<BE.Condicion>();
        for (int i = 0; i < condiciones.Count; i++)
        {
            lista.Add(new BE.Condicion
            {
                Atributo = condiciones[i].Atributo,
                Valor = ValorParaGuardar(condiciones[i]),
                Operador = i + 1 < condiciones.Count ? condiciones[i + 1].LogicaConSiguiente : "Y"
            });
        }
        return lista;
    }

    private async Task GuardarRegla()
    {
        // Evita crear la regla dos veces si se hace doble clic mientras espera la redirección.
        if (guardando) return;

        // Alterno 5.1: no hay campañas creadas en el sistema.
        if (campañasDisponibles.Count == 0)
        {
            return;
        }

        mensajeError = "";
        if (!Validar())
        {
            mensajeConfirmacion = "";
            return;
        }

        guardando = true;
        try
        {
            var condicionesBE = ACondicionesBE();

            if (EsEdicion)
            {
                await BLLRegla.ModificarRegla(IdRegla!.Value, nombreRegla.Trim(), campañaSeleccionadaId!.Value, condicionesBE, sedeSeleccionadaId, planSeleccionadoId);
                mensajeConfirmacion = "Regla actualizada exitosamente.";
            }
            else
            {
                await BLLRegla.CrearRegla(nombreRegla.Trim(), campañaSeleccionadaId!.Value, condicionesBE, sedeSeleccionadaId, planSeleccionadoId);
                mensajeConfirmacion = "Regla creada exitosamente con estado Activa.";
            }
        }
        catch (Exception ex)
        {
            guardando = false;
            mensajeConfirmacion = "";
            mensajeError = $"No se pudo guardar la regla: {ex.Message}";
            return;
        }

        StateHasChanged();
        await RedirigirConDelay();
    }

    private async Task RedirigirConDelay()
    {
        await Task.Delay(1200);
        Navigation.NavigateTo("/automatizacion");
    }

    private void Cancelar()
    {
        // Alterno 10.1: descarta los cambios y vuelve al listado de reglas (CU10).
        Navigation.NavigateTo("/automatizacion");
    }
}
